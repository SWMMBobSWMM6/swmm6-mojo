def T_dynwave_DWSolver__gatherConduitNodeFlows(this: Ref[T_dynwave_DWSolver], var ctx: Ref[T_SimulationContext]) raises:
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var CD: Ref[T_ConduitData] = ctx[].link_subtypes[].conduits
    var n: Int32 = Int32(0)
    while (n < this[].n_nodes_):
        var un: UInt64 = n.cast[DType.uint64]()
        var b0: Int32 = this[].csr_row_[].a[Int(un)]
        var b1: Int32 = this[].csr_row_[].a[Int((un + UInt64(1)))]
        if (b0 == b1):
            n = (n + Int32(1))
            continue
        var self_outfall: Bool = (this[].node_tile_[].a[Int(un)][].is_outfall.cast[DType.int32]() != Int32(0))
        var inflow: Float64 = nodes[].inflow[].a[Int(un)]
        var outflow: Float64 = nodes[].outflow[].a[Int(un)]
        var sumdqdh: Float64 = this[].xnode_[].sumdqdh[].a[Int(un)]
        var surf: Float64 = this[].xnode_[].new_surf_area[].a[Int(un)]
        var k: Int32 = b0
        while (k < b1):
            var uk: UInt64 = k.cast[DType.uint64]()
            var uj: UInt64 = this[].csr_link_[].a[Int(uk)].cast[DType.uint64]()
            var at_n2: Bool = (this[].csr_is_n2_[].a[Int(uk)].cast[DType.int32]() != Int32(0))
            var uci: UInt64 = this[].tile_uj_to_ci_[].a[Int(uj)].cast[DType.uint64]()
            var q: Float64 = this[].new_flow_[].a[Int(uj)]
            if (q >= Float64(0.0)):
                if at_n2:
                    inflow = (inflow + q)
                else:
                    outflow = (outflow + q)
            elif at_n2:
                outflow = (outflow - q)
            else:
                inflow = (inflow - q)
            sumdqdh = (sumdqdh + this[].dqdh_[].a[Int(uj)])
            var ucr_g: UInt64 = this[].tile_crow_[].a[Int(uci)].cast[DType.uint64]()
            var conduit_loss: Float64 = ((CD[].evap_loss_rate[].a[Int(ucr_g)] + CD[].seep_loss_rate[].a[Int(ucr_g)]) * this[].tile_barrels_d_[].a[Int(uci)])
            if (conduit_loss < Float64(0.0)):
                var gain: Float64 = (-conduit_loss)
                if ((not self_outfall) and (not (this[].csr_other_outfall_[].a[Int(uk)].cast[DType.int32]() != Int32(0)))):
                    gain = (gain / Float64(2.0))
                if (not self_outfall):
                    inflow = (inflow + gain)
            elif (conduit_loss > Float64(0.0)):
                if ((not self_outfall) and (not (this[].csr_other_outfall_[].a[Int(uk)].cast[DType.int32]() != Int32(0)))):
                    conduit_loss = (conduit_loss / Float64(2.0))
                if (not self_outfall):
                    outflow = (outflow + conduit_loss)
            var barrels: Int32 = Conv.D2I(this[].tile_barrels_d_[].a[Int(uci)])
            surf = (surf + ((this[].surf_area2_[].a[Int(uj)] if at_n2 else this[].surf_area1_[].a[Int(uj)]) * barrels.cast[DType.float64]()))
            k = (k + Int32(1))
        nodes[].inflow[].a[Int(un)] = inflow
        nodes[].outflow[].a[Int(un)] = outflow
        this[].xnode_[].sumdqdh[].a[Int(un)] = sumdqdh
        this[].xnode_[].new_surf_area[].a[Int(un)] = surf
