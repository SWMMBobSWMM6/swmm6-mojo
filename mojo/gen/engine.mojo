def F___storage_shape_is_geometric(var s: T_StorageShape) raises -> Bool:
    return ((((s == T_StorageShape__CYLINDRICAL) or (s == T_StorageShape__CONICAL)) or (s == T_StorageShape__PARABOLOID)) or (s == T_StorageShape__PYRAMIDAL))

def F___storage_shape_params_valid(var s: T_StorageShape, var p1: Float64, var p2: Float64, var p3: Float64) raises -> Bool:
    if (not F___storage_shape_is_geometric(s)):
        return True
    if (((p1 <= Float64(0.0)) or (p2 <= Float64(0.0))) or (p3 < Float64(0.0))):
        return False
    if ((s == T_StorageShape__PARABOLOID) and (p3 == Float64(0.0))):
        return False
    return True

def F___storage_shape_coeffs(var s: T_StorageShape, var p1: Float64, var p2: Float64, var p3: Float64, a: P[Float64], b: P[Float64], c: P[Float64]) raises -> Bool:
    if (not F___storage_shape_is_geometric(s)):
        return False
    if (not F___storage_shape_params_valid(s, p1, p2, p3)):
        return False
    var A_: Float64 = (p1 / Float64(2.0))
    var B: Float64 = (p2 / Float64(2.0))
    var Z: Float64 = p3
    var __sv1 = s
    if __sv1 == T_StorageShape__CYLINDRICAL:
        a[] = Float64(0.0)
        b[] = Float64(0.0)
        c[] = ((gs()[].G_F___kStoragePi * A_) * B)
        return True
    elif __sv1 == T_StorageShape__CONICAL:
        a[] = (((Float64(2.0) * gs()[].G_F___kStoragePi) * B) * Z)
        b[] = ((((gs()[].G_F___kStoragePi * B) / A_) * Z) * Z)
        c[] = ((gs()[].G_F___kStoragePi * A_) * B)
        return True
    elif __sv1 == T_StorageShape__PARABOLOID:
        a[] = (((gs()[].G_F___kStoragePi * A_) * B) / Z)
        b[] = Float64(0.0)
        c[] = Float64(0.0)
        return True
    elif __sv1 == T_StorageShape__PYRAMIDAL:
        a[] = ((Float64(2.0) * (p1 + p2)) * Z)
        b[] = ((Float64(4.0) * Z) * Z)
        c[] = (p1 * p2)
        return True
    else:
        return False

def F___storage_shape_from_keyword(var kw: Ref[Str], out_: P[T_StorageShape]) raises -> Bool:
    if kw[].Clone()[].Equals(Str.new_(rt_lit("TABULAR"))):
        out_[] = T_StorageShape__TABULAR
        return True
    if kw[].Clone()[].Equals(Str.new_(rt_lit("FUNCTIONAL"))):
        out_[] = T_StorageShape__FUNCTIONAL
        return True
    if kw[].Clone()[].Equals(Str.new_(rt_lit("CYLINDRICAL"))):
        out_[] = T_StorageShape__CYLINDRICAL
        return True
    if kw[].Clone()[].Equals(Str.new_(rt_lit("CONICAL"))):
        out_[] = T_StorageShape__CONICAL
        return True
    if (kw[].Clone()[].Equals(Str.new_(rt_lit("PARABOLIC"))) or kw[].Clone()[].Equals(Str.new_(rt_lit("PARABOLOID")))):
        out_[] = T_StorageShape__PARABOLOID
        return True
    if kw[].Clone()[].Equals(Str.new_(rt_lit("PYRAMIDAL"))):
        out_[] = T_StorageShape__PYRAMIDAL
        return True
    return False

