                    if (ctx[].nodes[].type_[].a[Int(source.cast[DType.uint64]())] == T_NodeType__OUTFALL):
                        c_link = (Float64(0.0) if ctx[].options[].outfall_backflow_zero else ctx[].nodes[].conc_old[].a[Int(((source * np) + p).cast[DType.uint64]())])
                c_link = F_lidnode__outletQuality(ctx, source, j, p, c_link)
            var mass: Float64 = (q * c_link)
