def T_hydstruct_StructureSolver__init(this: Ref[T_hydstruct_StructureSolver], var ctx: Ref[T_SimulationContext]) raises:
    var n_pumps: Int32 = Int32(0)
    var n_orifices: Int32 = Int32(0)
    var n_weirs: Int32 = Int32(0)
    var n_outlets: Int32 = Int32(0)
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_links(ctx)):
        var uj: UInt64 = j.cast[DType.uint64]()
        var __sv1 = ctx[].links[].type_[].a[Int(uj)]
        while True:
            if __sv1 == T_LinkType__PUMP:
                n_pumps = (n_pumps + Int32(1))
                break
            elif __sv1 == T_LinkType__ORIFICE:
                n_orifices = (n_orifices + Int32(1))
                break
            elif __sv1 == T_LinkType__WEIR:
                n_weirs = (n_weirs + Int32(1))
                break
            elif __sv1 == T_LinkType__OUTLET:
                n_outlets = (n_outlets + Int32(1))
                break
            else:
                break
            break
        j = (j + Int32(1))
    T_hydstruct_PumpGroup__resize(this[].pumps_, n_pumps)
    T_hydstruct_OrificeGroup__resize(this[].orifices_, n_orifices)
    T_hydstruct_WeirGroup__resize(this[].weirs_, n_weirs)
    T_hydstruct_OutletGroup__resize(this[].outlets_, n_outlets)
    var ip: Int32 = Int32(0)
    var io: Int32 = Int32(0)
    var iw: Int32 = Int32(0)
    var ix: Int32 = Int32(0)
    var j_2: Int32 = Int32(0)
    while (j_2 < T_SimulationContext__n_links(ctx)):
        var uj_2: UInt64 = j_2.cast[DType.uint64]()
        var __sv2 = ctx[].links[].type_[].a[Int(uj_2)]
        while True:
            if __sv2 == T_LinkType__PUMP:
                var uk: UInt64 = ip.cast[DType.uint64]()
                var P_: Ref[T_PumpData] = ctx[].link_subtypes[].pumps
                var pr: UInt64 = T_LinkSubtypes__pump_row(ctx[].link_subtypes, j_2).cast[DType.uint64]()
                this[].pumps_[].link_idx[].a[Int(uk)] = j_2
                this[].pumps_[].curve_idx[].a[Int(uk)] = P_[].curve[].a[Int(pr)]
                this[].pumps_[].speed[].a[Int(uk)] = ctx[].links[].setting[].a[Int(uj_2)]
                this[].pumps_[].y_on[].a[Int(uk)] = P_[].startup[].a[Int(pr)]
                this[].pumps_[].y_off[].a[Int(uk)] = P_[].shutoff[].a[Int(pr)]
                var ci: Int32 = P_[].curve[].a[Int(pr)]
                if ((ci >= Int32(0)) and (ci < ctx[].tables[].tables[].size().cast[DType.int32]())):
                    var tt: Int32 = ctx[].tables[].tables[].a[Int(ci.cast[DType.uint64]())][].type_
                    if ((tt >= Int32(7)) and (tt <= Int32(11))):
                        this[].pumps_[].curve_type[].a[Int(uk)] = (tt - Int32(6))
                    else:
                        this[].pumps_[].curve_type[].a[Int(uk)] = Int32(6)
                else:
                    this[].pumps_[].curve_type[].a[Int(uk)] = Int32(6)
                ctx[].link_subtypes[].pumps[].curve_type[].a[Int(pr)] = this[].pumps_[].curve_type[].a[Int(uk)]
                ip = (ip + Int32(1))
                break
            elif __sv2 == T_LinkType__ORIFICE:
                var uk_2: UInt64 = io.cast[DType.uint64]()
                this[].orifices_[].link_idx[].a[Int(uk_2)] = j_2
                var y_full: Float64 = ctx[].links[].xsect_y_full[].a[Int(uj_2)]
                var route_step: Float64 = T_SimulationOptions__linkValidateRoutingStep(ctx[].options)
                var L: Float64 = ((Float64(2.0) * route_step) * Math.Sqrt((gs()[].G_F_constants__GRAVITY * y_full)))
                this[].orifices_[].length_eff[].a[Int(uk_2)] = M.max_(Float64(200.0), L)
                io = (io + Int32(1))
                break
            elif __sv2 == T_LinkType__WEIR:
                var uk_3: UInt64 = iw.cast[DType.uint64]()
                var W: Ref[T_WeirData] = ctx[].link_subtypes[].weirs
                var wr: UInt64 = T_LinkSubtypes__weir_row(ctx[].link_subtypes, j_2).cast[DType.uint64]()
                this[].weirs_[].link_idx[].a[Int(uk_3)] = j_2
                this[].weirs_[].c_disch1[].a[Int(uk_3)] = W[].cd[].a[Int(wr)]
                this[].weirs_[].c_disch2[].a[Int(uk_3)] = W[].cd2[].a[Int(wr)]
                this[].weirs_[].can_surcharge[].a[Int(uk_3)] = W[].can_surcharge[].a[Int(wr)]
                this[].weirs_[].weir_type[].a[Int(uk_3)] = Conv.D2I(W[].weir_type[].a[Int(wr)])
                this[].weirs_[].end_con[].a[Int(uk_3)] = W[].end_contractions[].a[Int(wr)]
                this[].weirs_[].cd_curve[].a[Int(uk_3)] = W[].cd_curve[].a[Int(wr)]
                this[].weirs_[].road_width[].a[Int(uk_3)] = W[].road_width[].a[Int(wr)]
                this[].weirs_[].road_surface[].a[Int(uk_3)] = W[].road_surface[].a[Int(wr)].cast[DType.int32]()
                this[].weirs_[].slope[].a[Int(uk_3)] = ctx[].links[].xsect_s_bot[].a[Int(uj_2)]
                var y_full_2: Float64 = ctx[].links[].xsect_y_full[].a[Int(uj_2)]
                var route_step_2: Float64 = T_SimulationOptions__linkValidateRoutingStep(ctx[].options)
                var L_2: Float64 = ((Float64(2.0) * route_step_2) * Math.Sqrt((gs()[].G_F_constants__GRAVITY * y_full_2)))
                this[].weirs_[].length_eff[].a[Int(uk_3)] = M.max_(Float64(200.0), L_2)
                iw = (iw + Int32(1))
                break
            elif __sv2 == T_LinkType__OUTLET:
                var uk_4: UInt64 = ix.cast[DType.uint64]()
                var O: Ref[T_OutletData] = ctx[].link_subtypes[].outlets
                var xr: UInt64 = T_LinkSubtypes__outlet_row(ctx[].link_subtypes, j_2).cast[DType.uint64]()
                this[].outlets_[].link_idx[].a[Int(uk_4)] = j_2
                this[].outlets_[].q_coeff[].a[Int(uk_4)] = O[].coeff[].a[Int(xr)]
                this[].outlets_[].q_expon[].a[Int(uk_4)] = O[].expon[].a[Int(xr)]
                this[].outlets_[].curve_idx[].a[Int(uk_4)] = O[].curve[].a[Int(xr)]
                ix = (ix + Int32(1))
                break
            else:
                break
            break
        j_2 = (j_2 + Int32(1))
    this[].nc_indices_[].clear()
    this[].nc_indices_[].reserve((((n_pumps + n_orifices) + n_weirs) + n_outlets).cast[DType.uint64]())
    var j_3: Int32 = Int32(0)
    while (j_3 < T_SimulationContext__n_links(ctx)):
        var uj_3: UInt64 = j_3.cast[DType.uint64]()
        if ((ctx[].links[].type_[].a[Int(uj_3)] != T_LinkType__CONDUIT) or (ctx[].links[].xsect_shape[].a[Int(uj_3)] == T_XsectShape__DUMMY)):
            this[].nc_indices_[].push_back(j_3)
        j_3 = (j_3 + Int32(1))
    this[].nc_group_k_[].assign(T_SimulationContext__n_links(ctx).cast[DType.uint64](), Int32(-1))
    var k: Int32 = Int32(0)
    while (k < this[].pumps_[].count):
        this[].nc_group_k_[].a[Int(this[].pumps_[].link_idx[].a[Int(k.cast[DType.uint64]())].cast[DType.uint64]())] = k
        k = (k + Int32(1))
    var k_2: Int32 = Int32(0)
    while (k_2 < this[].orifices_[].count):
        this[].nc_group_k_[].a[Int(this[].orifices_[].link_idx[].a[Int(k_2.cast[DType.uint64]())].cast[DType.uint64]())] = k_2
        k_2 = (k_2 + Int32(1))
    var k_3: Int32 = Int32(0)
    while (k_3 < this[].weirs_[].count):
        this[].nc_group_k_[].a[Int(this[].weirs_[].link_idx[].a[Int(k_3.cast[DType.uint64]())].cast[DType.uint64]())] = k_3
        k_3 = (k_3 + Int32(1))
    var k_4: Int32 = Int32(0)
    while (k_4 < this[].outlets_[].count):
        this[].nc_group_k_[].a[Int(this[].outlets_[].link_idx[].a[Int(k_4.cast[DType.uint64]())].cast[DType.uint64]())] = k_4
        k_4 = (k_4 + Int32(1))

def T_hydstruct_StructureSolver__updatePumpTargetSettings(this: Ref[T_hydstruct_StructureSolver], var ctx: Ref[T_SimulationContext]) raises:
    var links: Ref[T_LinkData] = ctx[].links
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var k: Int32 = Int32(0)
    while (k < this[].pumps_[].count):
        var uk: UInt64 = k.cast[DType.uint64]()
        var j: Int32 = this[].pumps_[].link_idx[].a[Int(uk)]
        var uj: UInt64 = j.cast[DType.uint64]()
        var n1: Int32 = links[].node1[].a[Int(uj)]
        if (n1 < Int32(0)):
            k = (k + Int32(1))
            continue
        var un1: UInt64 = n1.cast[DType.uint64]()
        links[].target_setting[].a[Int(uj)] = links[].setting[].a[Int(uj)]
        var depth: Float64 = nodes[].depth[].a[Int(un1)]
        var y_off: Float64 = this[].pumps_[].y_off[].a[Int(uk)]
        var y_on: Float64 = this[].pumps_[].y_on[].a[Int(uk)]
        if (((y_off > Float64(0.0)) and (links[].setting[].a[Int(uj)] > Float64(0.0))) and (depth < y_off)):
            links[].target_setting[].a[Int(uj)] = Float64(0.0)
        if (((y_on > Float64(0.0)) and (links[].setting[].a[Int(uj)] == Float64(0.0))) and (depth > y_on)):
            links[].target_setting[].a[Int(uj)] = Float64(1.0)
        k = (k + Int32(1))

def T_hydstruct_StructureSolver__computeNonConduitFlowOne(this: Ref[T_hydstruct_StructureSolver], var ctx: Ref[T_SimulationContext], var dt: Float64, var node_new_surf_area: Ptr[Float64], var link_idx: Int32) raises:
    var uj: UInt64 = link_idx.cast[DType.uint64]()
    if (ctx[].links[].type_[].a[Int(uj)] == T_LinkType__CONDUIT):
        ctx[].links[].dqdh[].a[Int(uj)] = Float64(0.0)
        var q: Float64 = Float64(0.0)
        if (ctx[].links[].setting[].a[Int(uj)] != Float64(0.0)):
            var n1: Int32 = ctx[].links[].node1[].a[Int(uj)]
            if (n1 >= Int32(0)):
                var un1: UInt64 = n1.cast[DType.uint64]()
                if (ctx[].nodes[].type_[].a[Int(un1)] == T_NodeType__DIVIDER):
                    q = F_divider__getOutflow(ctx, n1, link_idx)
                else:
                    q = (ctx[].nodes[].inflow[].a[Int(un1)] + ctx[].nodes[].overflow[].a[Int(un1)])
            var qlim: Float64 = ctx[].links[].q_limit[].a[Int(uj)]
            if ((qlim > Float64(0.0)) and (q > qlim)):
                q = qlim
        ctx[].links[].flow[].a[Int(uj)] = q
        return
    var k: Int32 = (this[].nc_group_k_[].a[Int(uj)] if (uj < this[].nc_group_k_[].size()) else Int32(-1))
    if (k < Int32(0)):
        return
    ctx[].links[].dqdh[].a[Int(uj)] = Float64(0.0)
    var __sv1 = ctx[].links[].type_[].a[Int(uj)]
    while True:
        if __sv1 == T_LinkType__PUMP:
            T_hydstruct_StructureSolver__computePumpFlowK(this, ctx, dt, node_new_surf_area, k)
            break
        elif __sv1 == T_LinkType__ORIFICE:
            T_hydstruct_StructureSolver__computeOrificeFlowK(this, ctx, node_new_surf_area, k)
            break
        elif __sv1 == T_LinkType__WEIR:
            T_hydstruct_StructureSolver__computeWeirFlowK(this, ctx, node_new_surf_area, k)
            break
        elif __sv1 == T_LinkType__OUTLET:
            T_hydstruct_StructureSolver__computeOutletFlowK(this, ctx, k)
            break
        else:
            break
        break

def T_hydstruct_StructureSolver__scatterHeldSurfArea(this: Ref[T_hydstruct_StructureSolver], var ctx: Ref[T_SimulationContext], var node_new_surf_area: Ptr[Float64], var link_idx: Int32) raises:
    var uj: UInt64 = link_idx.cast[DType.uint64]()
    if (ctx[].links[].type_[].a[Int(uj)] != T_LinkType__ORIFICE):
        return
    var k: Int32 = (this[].nc_group_k_[].a[Int(uj)] if (uj < this[].nc_group_k_[].size()) else Int32(-1))
    if (k < Int32(0)):
        return
    var n1: Int32 = ctx[].links[].node1[].a[Int(uj)]
    var n2: Int32 = ctx[].links[].node2[].a[Int(uj)]
    if ((n1 < Int32(0)) or (n2 < Int32(0))):
        return
    T_hydstruct_StructureSolver__scatterOrificeSurfArea(this, ctx, node_new_surf_area, k.cast[DType.uint64](), uj, n1.cast[DType.uint64](), n2.cast[DType.uint64]())

def T_hydstruct_StructureSolver__computePumpFlowK(this: Ref[T_hydstruct_StructureSolver], var ctx: Ref[T_SimulationContext], var dt: Float64, var node_new_surf_area: Ptr[Float64], var k: Int32) raises:
    var links: Ref[T_LinkData] = ctx[].links
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var fu: Int32 = ctx[].options[].flow_units
    var ucf_flow: Float64 = Ptr[Float64](gs()[].G_F_ucf__Qcf_UnitConversion, Int(Int64(0)))[Int(fu)]
    var unit_sys: Int32 = F_ucf__getUnitSystem(fu)
    var ucf_len: Float64 = Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(3))], Int(Int64(0)))[Int(unit_sys)]
    var ucf_vol: Float64 = Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(5))], Int(Int64(0)))[Int(unit_sys)]
    var uk: UInt64 = k.cast[DType.uint64]()
    var j: Int32 = this[].pumps_[].link_idx[].a[Int(uk)]
