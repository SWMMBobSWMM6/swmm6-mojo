def F_link__applyTabulatedXSectParams(var xs: Ref[T_XSectParams], var td: Ref[T_transect_TransectData], var y_full: Float64, var transect_idx: Int32) raises:
    var __sv1 = xs[].type_
    while True:
        if __sv1 == T_XSectShape__CUSTOM:
            xs[].y_full = y_full
            xs[].a_full = td[].a_full
            xs[].r_full = td[].r_full
            xs[].w_max = td[].w_max
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            xs[].s_max = (((td[].s_max * y_full) * y_full) * Math.Pow(y_full, Float64(0.6666666666666666)))
            xs[].a_bot = ((td[].a_max * y_full) * y_full)
            xs[].yw_max = F_link__anon_hydraulics_Link_cpp__widestPointHeight_Link(td, xs[].y_full)
            break
        elif __sv1 == T_XSectShape__IRREGULAR:
            xs[].y_full = td[].y_full
            xs[].a_full = td[].a_full
            xs[].r_full = td[].r_full
            xs[].w_max = td[].w_max
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            xs[].s_max = td[].s_max
            xs[].a_bot = td[].a_max
            xs[].yw_max = F_link__anon_hydraulics_Link_cpp__widestPointHeight_Link(td, xs[].y_full)
            break
        else:
            xs[].y_full = td[].y_full
            xs[].a_full = td[].a_full
            xs[].r_full = td[].r_full
            xs[].w_max = td[].w_max
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            xs[].s_max = xs[].s_full
            xs[].yw_max = xs[].y_full
            break
        break
    xs[].transect = transect_idx
    xs[].area_tbl = Ptr[Float64](td[].area_tbl, Int(Int64(0)))
    xs[].hrad_tbl = Ptr[Float64](td[].hrad_tbl, Int(Int64(0)))
    xs[].width_tbl = Ptr[Float64](td[].width_tbl, Int(Int64(0)))
    xs[].area_lut = td[].area_lut
    xs[].transect_tbl_size = gs()[].G_F_transect__N_TRANSECT_TBL

def F_link__anon_hydraulics_Link_cpp__widestPointHeight_Link(var td: Ref[T_transect_TransectData], var y_full: Float64) raises -> Float64:
    var i_max: Int32 = Int32(0)
    var wt_max: Float64 = Ptr[Float64](td[].width_tbl, Int(Int64(0)))[Int(Int32(0))]
    var i: Int32 = Int32(1)
    while (i < gs()[].G_F_transect__N_TRANSECT_TBL):
        if (Ptr[Float64](td[].width_tbl, Int(Int64(0)))[Int(i)] < wt_max):
            break
        wt_max = Ptr[Float64](td[].width_tbl, Int(Int64(0)))[Int(i)]
        i_max = i
        i = (i + Int32(1))
    return ((y_full * i_max.cast[DType.float64]()) / (gs()[].G_F_transect__N_TRANSECT_TBL - Int32(1)).cast[DType.float64]())

def F_node__getVolume(var nodes: Ref[T_NodeData], var idx: Int32, var depth: Float64, var tables: Ref[T_TableData], var unit_sys: Int32, var subs: Ref[T_NodeSubtypes]) raises -> Float64:
    if (depth <= Float64(0.0)):
        return Float64(0.0)
    var ui: UInt64 = idx.cast[DType.uint64]()
    if (nodes[].storage_area[].a[Int(ui)] > Float64(0.0)):
        return (nodes[].storage_area[].a[Int(ui)] * M.clamp(depth, Float64(0.0), nodes[].full_depth[].a[Int(ui)]))
    if (nodes[].type_[].a[Int(ui)] == T_NodeType__STORAGE):
        var lr: Int32 = (T_NodeSubtypes__storage_row(subs, idx) if (rt_box(subs) != Obj()) else Int32(-1))
        if ((lr >= Int32(0)) and (not subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())][].cells[].empty())):
            var state: Ref[T_LidNodeState] = subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())]
            if state[].richards:
                var surface: Ref[T_LidNodeCell] = state[].cells[].front()[]
                return ((M.clamp((depth - surface[].bottom), Float64(0.0), (surface[].top - surface[].bottom)) * surface[].area) * surface[].porosity)
            var volume: Float64 = Float64(0.0)
            var v__r1: Ref[Vec[Ref[T_LidNodeCell]]] = subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())][].cells
            var v__i2: Int64 = Int64(0)
            var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
            while (v__i2 < v__i2_n):
                var cell: Ref[T_LidNodeCell] = v__r1[].a[Int(v__i2)]
                var fraction: Float64 = M.clamp(((depth - cell[].bottom) / (cell[].top - cell[].bottom)), Float64(0.0), Float64(1.0))
                volume = (volume + ((fraction * cell[].geometric_volume) * M.max_(Float64(0.0), (cell[].porosity - cell[].theta))))
                v__i2 = (v__i2 + Int64(1))
            return volume
        if ((depth >= nodes[].full_depth[].a[Int(ui)]) and (nodes[].full_volume[].a[Int(ui)] > Float64(0.0))):
            return nodes[].full_volume[].a[Int(ui)]
        var g: Ref[T_node__anon_hydraulics_Node_cpp_StorageGeom] = F_node__anon_hydraulics_Node_cpp__storageGeom_Node(nodes, subs, ui)
        if (g[].curve >= Int32(0)):
            var ci: UInt64 = g[].curve.cast[DType.uint64]()
            if ((rt_box(tables) != Obj()) and (ci < tables[].tables[].size())):
                var ucf_len: Float64 = Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(3))], Int(Int64(0)))[Int(unit_sys)]
                var ucf_vol: Float64 = Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(5))], Int(Int64(0)))[Int(unit_sys)]
                var vol_disp: Float64 = F___table_getStorageVolume(tables[].tables[].a[Int(ci)], (depth * ucf_len))
                return (vol_disp / ucf_vol)
            return Float64(0.0)
        if F_node__anon_hydraulics_Node_cpp__isGeometric_Node(g):
            var d: Float64 = (depth * Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(3))], Int(Int64(0)))[Int(unit_sys)])
            var v: Float64 = (d * (g[].c + (d * ((g[].a / Float64(2.0)) + ((d * g[].b) / Float64(3.0))))))
            return (v / Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(5))], Int(Int64(0)))[Int(unit_sys)])
        var d_2: Float64 = (depth * Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(3))], Int(Int64(0)))[Int(unit_sys)])
        var n: Float64 = (g[].b + Float64(1.0))
        var v_2: Float64 = ((g[].c * d_2) + ((g[].a / n) * Math.Pow(d_2, n)))
        return (v_2 / Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(5))], Int(Int64(0)))[Int(unit_sys)])
    var fd: Float64 = nodes[].full_depth[].a[Int(ui)]
    if (fd <= Float64(0.0)):
        return Float64(0.0)
    var full_vol: Float64 = (nodes[].full_volume[].a[Int(ui)] if (nodes[].full_volume[].a[Int(ui)] > Float64(0.0)) else (gs()[].G_F_constants__MIN_SURFAREA * fd))
    return (full_vol * (depth / fd))

def F_node__getSurfArea(var nodes: Ref[T_NodeData], var idx: Int32, var depth: Float64, var tables: Ref[T_TableData], var unit_sys: Int32, var subs: Ref[T_NodeSubtypes]) raises -> Float64:
    var ui: UInt64 = idx.cast[DType.uint64]()
    if (nodes[].storage_area[].a[Int(ui)] > Float64(0.0)):
        return (Float64(0.0) if (depth > nodes[].full_depth[].a[Int(ui)]) else nodes[].storage_area[].a[Int(ui)])
    if (nodes[].type_[].a[Int(ui)] == T_NodeType__STORAGE):
        var lr: Int32 = (T_NodeSubtypes__storage_row(subs, idx) if (rt_box(subs) != Obj()) else Int32(-1))
        if ((lr >= Int32(0)) and (not subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())][].cells[].empty())):
            var cells: Ref[Vec[Ref[T_LidNodeCell]]] = subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())][].cells
            if subs[].storages[].lid_state[].a[Int(lr.cast[DType.uint64]())][].richards:
                return (cells[].front()[][].area * cells[].front()[][].porosity)
