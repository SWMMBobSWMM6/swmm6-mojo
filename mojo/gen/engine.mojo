        this[].stat_total_load[].assign(total, Float64(0.0))

def T_LinkData__resize_quality(this: Ref[T_LinkData], var n_pollutants: Int32) raises:
    this[].conc_n_pollutants = n_pollutants
    if (n_pollutants > Int32(0)):
        var total: UInt64 = (T_LinkData__count(this).cast[DType.uint64]() * n_pollutants.cast[DType.uint64]())
        this[].conc[].assign(total, Float64(0.0))
        this[].conc_old[].assign(total, Float64(0.0))

