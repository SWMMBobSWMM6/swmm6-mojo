def T_iface_InterfaceManager__getFlow(this: Ref[T_iface_InterfaceManager], var index: Int32, var frac: Float64) raises -> Float64:
    if ((index < Int32(0)) or (index >= this[].data_[].count)):
        return Float64(0.0)
    var base: UInt64 = (index.cast[DType.uint64]() * this[].n_values_per_node_.cast[DType.uint64]())
    var q1: Float64 = this[].data_[].old_values[].a[Int(base)]
    var q2: Float64 = this[].data_[].new_values[].a[Int(base)]
    return (((Float64(1.0) - frac) * q1) + (frac * q2))

def T_iface_InterfaceManager__getQuality(this: Ref[T_iface_InterfaceManager], var index: Int32, var pollut_idx: Int32, var frac: Float64) raises -> Float64:
    if ((index < Int32(0)) or (index >= this[].data_[].count)):
        return Float64(0.0)
    if ((pollut_idx < Int32(0)) or (pollut_idx >= this[].pollut_map_[].size().cast[DType.int32]())):
        return Float64(0.0)
    var col: Int32 = this[].pollut_map_[].a[Int(pollut_idx.cast[DType.uint64]())]
    if (col < Int32(0)):
        return Float64(0.0)
    var base: UInt64 = (index.cast[DType.uint64]() * this[].n_values_per_node_.cast[DType.uint64]())
    var offset: UInt64 = (base + (col + Int32(1)).cast[DType.uint64]())
    var c1: Float64 = this[].data_[].old_values[].a[Int(offset)]
    var c2: Float64 = this[].data_[].new_values[].a[Int(offset)]
    return (((Float64(1.0) - frac) * c1) + (frac * c2))

def T_iface_InterfaceManager__readNextPeriod(this: Ref[T_iface_InterfaceManager]) raises -> Bool:
    if (not (rt_box(this[].infile_) != Obj())):
        return False
    var line: CPtr = R.Buf(Int32(1025))
    this[].new_time_ = gs()[].G_F_iface__NO_DATE_InterfaceFile
    var i: Int32 = Int32(0)
    while (i < this[].data_[].count):
        var ui: UInt64 = i.cast[DType.uint64]()
        if (R.feof(this[].infile_) != Int32(0)):
            return False
        if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
            return False
        var strtok_ctx: CPtr = CPtr()
        var tok: CPtr = R.strtok(line, rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        var yr: Int32 = Int32(0)
        var mon: Int32 = Int32(0)
        var day: Int32 = Int32(0)
        var hr: Int32 = Int32(0)
        var mn: Int32 = Int32(0)
        var sec: Int32 = Int32(0)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        yr = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        mon = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        day = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        hr = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        mn = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        sec = R.atoi(tok)
        tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
        if (not (not tok.isnull())):
            return False
        var base: UInt64 = (ui * this[].n_values_per_node_.cast[DType.uint64]())
        this[].data_[].new_values[].a[Int(base)] = R.atof(tok)
        if ((this[].iface_flow_units_ >= Int32(0)) and (this[].iface_flow_units_ <= Int32(5))):
            var __cp1 = rt_addr(this[].data_[].new_values[].a[Int(base)])
            __cp1[] = (__cp1[] / Ptr[Float64](gs()[].G_F_ucf__Qcf_UnitConversion, Int(Int64(0)))[Int(this[].iface_flow_units_)])
        var j: Int32 = Int32(1)
        while (j <= this[].n_iface_polluts_):
            tok = R.strtok(CPtr(), rt_lit(" \t\n\r"))
            if (not (not tok.isnull())):
                return False
            this[].data_[].new_values[].a[Int((base + j.cast[DType.uint64]()))] = R.atof(tok)
            j = (j + Int32(1))
        this[].new_time_ = (F_datetime__encodeDate(yr, mon, day) + F_datetime__encodeTime(hr, mn, sec))
        i = (i + Int32(1))
    return True

def T_iface_InterfaceManager__setOldValues(this: Ref[T_iface_InterfaceManager]) raises:
    this[].old_time_ = this[].new_time_
    var total: UInt64 = (this[].data_[].count.cast[DType.uint64]() * this[].n_values_per_node_.cast[DType.uint64]())
    var i: UInt64 = UInt64(0)
    while (i < total):
        this[].data_[].old_values[].a[Int(i)] = this[].data_[].new_values[].a[Int(i)]
        i = (i + UInt64(1))

def T_iface_InterfaceManager__isOutletNode(var ctx: Ref[T_SimulationContext], var node_idx: Int32) raises -> Bool:
    var ui: UInt64 = node_idx.cast[DType.uint64]()
    if ((ctx[].options[].routing_model == T_RoutingModel__DYNWAVE) or (ctx[].options[].routing_model == T_RoutingModel__FV)):
        return (ctx[].nodes[].type_[].a[Int(ui)] == T_NodeType__OUTFALL)
    return (ctx[].nodes[].degree[].a[Int(ui)] == Int32(0))

