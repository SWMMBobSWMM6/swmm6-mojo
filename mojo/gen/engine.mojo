    var Rs: Float64 = Float64(0.0)
    var channel: Bool = ((rt_box(g[].xs) != Obj()) and ((g[].xs[].type_ == Int32(5)) or (g[].xs[].type_ == Int32(4))))
    if channel:
        A_ = F_xsect__getAofS(g[].xs, (Q / g[].beta))
