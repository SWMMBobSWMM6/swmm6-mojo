def F_kinwave__finishRouting(var ctx: Ref[T_SimulationContext], var structures: Ref[T_hydstruct_StructureSolver], var order: Ref[Vec[Int32]], var storage_updated: Ref[Vec[Int8]], var link_y1: Ref[Vec[Float64]], var link_y2: Ref[Vec[Float64]], var dt: Float64) raises:
    var nodes = rt_cell[Ref[T_NodeData]](ctx[].nodes)
    var links: Ref[T_LinkData] = ctx[].links
    var n_nodes = rt_cell[Int32](T_SimulationContext__n_nodes(ctx))
    var n_links: Int32 = T_SimulationContext__n_links(ctx)
    var us: Int32 = F_ucf__getUnitSystem(ctx[].options[].flow_units)
    var legacy_fv: Ref[Vec[Float64]] = Vec[Float64].new_(n_nodes[].cast[DType.uint64](), Float64(0.0))
    var ucf_vol: Float64 = Ptr[Float64](Ptr[Ary[Float64]](gs()[].G_F_ucf__Ucf_UnitConversion, Int(Int64(0)))[Int(Int64(5))], Int(Int64(0)))[Int(us)]
    var j: Int32 = Int32(0)
    while (j < n_links):
        var uj: UInt64 = j.cast[DType.uint64]()
        if (links[].type_[].a[Int(uj)] != T_LinkType__PUMP):
            j = (j + Int32(1))
            continue
        var pr: Int32 = T_LinkSubtypes__pump_row(ctx[].link_subtypes, j)
        var ci: Int32 = (ctx[].link_subtypes[].pumps[].curve[].a[Int(pr.cast[DType.uint64]())] if (pr >= Int32(0)) else Int32(-1))
        if ((ci < Int32(0)) or (ci >= ctx[].tables[].tables[].size().cast[DType.int32]())):
            j = (j + Int32(1))
            continue
        var tbl: Ref[T_Table] = ctx[].tables[].tables[].a[Int(ci.cast[DType.uint64]())]
