def F_transport__ensureMsxState(var ctx: Ref[T_SimulationContext]) raises:
    var rx: Ref[T_ReactionData] = ctx[].reactions
    var ns: UInt64 = T_ReactionData__n_species(rx).cast[DType.uint64]()
    var want_nodes: UInt64 = (T_SimulationContext__n_nodes(ctx).cast[DType.uint64]() * ns)
    var want_links: UInt64 = (T_SimulationContext__n_links(ctx).cast[DType.uint64]() * ns)
    if (rx[].msx_node_conc[].size() != want_nodes):
        rx[].msx_node_conc[].assign(want_nodes, Float64(0.0))
        rx[].msx_link_conc[].assign(want_links, Float64(0.0))
        var e: UInt64 = UInt64(0)
        while (e < T_SimulationContext__n_nodes(ctx).cast[DType.uint64]()):
            var s: UInt64 = UInt64(0)
            while (s < ns):
                rx[].msx_node_conc[].a[Int(((e * ns) + s))] = rx[].init_global[].a[Int(s)]
                s = (s + UInt64(1))
            e = (e + UInt64(1))
        var e_2: UInt64 = UInt64(0)
        while (e_2 < T_SimulationContext__n_links(ctx).cast[DType.uint64]()):
            var s_2: UInt64 = UInt64(0)
            while (s_2 < ns):
                rx[].msx_link_conc[].a[Int(((e_2 * ns) + s_2))] = rx[].init_global[].a[Int(s_2)]
                s_2 = (s_2 + UInt64(1))
            e_2 = (e_2 + UInt64(1))
        var k: UInt64 = UInt64(0)
        while (k < rx[].init_elem_idx[].size()):
            var e_3: UInt64 = rx[].init_elem_idx[].a[Int(k)].cast[DType.uint64]()
            var s_3: UInt64 = rx[].init_elem_species[].a[Int(k)].cast[DType.uint64]()
            if (s_3 >= ns):
                k = (k + UInt64(1))
                continue
            var arr: Ref[Vec[Float64]] = (rx[].msx_link_conc if (rx[].init_elem_is_link[].a[Int(k)].cast[DType.int32]() != Int32(0)) else rx[].msx_node_conc)
            if (((e_3 * ns) + s_3) < arr[].size()):
                arr[].a[Int(((e_3 * ns) + s_3))] = rx[].init_elem_value[].a[Int(k)]
            k = (k + UInt64(1))

