def F___plugin_role_to_string(var role: T_PluginRole) raises -> CPtr:
    var __sv1 = role
    if __sv1 == T_PluginRole__INPUT_READ:
        return rt_lit("INPUT_READ")
    elif __sv1 == T_PluginRole__OUTPUT_WRITE:
        return rt_lit("OUTPUT_WRITE")
    elif __sv1 == T_PluginRole__REPORT_WRITE:
        return rt_lit("REPORT_WRITE")
    elif __sv1 == T_PluginRole__STATE_READ:
        return rt_lit("STATE_READ")
    elif __sv1 == T_PluginRole__STATE_WRITE:
        return rt_lit("STATE_WRITE")
    else:
        return rt_lit("UNKNOWN")

