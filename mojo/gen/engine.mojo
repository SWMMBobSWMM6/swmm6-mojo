        qCaptured = (qCaptured + qc)
        qBypassed = (qBypassed - qc)
        if (qBypassed < gs()[].G_F_inlet__MIN_RUNOFF_FLOW):
            break
        i = (i + Int32(1))
    return (qCaptured * g[].nsides.cast[DType.float64]())

def F_inlet__findOnSagGrateFlows(var d: Ref[T_inlet_Design], var g: Ref[T_inlet_Geom], var depth: Float64, var Qw: Ptr[Float64], var Qo: Ptr[Float64]) raises:
    var Lg: Float64 = d[].grate_length
    var Wg: Float64 = d[].grate_width
    var P_: Float64 = Float64(0.0)
    var di: Float64 = Float64(0.0)
