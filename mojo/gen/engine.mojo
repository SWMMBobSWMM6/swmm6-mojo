def T_XSectGroups__maskedGroup(this: Ref[T_XSectGroups], var gi: UInt64) raises -> Ref[T_ShapeGroup]:
    var gp: Ref[T_ShapeGroup] = this[].groups_[].a[Int(gi)]
    if this[].mask_active_:
        var na: Int32 = this[].packed_count_[].a[Int(gi)]
        if (na == Int32(0)):
            return Ref[T_ShapeGroup]()
        if (na != gs()[].G_T_XSectGroups__kMaskFullGroup):
            gp = this[].packed_groups_[].a[Int(gi)]
    return gp

