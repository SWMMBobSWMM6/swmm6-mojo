    else:
        return F_xsect__getWofY(xs, h)

struct __Ctx311(Movable):
    var c0_hc: P[Float64]
    var c1_m: P[Float64]

def __mk311(c0_hc: P[Float64], c1_m: P[Float64]) -> VP:
    var c = gc_new[__Ctx311]()
    c[].c0_hc = c0_hc
    c[].c1_m = c1_m
    return c.unsafe_bitcast[NoneType]()

def __lam311(__ctx: VP, var y: Float64) raises -> Float64:
    var __c = __ctx.unsafe_bitcast[__Ctx311]()
    var dxdy: Float64 = (((__c[].c0_hc[] * __c[].c1_m[]) * Math.Pow(y, (__c[].c1_m[] - Float64(1.0)))) if (y > Float64(0.0)) else Float64(0.0))
    return Math.Sqrt((Float64(1.0) + (dxdy * dxdy)))

def F_fv_secgeom__perimeterOfDepth(var xs: Ref[T_XSectParams], var h: Float64) raises -> Float64:
    if (h <= Float64(0.0)):
        return Float64(0.0)
    if (h > xs[].y_full):
        h = xs[].y_full
    var __sv1 = xs[].type_
    if __sv1 == T_XSectShape__CIRCULAR or __sv1 == T_XSectShape__FORCE_MAIN:
        return F_fv_secgeom_detail__circPerim((Float64(0.5) * xs[].y_full), h)
    elif __sv1 == T_XSectShape__FILLED_CIRCULAR:
        var r: Float64 = (Float64(0.5) * (xs[].y_full + xs[].y_bot))
        return ((F_fv_secgeom_detail__circPerim(r, (xs[].y_bot + h)) - F_fv_secgeom_detail__circPerim(r, xs[].y_bot)) + F_fv_secgeom_detail__circWidth(r, xs[].y_bot))
    elif __sv1 == T_XSectShape__RECT_CLOSED:
        var p: Float64 = (xs[].w_max + (Float64(2.0) * h))
        var alf: Float64 = (((h * xs[].w_max) / xs[].a_full) if (xs[].a_full > Float64(0.0)) else Float64(0.0))
        if (alf > gs()[].G_F_fv_secgeom__kRectAlfMax):
            p = (p + (((alf - gs()[].G_F_fv_secgeom__kRectAlfMax) / (Float64(1.0) - gs()[].G_F_fv_secgeom__kRectAlfMax)) * xs[].w_max))
        return p
    elif __sv1 == T_XSectShape__RECT_OPEN:
        return (xs[].w_max + ((Float64(2.0) - xs[].s_bot) * h))
    elif __sv1 == T_XSectShape__TRAPEZOIDAL:
        return (xs[].y_bot + (h * xs[].r_bot))
    elif __sv1 == T_XSectShape__TRIANGULAR:
        return ((Float64(2.0) * h) * xs[].r_bot)
    elif __sv1 == T_XSectShape__PARABOLIC:
        var x: Float64 = ((Float64(2.0) * Math.Sqrt(h)) / xs[].r_bot)
        var t: Float64 = Math.Sqrt((Float64(1.0) + (x * x)))
        return (((Float64(0.5) * xs[].r_bot) * xs[].r_bot) * ((x * t) + Math.Log((x + t))))
    elif __sv1 == T_XSectShape__POWERFUNC:
        var hc = rt_cell[Float64]((((xs[].s_bot + Float64(1.0)) * xs[].r_bot) / Float64(2.0)))
        var m = rt_cell[Float64](xs[].s_bot)
        var ds: Dlg = Dlg(__mk311(hc, m), 312)
        var y0: Float64 = (Float64(1e-09) * h)
        return (Float64(2.0) * (F_fv_secgeom_detail__integrate(rt_box(ds), y0, h, (Float64(1e-12) * h), Int32(40)) + LibM.hypot(y0, (hc[] * Math.Pow(y0, m[])))))
    else:
        var r_2: Float64 = F_xsect__getRofY(xs, h)
        return ((F_xsect__getAofY(xs, h) / r_2) if (r_2 > Float64(0.0)) else Float64(0.0))

def F_fv_secgeom__hydRadOfDepth(var xs: Ref[T_XSectParams], var h: Float64) raises -> Float64:
    if (h <= Float64(0.0)):
        return Float64(0.0)
    if (not F_fv_secgeom__hasClosedForm(xs[].type_)):
        return F_xsect__getRofY(xs, M.min_(h, xs[].y_full))
    var p: Float64 = F_fv_secgeom__perimeterOfDepth(xs, h)
    return ((F_fv_secgeom__areaOfDepth(xs, h) / p) if (p > Float64(0.0)) else Float64(0.0))

def F_fv_secgeom_detail__circTheta(var r: Float64, var y: Float64) raises -> Float64:
    var c: Float64 = (Float64(1.0) - (y / r))
    if (c > Float64(1.0)):
        c = Float64(1.0)
    if (c < Float64(-1.0)):
        c = Float64(-1.0)
    return (Float64(2.0) * Math.Acos(c))

def F_fv_secgeom_detail__circArea(var r: Float64, var y: Float64) raises -> Float64:
    if (y <= Float64(0.0)):
        return Float64(0.0)
    if (y >= (Float64(2.0) * r)):
        return ((gs()[].G_F_fv_secgeom__kPi * r) * r)
