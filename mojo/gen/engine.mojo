def T_HeatConfigData__source_temp(this: Ref[T_HeatConfigData], var s: T_HeatSource, var node: Int32) raises -> Float64:
    var i: UInt64 = UInt64(0)
    while (i < this[].node_over_source[].size()):
        if ((this[].node_over_source[].a[Int(i)] == s) and (this[].node_over_node[].a[Int(i)] == node)):
            return this[].node_over_temp[].a[Int(i)]
        i = (i + UInt64(1))
    return Ptr[Float64](this[].global_temp, Int(Int64(0)))[Int(s)]

