def T_SWMMEngine__refreshLanduseParams(this: Ref[T_SWMMEngine]) raises:
    var np: Int32 = T_SimulationContext__n_pollutants(this[].ctx_)
    var nlu: Int32 = T_SimulationContext__n_landuses(this[].ctx_)
    if ((np <= Int32(0)) or (nlu <= Int32(0))):
        return
    if (this[].landuse_solver_[].buildup_params[].size().cast[DType.int32]() != (nlu * np)):
        return
    var lu: Int32 = Int32(0)
    while (lu < nlu):
        var p: Int32 = Int32(0)
        while (p < np):
            var k: UInt64 = ((lu * np) + p).cast[DType.uint64]()
            var bp: Ref[T_landuse_BuildupParams] = this[].landuse_solver_[].buildup_params[].a[Int(k)]
            bp[].type_ = this[].ctx_[].buildup[].func_type[].a[Int(k)]
            Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(0))] = this[].ctx_[].buildup[].coeff1[].a[Int(k)]
            Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(1))] = this[].ctx_[].buildup[].coeff2[].a[Int(k)]
            Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(2))] = this[].ctx_[].buildup[].coeff3[].a[Int(k)]
            bp[].normalizer = this[].ctx_[].buildup[].normalizer[].a[Int(k)]
            bp[].max_days = Float64(0.0)
            if ((bp[].type_ == T_landuse_BuildupType__EXPON) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(1))] > Float64(0.0))):
                bp[].max_days = ((-Math.Log(Float64(0.001))) / Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(1))])
            elif ((((bp[].type_ == T_landuse_BuildupType__POWER) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(1))] > Float64(0.0))) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(2))] > Float64(0.0))) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(0))] > Float64(0.0))):
                bp[].max_days = Math.Pow((Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(0))] / Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(1))]), (Float64(1.0) / Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(2))]))
            elif (((bp[].type_ == T_landuse_BuildupType__SATUR) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(2))] > Float64(0.0))) and (Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(0))] > Float64(0.0))):
                bp[].max_days = (Float64(999.0) * Ptr[Float64](bp[].coeff, Int(Int64(0)))[Int(Int32(2))])
            var wp: Ref[T_landuse_WashoffParams] = this[].landuse_solver_[].washoff_params[].a[Int(k)]
            wp[].type_ = this[].ctx_[].washoff[].func_type[].a[Int(k)]
            wp[].coeff = this[].ctx_[].washoff[].coeff[].a[Int(k)]
            wp[].expon = this[].ctx_[].washoff[].expon[].a[Int(k)]
            wp[].sweep_effic = this[].ctx_[].washoff[].sweep_effic[].a[Int(k)]
            wp[].bmp_effic = this[].ctx_[].washoff[].bmp_effic[].a[Int(k)]
            p = (p + Int32(1))
        lu = (lu + Int32(1))

def T_SWMMEngine__subcatchSnowDepth(this: Ref[T_SWMMEngine], var idx: Int32) raises -> Float64:
    var us: UInt64 = idx.cast[DType.uint64]()
    if (this[].ctx_[].subcatches[].snowpack[].a[Int(us)] < Int32(0)):
        return Float64(0.0)
    var soa: Ref[T_snow_SnowSoA] = T_snow_DegreeDaySnow__state__v(this[].snow_)
    var fi: Float64 = this[].ctx_[].subcatches[].frac_imperv[].a[Int(us)]
    var sn: Float64 = (soa[].snn[].a[Int(us)] if (us < soa[].snn[].size()) else Float64(0.0))
    var fArea: Ary[Float64] = Ary[Float64].of((sn * fi), ((Float64(1.0) - sn) * fi), (Float64(1.0) - fi))
    var base: Int32 = (idx * gs()[].G_F_snow__N_SUBAREAS)
    var sd: Float64 = Float64(0.0)
    var k: Int32 = Int32(0)
    while (k < gs()[].G_F_snow__N_SUBAREAS):
        var uk: UInt64 = (base + k).cast[DType.uint64]()
        if (uk < soa[].wsnow[].size()):
            sd = (sd + (soa[].wsnow[].a[Int(uk)] * Ptr[Float64](fArea, Int(Int64(0)))[Int(k)]))
        k = (k + Int32(1))
    return sd

