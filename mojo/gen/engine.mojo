    if MIt[Ref[Pair[Ref[Str], Ref[Vec[Int32]]]]].op_eq(it, this[].by_name[].end()):
        return Int32(-1)
    var v__r1: Ref[Vec[Int32]] = it.p_Deref()[].second
    var v__i2: Int64 = Int64(0)
    var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
    while (v__i2 < v__i2_n):
        var i: Int32 = v__r1[].a[Int(v__i2)]
        var is_ts: Bool = (this[].tables[].a[Int(i.cast[DType.uint64]())][].type_ == T_TableType__TIMESERIES)
        if ((Int32(1) if is_ts else Int32(0)) == (Int32(1) if want_timeseries else Int32(0))):
            return i
        v__i2 = (v__i2 + Int64(1))
    return Int32(-1)

