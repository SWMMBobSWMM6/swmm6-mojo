    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_links(ctx)):
        var uj: UInt64 = j.cast[DType.uint64]()
        if (ctx[].links[].type_[].a[Int(uj)] == T_LinkType__CONDUIT):
