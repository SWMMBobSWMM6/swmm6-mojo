            var v__b4: Ary[Float64] = Ary[Float64].of(Qso)
            F_inlet__findOnSagCurbFlows(d, g, depth, Lsweep, Ptr[Float64](v__b3, Int(Int64(0))), Ptr[Float64](v__b4, Int(Int64(0))))
            Qsw = v__b3[Int(Int32(0))]
