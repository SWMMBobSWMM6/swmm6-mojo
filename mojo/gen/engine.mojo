        var __cp1 = rt_addr(this[].fv_struct_int_[].a[Int(uj)])
        __cp1[] = (__cp1[] + (this[].fv_struct_flow_[].a[Int(uj)] * span))
        j = (j + Int32(1))
    this[].fv_struct_t_prev_ = t_now

