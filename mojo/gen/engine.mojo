def T_DividerData__add_default(this: Ref[T_DividerData], var i: Int32) raises -> Int32:
    var p: Int64 = Iter[Int32].op_sub(Algo.lower_bound[Int32](this[].node_idx[].begin(), this[].node_idx[].end(), i), this[].node_idx[].begin())
    _ = this[].node_idx[].insert(Iter[Int32].op_add(this[].node_idx[].begin(), p), i)
    _ = this[].method[].insert(Iter[T_DividerType].op_add(this[].method[].begin(), p), T_DividerType__CUTOFF)
    _ = this[].cutoff[].insert(Iter[Float64].op_add(this[].cutoff[].begin(), p), Float64(0.0))
    _ = this[].cd[].insert(Iter[Float64].op_add(this[].cd[].begin(), p), Float64(0.0))
    _ = this[].max_depth[].insert(Iter[Float64].op_add(this[].max_depth[].begin(), p), Float64(0.0))
    _ = this[].curve[].insert(Iter[Int32].op_add(this[].curve[].begin(), p), Int32(-1))
    _ = this[].link[].insert(Iter[Int32].op_add(this[].link[].begin(), p), Int32(-1))
    _ = this[].link_name[].insert(Iter[Ref[Str]].op_add(this[].link_name[].begin(), p), Str.new_())
    _ = this[].curve_name[].insert(Iter[Ref[Str]].op_add(this[].curve_name[].begin(), p), Str.new_())
    return p.cast[DType.int32]()

