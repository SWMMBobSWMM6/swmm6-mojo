def T_Router__initNodeFlows(this: Ref[T_Router], var ctx: Ref[T_SimulationContext], var dt: Float64, var evap_rate: Float64) raises:
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var n: Int32 = T_SimulationContext__n_nodes(ctx)
    var i: Int32 = Int32(0)
    while (i < n):
        var ui: UInt64 = i.cast[DType.uint64]()
        var loss_rate: Float64 = Float64(0.0)
        if (nodes[].type_[].a[Int(ui)] == T_NodeType__STORAGE):
            var sr: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, i)
            var st: Ref[T_StorageData] = ctx[].node_subtypes[].storages
            var sru: UInt64 = sr.cast[DType.uint64]()
            var evap_frac: Float64 = (st[].evap_frac[].a[Int(sru)] if (sr >= Int32(0)) else Float64(0.0))
            var seep_rate: Float64 = (st[].seep_rate[].a[Int(sru)] if (sr >= Int32(0)) else Float64(0.0))
            var stor_evap_rate: Float64 = (evap_rate * evap_frac)
            if ((sr >= Int32(0)) and (not st[].lid_state[].a[Int(sru)][].cells[].empty())):
                var state: Ref[T_LidNodeState] = st[].lid_state[].a[Int(sru)]
                var potential: Float64 = ((evap_rate * evap_frac) * state[].cells[].front()[][].area)
                var area: Float64 = F_node__getSurfArea(nodes, i, nodes[].depth[].a[Int(ui)], ctx[].tables, F_ucf__getUnitSystem(ctx[].options[].flow_units), ctx[].node_subtypes)
                stor_evap_rate = ((M.max_(Float64(0.0), (potential - (state[].evap_volume / dt))) / area) if (area > Float64(0.0)) else Float64(0.0))
                if state[].richards:
                    stor_evap_rate = Float64(0.0)
            var exfil_cfs: Float64 = (st[].exfil_rate[].a[Int(sru)] if (sr >= Int32(0)) else Float64(0.0))
            if (((stor_evap_rate > Float64(0.0)) or (seep_rate > Float64(0.0))) or (exfil_cfs > Float64(0.0))):
                var depth: Float64 = nodes[].depth[].a[Int(ui)]
                var area_2: Float64 = F_node__getSurfArea(nodes, i, depth, ctx[].tables, F_ucf__getUnitSystem(ctx[].options[].flow_units), ctx[].node_subtypes)
                var evap_cfs: Float64 = stor_evap_rate
                if (nodes[].volume[].a[Int(ui)] > gs()[].G_F_constants__FUDGE):
                    evap_cfs = (area_2 * stor_evap_rate)
                var total_loss: Float64 = ((evap_cfs + exfil_cfs) * dt)
                if ((total_loss > nodes[].volume[].a[Int(ui)]) and (total_loss > Float64(0.0))):
                    var ratio: Float64 = (nodes[].volume[].a[Int(ui)] / total_loss)
                    evap_cfs = (evap_cfs * ratio)
                    exfil_cfs = (exfil_cfs * ratio)
                if (sr >= Int32(0)):
                    st[].evap_loss[].a[Int(sru)] = (evap_cfs * dt)
                    st[].exfil_loss[].a[Int(sru)] = (exfil_cfs * dt)
                loss_rate = (evap_cfs + exfil_cfs)
            elif (sr >= Int32(0)):
                st[].evap_loss[].a[Int(sru)] = Float64(0.0)
                st[].exfil_loss[].a[Int(sru)] = Float64(0.0)
        nodes[].losses[].a[Int(ui)] = loss_rate
        nodes[].inflow[].a[Int(ui)] = nodes[].lat_flow[].a[Int(ui)]
        nodes[].outflow[].a[Int(ui)] = nodes[].losses[].a[Int(ui)]
        var full_vol: Float64 = (nodes[].full_volume[].a[Int(ui)] if (ctx[].options[].routing_model == T_RoutingModel__FV) else nodes[].rpt_full_volume[].a[Int(ui)])
        if ((nodes[].volume[].a[Int(ui)] > full_vol) and (dt > Float64(0.0))):
            nodes[].overflow[].a[Int(ui)] = ((nodes[].volume[].a[Int(ui)] - full_vol) / dt)
        else:
            nodes[].overflow[].a[Int(ui)] = Float64(0.0)
        i = (i + Int32(1))

def T_Router__computeConduitLosses(this: Ref[T_Router], var ctx: Ref[T_SimulationContext], var dt: Float64, var evap_rate: Float64) raises:
    var __sp = rt_sp()
    var seep_loss = rt_salloc[Float64]()
    var links: Ref[T_LinkData] = ctx[].links
    var n: Int32 = T_SimulationContext__n_links(ctx)
