def T_iface_InterfaceManager__writeFileHeader(this: Ref[T_iface_InterfaceManager], var ctx: Ref[T_SimulationContext]) raises:
    if (not (rt_box(this[].outfile_) != Obj())):
        return
    _ = R.fprintf(this[].outfile_, rt_lit("SWMM5 Interface File"))
    _ = R.fprintf(this[].outfile_, rt_lit("\n%s"), A(rt_lit("OpenSWMM Engine Output")))
    var report_step: Int32 = Conv.D2I(ctx[].options[].report_step)
