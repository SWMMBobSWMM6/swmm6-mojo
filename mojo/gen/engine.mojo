def F_quality__anon_quality_QualityRouting_cpp__loadersNeeded_QualityRouting(var np: Int32, var ctx: Ref[T_SimulationContext]) raises -> Bool:
    return (((((np > Int32(0)) or F_transport__ardBoundariesNeedExternalVolumes(ctx)) or ctx[].options[].water_age) or ctx[].options[].heat_transport) or F_transport__legacyReactionsActive(ctx))

def F_quality__anon_quality_QualityRouting_cpp__addAgeVolume_QualityRouting(var ctx: Ref[T_SimulationContext], var node: Int32, var q: Float64, var src: T_WaterAgeSource) raises:
    if (not ctx[].options[].water_age):
        return
    var s: Ref[Vec[Float64]] = ctx[].water_age_state[].node_age_vol_in
    var un: UInt64 = node.cast[DType.uint64]()
    if (un >= s[].size()):
        return
    var age: Float64 = T_WaterAgeConfigData__source_age(ctx[].water_age_config, src, node)
    if (src == T_WaterAgeSource__EXTERNAL_INFLOW):
        var ov: Ref[Vec[Float64]] = ctx[].water_age_state[].node_ext_inflow_age
        if ((un < ov[].size()) and (not Dbl.IsNaN(ov[].a[Int(un)]))):
            age = ov[].a[Int(un)]
    var __cp1 = rt_addr(s[].a[Int(un)])
    __cp1[] = (__cp1[] + (q * age))

def F_quality__anon_quality_QualityRouting_cpp__addTempVolume_QualityRouting(var ctx: Ref[T_SimulationContext], var node: Int32, var q: Float64, var src: T_HeatSource) raises:
    if (not ctx[].options[].heat_transport):
        return
    var s: Ref[Vec[Float64]] = ctx[].heat_state[].node_temp_vol_in
    var un: UInt64 = node.cast[DType.uint64]()
    if (un >= s[].size()):
        return
    var __cp1 = rt_addr(s[].a[Int(un)])
    __cp1[] = (__cp1[] + (q * T_HeatConfigData__source_temp(ctx[].heat_config, src, node)))

def F_quality__anon_quality_QualityRouting_cpp__nodeHasTreatmentFor_QualityRouting(var ctx: Ref[T_SimulationContext], var node: Int32, var p: Int32) raises -> Bool:
    var tr: Ref[T_TreatmentData] = ctx[].treatment
    if (tr[].n_pollutants <= Int32(0)):
        return False
    var idx: UInt64 = ((node.cast[DType.uint64]() * tr[].n_pollutants.cast[DType.uint64]()) + p.cast[DType.uint64]())
    return ((idx < tr[].expressions[].size()) and (not tr[].expressions[].a[Int(idx)][].empty()))

def F_quality__anon_quality_QualityRouting_cpp__applyLinkQualityForcing_QualityRouting(var ctx: Ref[T_SimulationContext], var n_pollutants: Int32, var dt: Float64) raises:
    if (n_pollutants <= Int32(0)):
        return
    var f: Ref[T_ForcingData] = ctx[].forcing
    if f[].link_quality_mode[].empty():
        return
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_links(ctx)):
        var uj: UInt64 = j.cast[DType.uint64]()
        var p: Int32 = Int32(0)
        while (p < n_pollutants):
            var flat: UInt64 = ((uj * n_pollutants.cast[DType.uint64]()) + p.cast[DType.uint64]())
            if ((flat >= f[].link_quality_mode[].size()) or (flat >= ctx[].links[].conc[].size())):
                p = (p + Int32(1))
                continue
            if (f[].link_quality_mode[].a[Int(flat)] == T_ForcingMode__OVERRIDE):
                ctx[].links[].conc[].a[Int(flat)] = M.max_(f[].link_quality_value[].a[Int(flat)], Float64(0.0))
            elif (f[].link_quality_mode[].a[Int(flat)] == T_ForcingMode__ADD):
                ctx[].links[].conc[].a[Int(flat)] = M.max_((ctx[].links[].conc[].a[Int(flat)] + f[].link_quality_value[].a[Int(flat)]), Float64(0.0))
                var __cp1 = rt_addr(ctx[].mass_balance[].routing_forcing_qual_inflow[].a[Int(p.cast[DType.uint64]())])
                __cp1[] = (__cp1[] + (f[].link_quality_value[].a[Int(flat)] * dt))
            p = (p + Int32(1))
        j = (j + Int32(1))

