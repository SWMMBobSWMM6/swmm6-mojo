    elif __sv1 == T_XsectShape__SEMICIRCULAR:
        return Int32(21)
    elif __sv1 == T_XsectShape__RECT_TRIANG:
        return Int32(9)
    elif __sv1 == T_XsectShape__RECT_ROUND:
        return Int32(10)
    elif __sv1 == T_XsectShape__HORIZ_ELLIPSE:
        return Int32(12)
    elif __sv1 == T_XsectShape__VERT_ELLIPSE:
        return Int32(13)
    elif __sv1 == T_XsectShape__ARCH:
        return Int32(14)
    elif __sv1 == T_XsectShape__IRREGULAR:
