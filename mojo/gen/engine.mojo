            tok[].assign(quoted[].begin(), quoted[].end())
        if (tok[].size() < UInt64(3)):
            v__i2 = (v__i2 + Int64(1))
            continue
        var idx: Int32 = T_NameIndex__find(ctx[].node_names, tok[].a[Int(UInt64(0))][].Clone())
        if (idx < Int32(0)):
