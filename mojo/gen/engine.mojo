    return ((wMin + ((wMax - wMin) / Float64(2.0))) * (y - y1))

def F_transect__anon_hydraulics_Transect_cpp__shapeGetPerim_Transect(var y: Float64, var w: Float64, var y1: Float64, var w1: Float64) raises -> Float64:
