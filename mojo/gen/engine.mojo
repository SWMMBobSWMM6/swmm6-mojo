def T_fv_NetworkMeshData__deriveFaceGeom(this: Ref[T_fv_NetworkMeshData]) raises:
    if (this[].face_geom[].size() == T_fv_NetworkMeshData__n_faces(this).cast[DType.uint64]()):
        return
    this[].face_geom[].assign(T_fv_NetworkMeshData__n_faces(this).cast[DType.uint64](), Int32(0))
    var f: Int32 = Int32(0)
    while (f < T_fv_NetworkMeshData__n_faces(this)):
        var uf: UInt64 = f.cast[DType.uint64]()
        var c: Int32 = (this[].face_cl[].a[Int(uf)] if (this[].face_cl[].a[Int(uf)] >= Int32(0)) else this[].face_cr[].a[Int(uf)])
        this[].face_geom[].a[Int(uf)] = (this[].cell_geom[].a[Int(c.cast[DType.uint64]())] if ((c >= Int32(0)) and (c.cast[DType.uint64]() < this[].cell_geom[].size())) else Int32(0))
        f = (f + Int32(1))

