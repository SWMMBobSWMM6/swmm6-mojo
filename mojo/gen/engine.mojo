def T_SWMMEngine__isBetweenEvents(this: Ref[T_SWMMEngine], var current_date: Float64) raises -> Bool:
    if this[].ctx_[].events[].empty():
        return False
    if (this[].next_event_ >= this[].ctx_[].events[].size().cast[DType.int32]()):
        return True
    var ev: Ref[T_SimulationContext_Event] = this[].ctx_[].events[].a[Int(this[].next_event_.cast[DType.uint64]())]
    if (current_date > ev[].end):
        return True
    if (current_date >= ev[].start):
        return False
    return True

def T_SWMMEngine__isInSteadyState(this: Ref[T_SWMMEngine], var action_count: Int32) raises -> Bool:
    if (not this[].ctx_[].options[].skip_steady_state):
        return False
    if ((this[].ctx_[].old_elapsed_ms == Float64(0.0)) and (this[].ctx_[].elapsed_ms == Float64(0.0))):
        return False
    if (this[].ctx_[].current_time == Float64(0.0)):
        return False
    if (action_count > Int32(0)):
        return False
    if (Math.Abs(this[].ctx_[].mass_balance[].last_step_flow_error) > this[].ctx_[].options[].sys_flow_tol):
        return False
    var TINY: Float64 = Float64(1e-06)
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_nodes(this[].ctx_)):
        var uj: UInt64 = j.cast[DType.uint64]()
        var qOld: Float64 = this[].ctx_[].nodes[].old_lat_flow[].a[Int(uj)]
        var qNew: Float64 = this[].ctx_[].nodes[].lat_flow[].a[Int(uj)]
        var diff: Float64 = Float64(0.0)
        if (Math.Abs(qOld) > TINY):
            diff = ((qNew / qOld) - Float64(1.0))
        elif (Math.Abs(qNew) > TINY):
            diff = Float64(1.0)
        else:
            diff = Float64(0.0)
        if (Math.Abs(diff) > this[].ctx_[].options[].lat_flow_tol):
            return False
        if ((this[].ctx_[].nodes[].type_[].a[Int(uj)] == T_NodeType__OUTFALL) or (this[].ctx_[].nodes[].degree[].a[Int(uj)] == Int32(0))):
            qOld = this[].ctx_[].nodes[].old_inflow[].a[Int(uj)]
            qNew = this[].ctx_[].nodes[].inflow[].a[Int(uj)]
            if (Math.Abs(qOld) > TINY):
                diff = ((qNew / qOld) - Float64(1.0))
            elif (Math.Abs(qNew) > TINY):
                diff = Float64(1.0)
            else:
                diff = Float64(0.0)
            if (Math.Abs(diff) > this[].ctx_[].options[].lat_flow_tol):
                return False
        j = (j + Int32(1))
    return True

