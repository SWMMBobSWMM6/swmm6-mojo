def F_forcemain__getEquivN(var model: T_forcemain_FrictionModel, var r_bot: Float64, var y_full: Float64, var slope: Float64, var n_raw: Float64) raises -> Float64:
    if ((slope <= Float64(0.0)) or (y_full <= Float64(0.0))):
        return n_raw
    var __sv1 = model
    if __sv1 == T_forcemain_FrictionModel__HAZEN_WILLIAMS:
        return ((Float64(1.067) / r_bot) * Math.Pow((y_full / slope), Float64(0.04)))
    elif __sv1 == T_forcemain_FrictionModel__DARCY_WEISBACH:
        var hrad: Float64 = (y_full / Float64(4.0))
        var f: Float64 = F_forcemain__getFricFactor(r_bot, hrad, Float64(1000000000000.0))
        return (Math.Sqrt((f / Float64(185.0))) * Math.Pow(y_full, Float64(0.16666666666666666)))
    return n_raw

def F_forcemain__getRoughFactor(var model: T_forcemain_FrictionModel, var r_bot: Float64, var length_factor: Float64) raises -> Float64:
    if (length_factor <= Float64(0.0)):
        length_factor = Float64(1.0)
    var G: Float64 = Float64(32.2)
    var __sv1 = model
    if __sv1 == T_forcemain_FrictionModel__HAZEN_WILLIAMS:
        var denom: Float64 = ((Float64(1.318) * r_bot) * Math.Pow(length_factor, Float64(0.54)))
        return ((G / Math.Pow(denom, Float64(1.852))) if (denom > Float64(0.0)) else Float64(0.0))
    elif __sv1 == T_forcemain_FrictionModel__DARCY_WEISBACH:
        return (Float64(1.0) / (Float64(8.0) * length_factor))
    return Float64(0.0)

def F_forcemain__getFricFactor(var r_bot: Float64, var hrad: Float64, var re: Float64) raises -> Float64:
    if (hrad <= Float64(0.0)):
        return Float64(0.0)
    var f: Float64 = Float64(0.0)
    if (re < Float64(10.0)):
        re = Float64(10.0)
    if (re <= Float64(2000.0)):
        f = (Float64(64.0) / re)
    elif (re < Float64(4000.0)):
        f = F_forcemain__getFricFactor(r_bot, hrad, Float64(4000.0))
        f = (Float64(0.032) + (((f - Float64(0.032)) * (re - Float64(2000.0))) / Float64(2000.0)))
    else:
        f = ((r_bot / Float64(3.7)) / (Float64(4.0) * hrad))
        if (re < Float64(10000000000.0)):
            f = (f + (Float64(5.74) / Math.Pow(re, Float64(0.9))))
        f = Math.Log10(f)
        f = ((Float64(0.25) / f) / f)
    return f

