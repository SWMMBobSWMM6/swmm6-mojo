            xs[].w_max = w_3
            xs[].yw_max = y_4
            xs[].s_bot = ((w_3 / y_4) / Float64(2.0))
            xs[].r_bot = Math.Sqrt((Float64(1.0) + (xs[].s_bot * xs[].s_bot)))
            xs[].a_full = ((y_4 * y_4) * xs[].s_bot)
            xs[].r_full = (xs[].a_full / ((Float64(2.0) * y_4) * xs[].r_bot))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
