    var i_3: Int32 = Int32(0)
    while (i_3 < T_SimulationContext__n_nodes(ctx)):
        if (not T_iface_InterfaceManager__isOutletNode(ctx, i_3)):
            i_3 = (i_3 + Int32(1))
            continue
        var nname: Ref[Str] = T_NameIndex__names(ctx[].node_names)[].a[Int(i_3.cast[DType.uint64]())]
        _ = R.fprintf(this[].outfile_, rt_lit("\n%s"), A(nname[].c_str()))
