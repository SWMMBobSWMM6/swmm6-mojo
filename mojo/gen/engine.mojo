    return this[].cell_q_int_

def T_fv_ExplicitFvSolver__nodeLateral(this: Ref[T_fv_ExplicitFvSolver], var forcing: Ref[T_fv_FvStepForcing], var un: UInt64) raises -> Float64:
    if ((not this[].node_lat_div_[].empty()) and (this[].node_lat_div_[].a[Int(un)].cast[DType.int32]() != Int32(0))):
        return Float64(0.0)
    return (forcing[].node_lateral[Int(un)] if (not forcing[].node_lateral.isnull()) else Float64(0.0))

def T_fv_ExplicitFvSolver__algebraicActive(this: Ref[T_fv_ExplicitFvSolver], var n: Int32) raises -> Bool:
    var un: UInt64 = n.cast[DType.uint64]()
    if (not (this[].node_alg_[].a[Int(un)].cast[DType.int32]() != Int32(0))):
        return False
    if ((this[].mesh_[].node_can_pond[].a[Int(un)].cast[DType.int32]() != Int32(0)) and (this[].state_[].node_volume[].a[Int(un)] > this[].node_vfull_[].a[Int(un)])):
        return False
    return True

def T_fv_ExplicitFvSolver__incidentPressurized(this: Ref[T_fv_ExplicitFvSolver], var un: UInt64) raises -> Bool:
    var p: Int32 = this[].mesh_[].node_face_ptr[].a[Int(un)]
    while (p < this[].mesh_[].node_face_ptr[].a[Int((un + UInt64(1)))]):
        var uf: UInt64 = this[].mesh_[].node_face_idx[].a[Int(p.cast[DType.uint64]())].cast[DType.uint64]()
        var c: Int32 = (this[].mesh_[].face_cl[].a[Int(uf)] if (this[].mesh_[].face_cl[].a[Int(uf)] >= Int32(0)) else this[].mesh_[].face_cr[].a[Int(uf)])
        if (c < Int32(0)):
            p = (p + Int32(1))
            continue
        var uc: UInt64 = c.cast[DType.uint64]()
        if T_fv_ExplicitFvSolver__tpaCell(this, uc):
            return True
        var g: Ref[T_fv_FvGeometry] = this[].mesh_[].geom[].a[Int(this[].mesh_[].cell_geom[].a[Int(uc)].cast[DType.uint64]())]
        if ((not (g[].is_open.cast[DType.int32]() != Int32(0))) and (this[].state_[].cell_h[].a[Int(uc)] >= g[].y_crown)):
            return True
        p = (p + Int32(1))
    return False

def T_fv_ExplicitFvSolver__nodeQDummy(this: Ref[T_fv_ExplicitFvSolver], var un: UInt64) raises -> Float64:
    return (Float64(0.0) if this[].node_qdummy_[].empty() else this[].node_qdummy_[].a[Int(un)])

def T_fv_ExplicitFvSolver__ltsEligible(this: Ref[T_fv_ExplicitFvSolver]) raises -> Bool:
    return (((this[].opts_[].lts and (this[].opts_[].time_integration != T_fv_TimeIntegration__RK2)) and (rt_box(this[].state_) != Obj())) and (this[].state_[].n_species == Int32(0)))

def T_fv_ExplicitFvSolver__faceIsLive(this: Ref[T_fv_ExplicitFvSolver], var f: Int32) raises -> Bool:
    return (this[].all_faces_live_ or ((not this[].live_stamp_[].empty()) and (this[].live_stamp_[].a[Int(f.cast[DType.uint64]())] == this[].live_gen_)))

def T_fv_ExplicitFvSolver__tpaCell(this: Ref[T_fv_ExplicitFvSolver], var uc: UInt64) raises -> Bool:
    return (this[].tpa_ and (this[].state_[].cell_tpa[].a[Int(uc)].cast[DType.int32]() != Int32(0)))

