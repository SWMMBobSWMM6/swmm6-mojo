        var v_in: Float64 = this[].node_vol_in_[].a[Int(un)]
        var zero_bf: Bool = ((ctx[].options[].outfall_backflow_zero and (nodes[].type_[].a[Int(un)] == T_NodeType__OUTFALL)) and ((v_in + (nodes[].qual_vol_in[].a[Int(un)] * frac)) <= Float64(0.0)))
        var s: Int32 = Int32(0)
