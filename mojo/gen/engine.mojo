def T_SubcatchData__resize_quality(this: Ref[T_SubcatchData], var n_pollutants: Int32) raises:
    this[].conc_n_pollutants = n_pollutants
    if (n_pollutants > Int32(0)):
        var total: UInt64 = (T_SubcatchData__count(this).cast[DType.uint64]() * n_pollutants.cast[DType.uint64]())
        this[].conc[].assign(total, Float64(0.0))
        this[].conc_old[].assign(total, Float64(0.0))
        this[].init_loading[].assign(total, Float64(0.0))
        this[].ponded_qual[].assign(total, Float64(0.0))
        this[].runon_qual_rate[].assign(total, Float64(0.0))
        this[].lid_drain_runon_qual[].assign(total, Float64(0.0))
        this[].washoff_load[].assign(total, Float64(0.0))

