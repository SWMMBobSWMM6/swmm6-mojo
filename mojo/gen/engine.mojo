def F_kinwave__getLinkInflow(var ctx: Ref[T_SimulationContext], var structures: Ref[T_hydstruct_StructureSolver], var j: Int32, var dt: Float64) raises -> Float64:
    var links: Ref[T_LinkData] = ctx[].links
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var uj: UInt64 = j.cast[DType.uint64]()
    var n1: Int32 = links[].node1[].a[Int(uj)]
    if (n1 < Int32(0)):
        return Float64(0.0)
    var un1: UInt64 = n1.cast[DType.uint64]()
    var lt: T_LinkType = links[].type_[].a[Int(uj)]
    var q: Float64 = Float64(0.0)
    if (links[].setting[].a[Int(uj)] == Float64(0.0)):
        return Float64(0.0)
    if (lt == T_LinkType__CONDUIT):
        if (nodes[].type_[].a[Int(un1)] == T_NodeType__STORAGE):
            q = F_kinwave__storageConduitOutflow_KinematicWave(ctx, n1, j)
        elif (nodes[].type_[].a[Int(un1)] == T_NodeType__DIVIDER):
            q = F_divider__getOutflow(ctx, n1, j)
        else:
            q = (nodes[].inflow[].a[Int(un1)] + nodes[].overflow[].a[Int(un1)])
        var qlim: Float64 = links[].q_limit[].a[Int(uj)]
        if ((qlim > Float64(0.0)) and (q > qlim)):
            q = qlim
    elif ((lt == T_LinkType__PUMP) or (nodes[].type_[].a[Int(un1)] == T_NodeType__STORAGE)):
        if (rt_box(structures) != Obj()):
            var q_saved: Float64 = links[].flow[].a[Int(uj)]
            T_hydstruct_StructureSolver__computeNonConduitFlowOne(structures, ctx, dt, Ptr[Float64](), j)
            q = links[].flow[].a[Int(uj)]
            links[].flow[].a[Int(uj)] = q_saved
    return F_node__getMaxOutflow(nodes, n1, q, dt)

