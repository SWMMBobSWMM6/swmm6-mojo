def F_inlet__getOnSagCapturedFlow(var d: Ref[T_inlet_Design], var u: Ref[T_inlet_UsageParams], var g: Ref[T_inlet_Geom], var depth: Float64, var nsides_prev: Int32) raises -> Float64:
    if (u[].num_inlets == Int32(0)):
        return Float64(0.0)
    var totalInlets: Int32 = (nsides_prev * u[].num_inlets)
    var qMax: Float64 = gs()[].G_F_inlet__INLET_BIG
    if (u[].flow_limit > Float64(0.0)):
        qMax = u[].flow_limit
    var qCaptured: Float64 = F_inlet__getOnSagInletCapture(d, g, Math.Abs(depth))
    qCaptured = (qCaptured * u[].clog_factor)
    qCaptured = M.min_(qCaptured, qMax)
    qCaptured = (qCaptured * totalInlets.cast[DType.float64]())
    return qCaptured

def F_inlet__getCustomCapturedFlow(var u: Ref[T_inlet_UsageParams], var g: Ref[T_inlet_Geom], var curve: Ref[T_Table], var curve_kind: Int32, var q: Float64, var depth: Float64, var ucf_flow: Float64, var ucf_len: Float64) raises -> Float64:
    if (u[].num_inlets == Int32(0)):
        return Float64(0.0)
    var qMax: Float64 = gs()[].G_F_inlet__INLET_BIG
    if (u[].flow_limit > Float64(0.0)):
        qMax = u[].flow_limit
    var sides: Int32 = g[].nsides
