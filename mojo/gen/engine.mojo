def F_inlet__getOnGradeCapturedFlow(var d: Ref[T_inlet_Design], var u: Ref[T_inlet_UsageParams], var g: Ref[T_inlet_Geom], var q: Float64, var depth: Float64) raises -> Float64:
    if (u[].num_inlets == Int32(0)):
        return Float64(0.0)
    var qApproach: Float64 = q
    if (qApproach < gs()[].G_F_inlet__MIN_RUNOFF_FLOW):
        return Float64(0.0)
    qApproach = (qApproach / g[].nsides.cast[DType.float64]())
    var qBypassed: Float64 = qApproach
    var qCaptured: Float64 = Float64(0.0)
    var qMax: Float64 = gs()[].G_F_inlet__INLET_BIG
    if (u[].flow_limit > Float64(0.0)):
        qMax = u[].flow_limit
