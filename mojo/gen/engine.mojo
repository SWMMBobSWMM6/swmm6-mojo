                iter_ = (iter_ + Int32(1))
            Ts1 = (Ts2 + g[].w)
    return M.min_(Ts1, g[].t_crown)

def F_inlet__getGutterFlowRatio(var g: Ref[T_inlet_Geom], var w: Float64) raises -> Float64:
    if (g[].t <= w):
