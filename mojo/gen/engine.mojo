def T_LinkData__MoveNew(var s: Ref[T_LinkData]) raises -> Ref[T_LinkData]:
    var o: Ref[T_LinkData] = T_LinkData__raw()
    T_LinkData__MoveFrom(o, s)
    return o

def T_LinkData__lstep_bin(var dt: Float64, var rs: Float64) raises -> Int32:
    var b: Int32 = Int32(0)
    var edge: Float64 = (Float64(0.5) * rs)
    while ((b < (gs()[].G_T_LinkData__N_LSTEP_BINS - Int32(1))) and (dt <= edge)):
        b = (b + Int32(1))
        edge = (edge * Float64(0.5))
    return b

def T_LinkData__add_lstep_sample(this: Ref[T_LinkData], var j: Int32, var dt: Float64, var dur: Float64, var rs: Float64) raises:
    var u: UInt64 = j.cast[DType.uint64]()
    if ((this[].stat_lstep_time[].a[Int(u)] <= Float64(0.0)) or (dt < this[].stat_lstep_min[].a[Int(u)])):
        this[].stat_lstep_min[].a[Int(u)] = dt
    if (dt > this[].stat_lstep_max[].a[Int(u)]):
        this[].stat_lstep_max[].a[Int(u)] = dt
    var __cp1 = rt_addr(this[].stat_lstep_dt_time[].a[Int(u)])
    __cp1[] = (__cp1[] + (dt * dur))
    var __cp2 = rt_addr(this[].stat_lstep_time[].a[Int(u)])
    __cp2[] = (__cp2[] + dur)
    var __cp3 = rt_addr(this[].stat_lstep_bin_time[].a[Int(((u * gs()[].G_T_LinkData__N_LSTEP_BINS.cast[DType.uint64]()) + T_LinkData__lstep_bin(dt, rs).cast[DType.uint64]()))])
    __cp3[] = (__cp3[] + dur)

def T_LinkData__count(this: Ref[T_LinkData]) raises -> Int32:
    return this[].type_[].size().cast[DType.int32]()

