    var is_inlet_node: Bool = ((ui < ctx[].nodes[].is_inlet[].size()) and (ctx[].nodes[].is_inlet[].a[Int(ui)].cast[DType.int32]() != Int32(0)))
    if ((t[].is_virtual.cast[DType.int32]() != Int32(0)) and (not is_inlet_node)):
