def F_hydraulics__applySeepageForcing(var ctx: Ref[T_SimulationContext], var link: UInt64, seep_rate: P[Float64]) raises:
    var f: Ref[T_ForcingData] = ctx[].forcing
    if (link >= f[].link_seepage_mode[].size()):
        return
    var __sv1 = f[].link_seepage_mode[].a[Int(link)]
    while True:
        if __sv1 == T_ForcingMode__OVERRIDE:
            seep_rate[] = f[].link_seepage_value[].a[Int(link)]
            break
        elif __sv1 == T_ForcingMode__ADD:
            seep_rate[] = (seep_rate[] + f[].link_seepage_value[].a[Int(link)])
            break
        else:
            break
        break

