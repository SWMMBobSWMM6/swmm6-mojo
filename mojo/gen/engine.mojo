def F_surface_ueb__initializeSubcatchments(var ctx: Ref[T_SimulationContext], var s: Ref[T_snow_SnowSoA]) raises -> Ref[Str]:
    var next_: Ref[T_surface_ueb_NativeState] = T_surface_ueb_NativeState__new()
    next_[].columns[].resize(s[].wsnow[].size())
    next_[].last[].resize(s[].wsnow[].size())
    next_[].sample_end[].resize(s[].wsnow[].size())
    next_[].sample_seconds[].resize(s[].wsnow[].size())
    next_[].rain[].assign(s[].n_subcatch.cast[DType.uint64](), Float64(-1.0))
    next_[].snow[].assign(s[].n_subcatch.cast[DType.uint64](), Float64(-1.0))
    var external: Ref[Vec[Bool]] = s[].external[].Clone()
    var config: Ref[T_surface_SnowConfig] = ctx[].snowpacks[].config
    var sc: Int32 = Int32(0)
    while (sc < s[].n_subcatch):
        var pack: Int32 = ctx[].subcatches[].snowpack[].a[Int(sc.cast[DType.uint64]())]
        external[].a[Int(sc.cast[DType.uint64]())] = ((pack >= Int32(0)) and (T_surface_SnowConfig__modelFor(config, pack) == T_surface_SnowKind__Ueb))
        if (not external[].a[Int(sc.cast[DType.uint64]())]):
            sc = (sc + Int32(1))
            continue
