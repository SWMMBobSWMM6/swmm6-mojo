            ci_2 = (ci_2 + Int32(1))
    if (this[].surcharge_method == T_dynwave_SurchargeMethod__SLOT):
        var ci_3: Int32 = Int32(0)
        while (ci_3 < this[].n_conduits_):
            var uci_3: UInt64 = ci_3.cast[DType.uint64]()
            var j_2: Int32 = this[].conduit_idx_[].a[Int(uci_3)]
            var uj_3: UInt64 = j_2.cast[DType.uint64]()
            if (this[].is_open_[].a[Int(uj_3)].cast[DType.int32]() != Int32(0)):
                ci_3 = (ci_3 + Int32(1))
