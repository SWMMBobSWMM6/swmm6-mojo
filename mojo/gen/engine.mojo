def F_transport_heat__bedExchangeQ(var cfg: Ref[T_SedimentConfig], var bed_m2: Float64) raises -> Float64:
    if ((not (bed_m2 > Float64(0.0))) or (not (cfg[].bed_thickness > Float64(0.0)))):
        return Float64(0.0)
    return (((cfg[].solute_diffusivity * bed_m2) / cfg[].bed_thickness) + (cfg[].hyporheic_velocity * bed_m2))

def F_transport_heat__linkBedAreaM2(var ctx: Ref[T_SimulationContext], var link: Int32) raises -> Float64:
    var uj: UInt64 = link.cast[DType.uint64]()
    var cr: Int32 = T_LinkSubtypes__conduit_row(ctx[].link_subtypes, link)
    if (cr < Int32(0)):
        return Float64(0.0)
    var ucr: UInt64 = cr.cast[DType.uint64]()
    var CD: Ref[T_ConduitData] = ctx[].link_subtypes[].conduits
    var length: Float64 = CD[].length[].a[Int(ucr)]
    if (not (length > Float64(0.0))):
        length = CD[].mod_length[].a[Int(ucr)]
    if (not (length > Float64(0.0))):
        return Float64(0.0)
    var depth: Float64 = ctx[].links[].depth[].a[Int(uj)]
    if (not (depth > Float64(0.0))):
        return Float64(0.0)
    var xs: Ref[T_XSectParams] = F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__buildXsp_BedExchange(ctx[].links, uj)
    var area: Float64 = F_xsect__getAofY(xs, depth)
    var rhyd: Float64 = F_xsect__getRofY(xs, depth)
    if ((not (area > Float64(0.0))) or (not (rhyd > Float64(0.0)))):
        return Float64(0.0)
    var perim_ft: Float64 = (area / rhyd)
    var m2: Float64 = (((perim_ft * length) * CD[].barrels[].a[Int(ucr)].cast[DType.float64]()) * gs()[].G_F_transport_heat__kSqFtToSqM)
    return (m2 if (m2 > Float64(0.0)) else Float64(0.0))

def F_transport_heat__linkFreeSurfaceFt2(var ctx: Ref[T_SimulationContext], var link: Int32) raises -> Float64:
    var uj: UInt64 = link.cast[DType.uint64]()
    var cr: Int32 = T_LinkSubtypes__conduit_row(ctx[].link_subtypes, link)
    if (cr < Int32(0)):
        return Float64(0.0)
    if (not F_xsect__isOpen(ctx[].links[].xsect_batch_shape[].a[Int(uj)])):
        return Float64(0.0)
    var ucr: UInt64 = cr.cast[DType.uint64]()
    var CD: Ref[T_ConduitData] = ctx[].link_subtypes[].conduits
    var length: Float64 = CD[].length[].a[Int(ucr)]
    if (not (length > Float64(0.0))):
        length = CD[].mod_length[].a[Int(ucr)]
    var depth: Float64 = ctx[].links[].depth[].a[Int(uj)]
    if ((not (length > Float64(0.0))) or (not (depth > Float64(0.0)))):
        return Float64(0.0)
    var xs: Ref[T_XSectParams] = F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__buildXsp_BedExchange(ctx[].links, uj)
    var top_width: Float64 = F_xsect__getWofY(xs, depth)
    if (not (top_width > Float64(0.0))):
        return Float64(0.0)
    return ((top_width * length) * CD[].barrels[].a[Int(ucr)].cast[DType.float64]())

def F_transport_heat__fillChannelThermalGeometry(var ctx: Ref[T_SimulationContext], var region: Ref[T_ChannelThermalRegion]) raises:
    var link: Int32 = region[].link
    if ((link < Int32(0)) or (link >= T_SimulationContext__n_links(ctx))):
        return
    var row: Int32 = T_LinkSubtypes__conduit_row(ctx[].link_subtypes, link)
    if (row < Int32(0)):
        return
    var conduits: Ref[T_ConduitData] = ctx[].link_subtypes[].conduits
    var length: Float64 = (conduits[].length[].a[Int(row.cast[DType.uint64]())] if (conduits[].length[].a[Int(row.cast[DType.uint64]())] > Float64(0.0)) else conduits[].mod_length[].a[Int(row.cast[DType.uint64]())])
    region[].length = (length * Float64(0.3048))
    region[].depth = (ctx[].links[].depth[].a[Int(link.cast[DType.uint64]())] * Float64(0.3048))
    region[].surface_area = (F_transport_heat__linkFreeSurfaceFt2(ctx, link) * gs()[].G_F_transport_heat__kSqFtToSqM)
    region[].bed_area = F_transport_heat__linkBedAreaM2(ctx, link)

def F_transport_heat__groundTemperature(var ctx: Ref[T_SimulationContext]) raises -> Float64:
