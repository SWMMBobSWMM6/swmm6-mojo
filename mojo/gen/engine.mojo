def T_fv_ExplicitFvSolver__bookDivertedLateral(this: Ref[T_fv_ExplicitFvSolver], var un: UInt64, var dt: Float64, var forcing: Ref[T_fv_FvStepForcing]) raises:
    if ((this[].node_lat_div_[].empty() or (not (this[].node_lat_div_[].a[Int(un)].cast[DType.int32]() != Int32(0)))) or (not (not forcing[].node_lateral.isnull()))):
        return
    var lat: Float64 = forcing[].node_lateral[Int(un)]
    if (lat > Float64(0.0)):
        var __cp1 = rt_addr(this[].node_out_[].a[Int(un)])
        __cp1[] = (__cp1[] + (lat * dt))

