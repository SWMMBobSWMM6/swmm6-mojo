def F_inlet__getOnGradeInletCapture(var d: Ref[T_inlet_Design], var g: Ref[T_inlet_Geom], var Q: Float64, var depth: Float64) raises -> Float64:
    var Q1: Float64 = Q
    var Qc: Float64 = Float64(0.0)
