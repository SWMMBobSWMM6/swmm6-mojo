def T_climate_HourlyMeteorology__average(this: Ref[T_climate_HourlyMeteorology], var start: Float64, var seconds: Float64, var result: Ary[Float64]) raises -> Ref[Str]:
    if ((((not Dbl.IsFinite(start)) or (not Dbl.IsFinite(seconds))) or (seconds <= Float64(0.0))) or this[].records_[].empty()):
        return Str.new_(rt_lit("Invalid hourly meteorology request."))
    var tolerance: Float64 = Float64(1e-05)
    var offset: Float64 = ((start - this[].records_[].front()[][].date) * Float64(86400.0))
    var nearest_hour: Float64 = (LibM.round_((offset / Float64(3600.0))) * Float64(3600.0))
    if (Math.Abs((offset - nearest_hour)) <= tolerance):
        offset = nearest_hour
    var available: Float64 = (this[].records_[].size().cast[DType.float64]() * Float64(3600.0))
    if ((((not Dbl.IsFinite(offset)) or (offset < (-tolerance))) or (offset >= available)) or (seconds > ((available - offset) + tolerance))):
        return Str.new_(rt_lit("Hourly meteorology does not cover the requested simulation interval."))
    offset = M.max_(Float64(0.0), offset)
    var index: UInt64 = Conv.D2UL((offset / Float64(3600.0)))
    var within_hour: Float64 = (offset - (index.cast[DType.float64]() * Float64(3600.0)))
    var remaining: Float64 = seconds
    var sum: Ary[Float64] = Ary[Float64].of(Float64(0.0), Float64(0.0), Float64(0.0), Float64(0.0), Float64(0.0))
    var elapsed: Float64 = Float64(0.0)
    while ((index < this[].records_[].size()) and (remaining > Float64(0.0))):
        var duration: Float64 = M.min_(remaining, (Float64(3600.0) - within_hour))
        var i: Int32 = Int32(0)
        while (i < Int32(5)):
            var __cp1 = sum.ptr(Int(i.cast[DType.uint64]()))
            __cp1[] = (__cp1[] + (duration * this[].records_[].a[Int(index)][].values[Int(i.cast[DType.uint64]())]))
            i = (i + Int32(1))
        elapsed = (elapsed + duration)
        remaining = (remaining - duration)
        within_hour = Float64(0.0)
        index = (index + UInt64(1))
    if ((not (elapsed > Float64(0.0))) or (remaining > tolerance)):
        return Str.new_(rt_lit("Hourly meteorology interval has incomplete coverage."))
    var v__r1: Ary[Float64] = sum
    var v__i2: Int64 = Int64(0)
    var v__i2_n: Int64 = Int32(v__r1.n).cast[DType.int64]()
    while (v__i2 < v__i2_n):
        var v: P[Float64] = v__r1.ptr(Int(v__i2))
        v[] = (v[] / elapsed)
        v__i2 = (v__i2 + Int64(1))
    Arr.Assign[Float64](result, sum)
    return Str.new_()

