        di = depth
        P_ = (Float64(2.0) * (Lg + Wg))
    else:
        if (depth <= (Wg * g[].sw)):
            Wg = (depth / g[].sw)
        di = (depth - ((Wg / Float64(2.0)) * g[].sw))
        P_ = (Lg + (Float64(2.0) * Wg))
    var Ao: Float64 = ((Lg * Wg) * F_inlet__grateOpenRatio_Inlet(d))
