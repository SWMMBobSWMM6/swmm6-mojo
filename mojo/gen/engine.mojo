                xs[].y_bot = links[].xsect_y_bot[].a[Int(uj)]
                xs[].a_bot = links[].xsect_a_bot[].a[Int(uj)]
                xs[].s_bot = links[].xsect_s_bot[].a[Int(uj)]
                xs[].r_bot = links[].xsect_r_bot[].a[Int(uj)]
                if (((batch_shape == Int32(22)) or (batch_shape == Int32(23))) or (batch_shape == Int32(25))):
                    var ci: Int32 = links[].xsect_curve[].a[Int(uj)]
                    if ((ci >= Int32(0)) and (ci.cast[DType.uint64]() < ctx[].transect_tables[].size())):
                        var td: Ref[T_transect_TransectData] = ctx[].transect_tables[].a[Int(ci.cast[DType.uint64]())]
                        xs[].transect = ci
                        xs[].area_tbl = Ptr[Float64](td[].area_tbl, Int(Int64(0)))
                        xs[].hrad_tbl = Ptr[Float64](td[].hrad_tbl, Int(Int64(0)))
                        xs[].width_tbl = Ptr[Float64](td[].width_tbl, Int(Int64(0)))
                        xs[].area_lut = td[].area_lut
                        xs[].transect_tbl_size = gs()[].G_F_transect__N_TRANSECT_TBL
                if wantEvap:
                    var top_width: Float64 = Float64(0.0)
                    if ((batch_shape == Int32(22)) or (batch_shape == Int32(23))):
                        top_width = ((xs[].w_max * M.min_((depth / xs[].y_full), Float64(1.0))) if (xs[].y_full > Float64(0.0)) else Float64(0.0))
                    else:
                        top_width = F_xsect__getWofY(xs, depth)
                    evap_loss = ((top_width * length) * evap_rate)
                if wantSeep:
                    var d_seep: Float64 = depth
                    var width: Float64 = Float64(0.0)
                    if (batch_shape == Int32(3)):
                        width = xs[].w_max
                    else:
                        if (d_seep >= xs[].yw_max):
                            d_seep = xs[].yw_max
                        width = F_xsect__getWofY(xs, d_seep)
                    seep_loss[] = ((k_seep * width) * length)
                    seep_loss[] = (seep_loss[] * ctx[].climate_state[].infil_factor)
                    if gw_two_way:
                        seep_loss[] = (seep_loss[] * F_hydraulics__aquiferSeepFactor(depth, CD[].gw_head_rel[].a[Int(ucr)], CD[].gw_dc[].a[Int(ucr)]))
                        seep_loss[] = F_hydraulics__capAquiferGain(seep_loss[], CD[].gw_gain_max[].a[Int(ucr)])
            var total: Float64 = (evap_loss + M.max_(seep_loss[], Float64(0.0)))
            if ((total > Float64(0.0)) and ((this[].model_ == T_RouteModel__DYNWAVE) or (this[].model_ == T_RouteModel__FV))):
                var q_avail: Float64 = (links[].volume[].a[Int(uj)] / (dt * CD[].barrels[].a[Int(ucr)].cast[DType.float64]()))
                if ((total > q_avail) and (q_avail >= Float64(0.0))):
                    var ratio: Float64 = (q_avail / total)
                    evap_loss = (evap_loss * ratio)
                    if (seep_loss[] > Float64(0.0)):
                        seep_loss[] = (seep_loss[] * ratio)
        F_hydraulics__applySeepageForcing(ctx, uj, seep_loss)
        CD[].evap_loss_rate[].a[Int(ucr)] = evap_loss
        CD[].seep_loss_rate[].a[Int(ucr)] = seep_loss[]
        j = (j + Int32(1))
    rt_set_sp(__sp)

def T_Router__refreshFvBoundaryFlows(this: Ref[T_Router], var ctx: Ref[T_SimulationContext], var t_elapsed: Float64, var eval_structures: Dlg) raises:
    var impl: Ref[T_fv_ExplicitFvSolver] = this[].fv_solver_.cast[T_fv_ExplicitFvSolver]()
    if (not (rt_box(impl) != Obj())):
        return
    T_Router__accumulateStructureFlows(this, ctx, t_elapsed)
    var nn: Int32 = T_SimulationContext__n_nodes(ctx)
    var n: Int32 = Int32(0)
    while (n < nn):
        var un: UInt64 = n.cast[DType.uint64]()
        if (this[].fv_mesh_[].node_kind[].a[Int(un)].cast[DType.int32]() == Int32(1)):
            n = (n + Int32(1))
            continue
        var depth: Float64 = (this[].fv_state_[].node_head[].a[Int(un)] - this[].fv_mesh_[].node_invert[].a[Int(un)])
        ctx[].nodes[].depth[].a[Int(un)] = M.max_(Float64(0.0), depth)
        ctx[].nodes[].head[].a[Int(un)] = this[].fv_state_[].node_head[].a[Int(un)]
        n = (n + Int32(1))
    F_outfall__setAllOutfallDepths(ctx, t_elapsed)
    var n_2: Int32 = Int32(0)
    while (n_2 < nn):
        var un_2: UInt64 = n_2.cast[DType.uint64]()
        if (ctx[].nodes[].type_[].a[Int(un_2)] != T_NodeType__OUTFALL):
            n_2 = (n_2 + Int32(1))
            continue
        this[].fv_fixed_head_[].a[Int(un_2)] = (ctx[].nodes[].invert_elev[].a[Int(un_2)] + ctx[].nodes[].depth[].a[Int(un_2)])
        n_2 = (n_2 + Int32(1))
    __call1(eval_structures)

def T_Router__accumulateStructureFlows(this: Ref[T_Router], var ctx: Ref[T_SimulationContext], var t_now: Float64) raises:
    var span: Float64 = (t_now - this[].fv_struct_t_prev_)
    if (span <= Float64(0.0)):
