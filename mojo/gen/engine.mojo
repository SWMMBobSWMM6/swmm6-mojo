    if (ni == Int32(0)):
        return
    var links: Ref[T_LinkData] = ctx[].links
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var nn: Int32 = T_SimulationContext__n_nodes(ctx)
    var nl: Int32 = T_SimulationContext__n_links(ctx)
    var is_dw: Bool = (ctx[].options[].routing_model == T_RoutingModel__DYNWAVE)
