    if (x >= Ptr[Float64](table[Int((n - Int32(1)))], Int(Int64(0)))[Int(Int32(0))]):
        return Ptr[Float64](table[Int((n - Int32(1)))], Int(Int64(0)))[Int(Int32(1))]
    var i: Int32 = Int32(1)
    while (i < n):
        if (x <= Ptr[Float64](table[Int(i)], Int(Int64(0)))[Int(Int32(0))]):
            var x1: Float64 = Ptr[Float64](table[Int((i - Int32(1)))], Int(Int64(0)))[Int(Int32(0))]
            var dx: Float64 = (Ptr[Float64](table[Int(i)], Int(Int64(0)))[Int(Int32(0))] - x1)
            var y1: Float64 = Ptr[Float64](table[Int((i - Int32(1)))], Int(Int64(0)))[Int(Int32(1))]
            var dy: Float64 = (Ptr[Float64](table[Int(i)], Int(Int64(0)))[Int(Int32(1))] - y1)
            return (y1 + (((x - x1) * dy) / dx))
        i = (i + Int32(1))
    return Ptr[Float64](table[Int((n - Int32(1)))], Int(Int64(0)))[Int(Int32(1))]

def F_roadway__getCd_Roadway(var hWr: Float64, var ht: Float64, var roadWidth: Float64, var roadSurf: Int32) raises -> Float64:
    var kT: Float64 = Float64(1.0)
    var cR: Float64 = Float64(0.0)
    if (hWr <= Float64(0.0)):
