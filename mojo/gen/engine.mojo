                this[].aa_skip_[].a[Int(links[].node1[].a[Int(uj_3)].cast[DType.uint64]())] = UInt8(1)
                this[].aa_skip_[].a[Int(links[].node2[].a[Int(uj_3)].cast[DType.uint64]())] = UInt8(1)
            ci_3 = (ci_3 + Int32(1))
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var j_3: Int32 = Int32(0)
    while (j_3 < this[].n_links_):
