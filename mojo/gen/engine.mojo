    if (Eo < Float64(1.0)):
        Rs = (Float64(1.0) / (Float64(1.0) + (((Float64(0.15) * Math.Pow(V, Float64(1.8))) / g[].sx) / Math.Pow(Lg, Float64(2.3)))))
    return (Q * ((Rf * Eo) + (Rs * (Float64(1.0) - Eo))))

def F_inlet__getCurbInletCapture(var g: Ref[T_inlet_Geom], var Q: Float64, var L: Float64) raises -> Float64:
    var Se: Float64 = g[].sx
    var E: Float64 = Float64(1.0)
    if (g[].a > Float64(0.0)):
        var Sr: Float64 = (g[].sw / g[].sx)
        var Eo: Float64 = F_inlet__getEo(Sr, (g[].t - g[].w), g[].w)
        Se = (g[].sx + ((g[].a / g[].w) * Eo))
