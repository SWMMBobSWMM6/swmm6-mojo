def T_dynwave_DWSolver__getLinkStep(this: Ref[T_dynwave_DWSolver], var ctx: Ref[T_SimulationContext], var link_idx: Int32) raises -> Float64:
    var uj: UInt64 = link_idx.cast[DType.uint64]()
    if (ctx[].links[].type_[].a[Int(uj)] != T_LinkType__CONDUIT):
        return Float64(10000000000.0)
    var CD: Ref[T_ConduitData] = ctx[].link_subtypes[].conduits
    var ucr: UInt64 = T_LinkSubtypes__conduit_row(ctx[].link_subtypes, link_idx).cast[DType.uint64]()
    var barrels: Int32 = M.max_(CD[].barrels[].a[Int(ucr)], Int32(1))
    var q: Float64 = (Math.Abs(ctx[].links[].flow[].a[Int(uj)]) / barrels.cast[DType.float64]())
    if (q <= gs()[].G_F_constants__FUDGE):
        return Float64(10000000000.0)
    var a: Float64 = this[].area_mid_[].a[Int(uj)]
    if (a <= gs()[].G_F_constants__FUDGE):
        return Float64(10000000000.0)
    var L: Float64 = CD[].true_length[].a[Int(ucr)]
    if (L <= Float64(0.0)):
        L = CD[].length[].a[Int(ucr)]
    var modL: Float64 = CD[].mod_length[].a[Int(ucr)]
    var Lscale: Float64 = ((modL / L) if ((L > Float64(0.0)) and (modL > Float64(0.0))) else Float64(1.0))
    if (((this[].surcharge_method == T_dynwave_SurchargeMethod__DYNAMIC_SLOT) and (link_idx >= Int32(0))) and (link_idx.cast[DType.uint64]() < this[].tile_uj_to_ci_[].size())):
        var ci: Int32 = this[].tile_uj_to_ci_[].a[Int(uj)]
        if (ci >= Int32(0)):
            var uci: UInt64 = ci.cast[DType.uint64]()
            if ((this[].dps_[].surcharged[].a[Int(uci)].cast[DType.int32]() != Int32(0)) and (L > Float64(0.0))):
                var v: Float64 = (q / F_dynwave__conveyArea_DynamicWave(a, ctx[].links[].xsect_a_full[].a[Int(uj)]))
                var P_: Float64 = M.max_(this[].dps_[].P_[].a[Int(uci)], Float64(1.0))
                var c_p: Float64 = (this[].dps_config_[].c_pT / P_)
                var denom: Float64 = (Math.Abs(v) + c_p)
                if (denom > Float64(0.0)):
                    return ((L * Lscale) / denom)
    var fr: Float64 = this[].froude_[].a[Int(uj)]
    if (fr <= Float64(0.01)):
        return Float64(10000000000.0)
    var vol: Float64 = (ctx[].links[].volume[].a[Int(uj)] / barrels.cast[DType.float64]())
    var t: Float64 = (vol / q)
    if ((L > Float64(0.0)) and (modL > Float64(0.0))):
