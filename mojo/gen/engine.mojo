def T_SpatialFrame__shrink_to_fit(this: Ref[T_SpatialFrame]) raises:
    this[].node_x[].shrink_to_fit()
    this[].node_y[].shrink_to_fit()
    this[].link_x[].shrink_to_fit()
    this[].link_y[].shrink_to_fit()
    this[].subcatch_x[].shrink_to_fit()
    this[].subcatch_y[].shrink_to_fit()
    this[].gage_x[].shrink_to_fit()
    this[].gage_y[].shrink_to_fit()
    this[].link_vertices_x[].shrink_to_fit()
    var v__r1: Ref[Vec[Ref[Vec[Float64]]]] = this[].link_vertices_x
    var v__i2: Int64 = Int64(0)
    var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
    while (v__i2 < v__i2_n):
        var v: Ref[Vec[Float64]] = v__r1[].a[Int(v__i2)]
        v[].shrink_to_fit()
        v__i2 = (v__i2 + Int64(1))
    this[].link_vertices_y[].shrink_to_fit()
    var v__r3: Ref[Vec[Ref[Vec[Float64]]]] = this[].link_vertices_y
    var v__i4: Int64 = Int64(0)
    var v__i4_n: Int64 = v__r3[].n.cast[DType.int64]()
    while (v__i4 < v__i4_n):
        var v_2: Ref[Vec[Float64]] = v__r3[].a[Int(v__i4)]
        v_2[].shrink_to_fit()
