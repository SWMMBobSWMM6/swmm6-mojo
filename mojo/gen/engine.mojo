def T_quality_QualitySolver__raw() raises -> Ref[T_quality_QualitySolver]:
    var o = Ref[T_quality_QualitySolver](gc_new[T_quality_QualitySolver]())
    return o

def T_quality_QualitySolver__init(this: Ref[T_quality_QualitySolver], var n_nodes: Int32, var n_links: Int32, var n_pollutants: Int32) raises:
