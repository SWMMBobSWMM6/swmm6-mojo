def F_input__ensure_spatial_capacity_NodesHandler(var ctx: Ref[T_SimulationContext], var n_nodes: Int32) raises:
    var un: UInt64 = n_nodes.cast[DType.uint64]()
    if (ctx[].spatial[].node_x[].size() < un):
        ctx[].spatial[].node_x[].resize(un, Float64(0.0))
    if (ctx[].spatial[].node_y[].size() < un):
        ctx[].spatial[].node_y[].resize(un, Float64(0.0))

