def __lam142(__ctx: VP, var mode_vec: Ref[Vec[T_ForcingMode]], var persist_vec: Ref[Vec[T_ForcingPersist]]) raises:
    var i: UInt64 = UInt64(0)
    while (i < mode_vec[].size()):
        if (persist_vec[].a[Int(i)] == T_ForcingPersist__RESET):
            mode_vec[].a[Int(i)] = T_ForcingMode__NONE
        i = (i + UInt64(1))
    return

def T_ForcingData__clear_reset_entries(this: Ref[T_ForcingData]) raises:
    var clear_resets: Dlg = Dlg(VP_null(), 142)
    __call102(clear_resets, this[].node_lat_inflow_mode, this[].node_lat_inflow_persist)
    __call102(clear_resets, this[].node_head_boundary_mode, this[].node_head_boundary_persist)
    __call102(clear_resets, this[].node_quality_mode, this[].node_quality_persist)
    __call102(clear_resets, this[].node_temperature_mode, this[].node_temperature_persist)
    __call102(clear_resets, this[].node_age_mode, this[].node_age_persist)
    __call102(clear_resets, this[].link_flow_mode, this[].link_flow_persist)
    __call102(clear_resets, this[].link_setting_mode, this[].link_setting_persist)
    __call102(clear_resets, this[].link_seepage_mode, this[].link_seepage_persist)
    __call102(clear_resets, this[].link_quality_mode, this[].link_quality_persist)
    __call102(clear_resets, this[].subcatch_rainfall_mode, this[].subcatch_rainfall_persist)
    __call102(clear_resets, this[].subcatch_evap_mode, this[].subcatch_evap_persist)
    __call102(clear_resets, this[].subcatch_snowfall_mode, this[].subcatch_snowfall_persist)
    __call102(clear_resets, this[].gage_rainfall_mode, this[].gage_rainfall_persist)
    if (this[].climate_temperature_persist == T_ForcingPersist__RESET):
        this[].climate_temperature_mode = T_ForcingMode__NONE
    if (this[].climate_wind_persist == T_ForcingPersist__RESET):
        this[].climate_wind_mode = T_ForcingMode__NONE
    if (this[].climate_evap_persist == T_ForcingPersist__RESET):
        this[].climate_evap_mode = T_ForcingMode__NONE
    var k: Int32 = Int32(0)
    while (k < Int32(2)):
        T_ForcingData_ElemClimateChannel__resetPerStep(Ptr[Ref[T_ForcingData_ElemClimateChannel]](this[].elem_air_temp, Int(Int64(0)))[Int(k)])
        T_ForcingData_ElemClimateChannel__resetPerStep(Ptr[Ref[T_ForcingData_ElemClimateChannel]](this[].elem_humidity, Int(Int64(0)))[Int(k)])
        T_ForcingData_ElemClimateChannel__resetPerStep(Ptr[Ref[T_ForcingData_ElemClimateChannel]](this[].elem_wind, Int(Int64(0)))[Int(k)])
        T_ForcingData_ElemClimateChannel__resetPerStep(Ptr[Ref[T_ForcingData_ElemClimateChannel]](this[].elem_shortwave, Int(Int64(0)))[Int(k)])
        k = (k + Int32(1))

def T_ForcingData__effective_temperature(this: Ref[T_ForcingData], var broadcast: Float64) raises -> Float64:
    var __sv1 = this[].climate_temperature_mode
    if __sv1 == T_ForcingMode__OVERRIDE:
        return this[].climate_temperature_value
    elif __sv1 == T_ForcingMode__ADD:
        return (broadcast + this[].climate_temperature_value)
