            var dhMax: Float64 = divs[].max_depth[].a[Int(ur)]
            var cWeir: Float64 = divs[].cd[].a[Int(ur)]
            var qMax: Float64 = ((cWeir * Math.Pow(dhMax, Float64(1.5))) / ucf_flow)
            if (qIn <= qMin):
                qOut = Float64(0.0)
            else:
                var f: Float64 = ((qIn - qMin) / (qMax - qMin))
                if (f > Float64(1.0)):
                    qOut = (qMax * Math.Sqrt(f))
                else:
                    qOut = ((cWeir * Math.Pow((f * dhMax), Float64(1.5))) / ucf_flow)
            break
        elif __sv1 == T_divider_DividerMethod__TABULAR:
            var m: Int32 = divs[].curve[].a[Int(ur)]
            if ((m >= Int32(0)) and (m < ctx[].tables[].tables[].size().cast[DType.int32]())):
