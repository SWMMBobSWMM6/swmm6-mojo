def F_roadway__getY_Roadway(var x: Float64, var table: Ptr[Ary[Float64]], var n: Int32) raises -> Float64:
    if (x <= Ptr[Float64](table[Int(Int32(0))], Int(Int64(0)))[Int(Int32(0))]):
