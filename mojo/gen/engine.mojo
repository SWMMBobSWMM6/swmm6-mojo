    if is_inlet_node:
        nodes[].volume[].a[Int(ui)] = Float64(0.0)
    if (dt > Float64(0.0)):
        this[].xnode_[].dYdT[].a[Int(ui)] = (Math.Abs((y_new - nodes[].old_depth[].a[Int(ui)])) / dt)
