def T_SWMMEngine__ensureXspCache(this: Ref[T_SWMMEngine]) raises:
    var n: UInt64 = T_SimulationContext__n_links(this[].ctx_).cast[DType.uint64]()
    if ((this[].xsp_cache_[].size() == n) and (this[].xsp_cache_gen_ == this[].ctx_[].xsect_generation)):
        return
    this[].xsp_cache_[].resize(n)
    var uj: UInt64 = UInt64(0)
