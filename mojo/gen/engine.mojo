def F_inlet__getEo(var Sr: Float64, var Ts: Float64, var w: Float64) raises -> Float64:
    var x: Float64 = (Sr / (Ts / w))
    x = (Math.Pow((Float64(1.0) + x), Float64(2.67)) - Float64(1.0))
    x = (Float64(1.0) + (Sr / x))
    return (Float64(1.0) / x)

def F_inlet__getFlowSpread(var g: Ref[T_inlet_Geom], var Q: Float64) raises -> Float64:
    var f: Float64 = g[].qfactor
    var Ts1: Float64 = Float64(0.0)
    if (g[].a == Float64(0.0)):
        Ts1 = Math.Pow((Q / f), Float64(0.375))
    else:
        var f1: Float64 = (f * Math.Pow(((g[].a / g[].w) / g[].sx), Float64(1.67)))
        var Tw: Float64 = Math.Pow((Q / f1), Float64(0.375))
        if (Tw <= g[].w):
            Ts1 = Tw
        else:
            var Sr: Float64 = ((g[].sx + (g[].a / g[].w)) / g[].sx)
            var iter_: Int32 = Int32(1)
            var Ts2: Float64 = Float64(0.0)
            Ts1 = (Math.Pow((Q / f), Float64(0.375)) - g[].w)
            if (Ts1 <= Float64(0.0)):
                Ts1 = (Tw - g[].w)
            while (iter_ < Int32(11)):
