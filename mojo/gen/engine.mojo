def F_divider__getOutflow(var ctx: Ref[T_SimulationContext], var node_idx: Int32, var link_idx: Int32) raises -> Float64:
    var r: Int32 = T_NodeSubtypes__divider_row(ctx[].node_subtypes, node_idx)
    if (r < Int32(0)):
        return Float64(0.0)
    var ur: UInt64 = r.cast[DType.uint64]()
    var divs: Ref[T_DividerData] = ctx[].node_subtypes[].dividers
    var un: UInt64 = node_idx.cast[DType.uint64]()
    var ucf_flow: Float64 = Ptr[Float64](gs()[].G_F_ucf__Qcf_UnitConversion, Int(Int64(0)))[Int(ctx[].options[].flow_units)]
    var qIn: Float64 = (ctx[].nodes[].inflow[].a[Int(un)] + ctx[].nodes[].overflow[].a[Int(un)])
    var div_link: Int32 = divs[].link[].a[Int(ur)]
    var qOut: Float64 = Float64(0.0)
    var __sv1 = divs[].method[].a[Int(ur)].cast[DType.int32]()
    while True:
        if __sv1 == T_divider_DividerMethod__CUTOFF:
            if (qIn <= divs[].cutoff[].a[Int(ur)]):
                qOut = Float64(0.0)
            else:
                qOut = (qIn - divs[].cutoff[].a[Int(ur)])
            break
        elif __sv1 == T_divider_DividerMethod__OVERFLOW_DIV:
            if (link_idx != div_link):
                qOut = qIn
            else:
