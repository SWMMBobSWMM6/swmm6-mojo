def T_Router__executeSteadyFlow(this: Ref[T_Router], var ctx: Ref[T_SimulationContext], var dt: Float64) raises -> Int32:
    var __h_ctx1 = rt_cell[Ref[T_SimulationContext]](ctx)
    var links: Ref[T_LinkData] = __h_ctx1[][].links
    var nodes: Ref[T_NodeData] = __h_ctx1[][].nodes
    var order: Ref[Vec[Int32]] = (__call131(Dlg(__mk221(__h_ctx1), 222)) if this[].steady_sorted_links_[].empty() else this[].steady_sorted_links_)
    this[].steady_storage_updated_[].assign(T_SimulationContext__n_nodes(__h_ctx1[]).cast[DType.uint64](), Int8(0))
    this[].steady_y_[].assign(T_SimulationContext__n_links(__h_ctx1[]).cast[DType.uint64](), Float64(0.0))
    var idx: Int32 = Int32(0)
    while (idx < order[].size().cast[DType.int32]()):
        var j_2: Int32 = order[].a[Int(idx.cast[DType.uint64]())]
        var uj: UInt64 = j_2.cast[DType.uint64]()
        var n1s: Int32 = links[].node1[].a[Int(uj)]
        if (((n1s >= Int32(0)) and (nodes[].type_[].a[Int(n1s.cast[DType.uint64]())] == T_NodeType__STORAGE)) and (not (this[].steady_storage_updated_[].a[Int(n1s.cast[DType.uint64]())].cast[DType.int32]() != Int32(0)))):
            F_kinwave__updateStorageState(__h_ctx1[], this[].structures_, order, idx, n1s, dt)
            this[].steady_storage_updated_[].a[Int(n1s.cast[DType.uint64]())] = Int8(1)
        if (links[].type_[].a[Int(uj)] != T_LinkType__CONDUIT):
            var n1: Int32 = links[].node1[].a[Int(uj)]
            var n2: Int32 = links[].node2[].a[Int(uj)]
            var q: Float64 = F_kinwave__getLinkInflow(__h_ctx1[], this[].structures_, j_2, dt)
            links[].flow[].a[Int(uj)] = q
            if (n1 >= Int32(0)):
                var __cp2 = rt_addr(nodes[].outflow[].a[Int(n1.cast[DType.uint64]())])
                __cp2[] = (__cp2[] + q)
            if (n2 >= Int32(0)):
                var __cp3 = rt_addr(nodes[].inflow[].a[Int(n2.cast[DType.uint64]())])
                __cp3[] = (__cp3[] + q)
            idx = (idx + Int32(1))
            continue
        var CD: Ref[T_ConduitData] = __h_ctx1[][].link_subtypes[].conduits
        var ucr: UInt64 = T_LinkSubtypes__conduit_row(__h_ctx1[][].link_subtypes, j_2).cast[DType.uint64]()
        if (links[].xsect_shape[].a[Int(uj)] == T_XsectShape__DUMMY):
            var n1_2: Int32 = links[].node1[].a[Int(uj)]
            var n2_2: Int32 = links[].node2[].a[Int(uj)]
            var q_2: Float64 = F_kinwave__getLinkInflow(__h_ctx1[], this[].structures_, j_2, dt)
            links[].flow[].a[Int(uj)] = q_2
            if (n1_2 >= Int32(0)):
                var __cp4 = rt_addr(nodes[].outflow[].a[Int(n1_2.cast[DType.uint64]())])
                __cp4[] = (__cp4[] + q_2)
            if (n2_2 >= Int32(0)):
                var __cp5 = rt_addr(nodes[].inflow[].a[Int(n2_2.cast[DType.uint64]())])
                __cp5[] = (__cp5[] + q_2)
            links[].depth[].a[Int(uj)] = Float64(0.0)
            links[].volume[].a[Int(uj)] = Float64(0.0)
            idx = (idx + Int32(1))
            continue
        var n1_3: Int32 = links[].node1[].a[Int(uj)]
        var qin: Float64 = Float64(0.0)
        if (n1_3 >= Int32(0)):
            qin = F_kinwave__getLinkInflow(__h_ctx1[], this[].structures_, j_2, dt)
        var barrels: Float64 = M.max_(CD[].barrels[].a[Int(ucr)], Int32(1)).cast[DType.float64]()
        var q_3: Float64 = (qin / barrels)
        var loss_rate: Float64 = F_kinwave__capConduitLoss(__h_ctx1[], ucr, Math.Abs(q_3))
        q_3 = (q_3 - loss_rate)
        if (q_3 < Float64(0.0)):
            q_3 = Float64(0.0)
        var xs: Ref[T_XSectParams] = F___buildXSP_Routing(__h_ctx1[], uj)
        var q_full: Float64 = CD[].q_full[].a[Int(ucr)]
        var a_full: Float64 = links[].xsect_a_full[].a[Int(uj)]
        var a: Float64 = Float64(0.0)
        if (q_3 >= q_full):
            q_3 = q_full
            a = a_full
            qin = (q_3 * barrels)
        else:
            var beta: Float64 = CD[].beta[].a[Int(ucr)]
            if (beta > Float64(0.0)):
                var s: Float64 = (q_3 / beta)
                a = F_xsect__getAofS(xs, s)
            else:
                a = Float64(0.0)
        var qout: Float64 = (q_3 * barrels)
        links[].flow[].a[Int(uj)] = qout
        if (n1_3 >= Int32(0)):
            var __cp6 = rt_addr(nodes[].outflow[].a[Int(n1_3.cast[DType.uint64]())])
            __cp6[] = (__cp6[] + qin)
        var n2_3: Int32 = links[].node2[].a[Int(uj)]
        if (n2_3 >= Int32(0)):
            var __cp7 = rt_addr(nodes[].inflow[].a[Int(n2_3.cast[DType.uint64]())])
            __cp7[] = (__cp7[] + qout)
        var y: Float64 = F_xsect__getYofA(xs, a)
        var length: Float64 = CD[].true_length[].a[Int(ucr)]
        if (length <= Float64(0.0)):
            length = CD[].length[].a[Int(ucr)]
        links[].depth[].a[Int(uj)] = y
        links[].volume[].a[Int(uj)] = ((a * length) * barrels)
        this[].steady_y_[].a[Int(uj)] = y
        CD[].full_state[].a[Int(ucr)] = (Int8(3) if ((a_full > Float64(0.0)) and (a >= a_full)) else Int8(0))
        idx = (idx + Int32(1))
    F_kinwave__finishRouting(__h_ctx1[], this[].structures_, order, this[].steady_storage_updated_, this[].steady_y_, this[].steady_y_, dt)
