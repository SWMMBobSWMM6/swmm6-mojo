def T_BedZoneState__resizeCells(this: Ref[T_BedZoneState], var n_cells: Int32, var n_spec: Int32, var t_init: Float64) raises:
    var nc: UInt64 = (n_cells if (n_cells > Int32(0)) else Int32(0)).cast[DType.uint64]()
    var ns: UInt64 = (n_spec if (n_spec > Int32(0)) else Int32(0)).cast[DType.uint64]()
    this[].cell_n_species = ns.cast[DType.int32]()
    this[].cell_temp[].assign(nc, t_init)
    this[].cell_conc[].assign((ns * nc), Float64(0.0))
    this[].cells_seeded = True

def T_BedZoneState__sized(this: Ref[T_BedZoneState], var n_links: Int32) raises -> Bool:
    return (this[].link_temp[].size() == (n_links if (n_links > Int32(0)) else Int32(0)).cast[DType.uint64]())

