    var j_2: Int32 = Int32(0)
    while (j_2 < n_links):
        var uj_2: UInt64 = j_2.cast[DType.uint64]()
        var n: Int32 = (links[].node2[].a[Int(uj_2)] if (links[].direction[].a[Int(uj_2)] < Int32(0)) else links[].node1[].a[Int(uj_2)])
        if ((n < Int32(0)) or (n >= n_nodes[])):
