def T_surface_InfilBank__evaluate(this: Ref[T_surface_InfilBank], var i: Int32, var precip: Float64, var runon: Float64, var depth: Float64, var dt: Float64, var factors: Ref[T_surface_InfilBank_Factors]) raises -> Float64:
    var ui: UInt64 = i.cast[DType.uint64]()
    var infil: Float64 = Float64(0.0)
    var im: T_InfilModel = this[].methods_[].a[Int(ui)]
    var __sv1 = im
    while True:
        if __sv1 == T_InfilModel__HORTON or __sv1 == T_InfilModel__MOD_HORTON:
            var hs: Ref[T_HortonState] = this[].horton_[].a[Int(ui)]
            var save_f0: Float64 = hs[].f0
            var save_fmin: Float64 = hs[].fmin
            var save_regen: Float64 = hs[].regen
            hs[].f0 = (hs[].f0 * factors[].infiltration)
            hs[].fmin = (hs[].fmin * factors[].infiltration)
            hs[].regen = (hs[].regen * factors[].recovery)
            infil = (F_infil__horton_getInfil(hs, (precip + runon), depth, dt) if (im == T_InfilModel__HORTON) else F_infil__modHorton_getInfil(hs, (precip + runon), depth, dt))
            hs[].f0 = save_f0
            hs[].fmin = save_fmin
            hs[].regen = save_regen
            break
        elif __sv1 == T_InfilModel__GREEN_AMPT or __sv1 == T_InfilModel__MOD_GREEN_AMPT:
            infil = F_infil__grnampt_getInfil(this[].grnampt_[].a[Int(ui)], (precip + runon), depth, dt, im, factors[].infiltration, factors[].recovery)
            break
        elif __sv1 == T_InfilModel__CURVE_NUM:
            var cs: Ref[T_CurveNumState] = this[].curvenum_[].a[Int(ui)]
            var cn_depth: Float64 = (depth + (runon * dt))
            infil = F_infil__curvenum_getInfil(cs, precip, cn_depth, dt, factors[].recovery)
            break
        elif __sv1 == T_InfilModel__CONSTANT:
            infil = F_infil__constant_getInfil((this[].constant_[].a[Int(ui)] * factors[].infiltration), (precip + runon), depth, dt)
            break
        break
    return infil

