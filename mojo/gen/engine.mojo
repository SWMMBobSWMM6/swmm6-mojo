    rx[].warned_negative_clamp = True
    ctx[].warnings[].push_back(Str.Cat(Str.Cat(Str.new_(rt_lit("Reaction step produced a negative concentration at ")), where), rt_lit("; it was set to zero (mass added). The explicit solver is too coarse for these kinetics: use [REACTION_OPTIONS] SOLVER ROS2, COUPLING FULL or a shorter step.")))

def F_transport__clampRateSpecies(var rx: Ref[T_ReactionData], var tank: Bool, var block: Ptr[Float64], var added: Ptr[Float64]) raises -> Float64:
    var forms: Ref[Vec[T_ReactionExprForm]] = (rx[].tank_form if tank else rx[].pipe_form)
    var total: Float64 = Float64(0.0)
    var ns: Int32 = T_ReactionData__n_species(rx)
    var s: Int32 = Int32(0)
    while (s < ns):
        var us: UInt64 = s.cast[DType.uint64]()
        var a: Float64 = Float64(0.0)
        if (((us < forms[].size()) and (forms[].a[Int(us)] == T_ReactionExprForm__RATE)) and (block[Int(s)] < Float64(0.0))):
            a = (-block[Int(s)])
            block[Int(s)] = Float64(0.0)
        if (not added.isnull()):
            added[Int(s)] = a
        total = (total + a)
        s = (s + Int32(1))
    return total

