    var Qorif: Float64 = F_inlet__getCurbOrificeFlow(dorif, h, L, throat)
    var r: Float64 = ((depth - dweir) / (dorif - dweir))
    Qw[0] = ((Float64(1.0) - r) * Qweir)
    Qo[0] = (r * Qorif)

def F_inlet__getCurbOrificeFlow(var di: Float64, var h: Float64, var L: Float64, var throat_angle: Int32) raises -> Float64:
    var d: Float64 = di
    if (throat_angle == Int32(0)):
        d = (di - (h / Float64(2.0)))
    elif (throat_angle == Int32(1)):
        d = (di - ((h / Float64(2.0)) * Float64(0.7071)))
    return (((Float64(0.67) * h) * L) * Math.Sqrt((Float64(64.32) * d)))

def F_inlet__getOnSagSlottedFlow(var d: Ref[T_inlet_Design], var depth: Float64) raises -> Float64:
