def T_dynwave_DWSolver__updateNodeDepthsTeam(this: Ref[T_dynwave_DWSolver], var ctx: Ref[T_SimulationContext], var dt: Float64, var step: Int32, unconv_shared: P[Int32]) raises:
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var use_anderson: Bool = this[].anderson_accel
    var local_unconv: Int32 = Int32(0)
    var i: Int32 = Int32(0)
    while (i < this[].n_nodes_):
        var ui: UInt64 = i.cast[DType.uint64]()
        if (this[].node_tile_[].a[Int(ui)][].is_outfall.cast[DType.int32]() != Int32(0)):
            this[].xnode_[].converged[].a[Int(ui)] = UInt8(0)
