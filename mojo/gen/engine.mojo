                var buf: CPtr = R.Buf(Int32(256))
                _ = R.snprintf(buf, UInt64(256), rt_lit("THREADS = %d reduced to %d for dynamic wave: the model has only %d conduits (%d per thread minimum)."), A(requested), A(cap), A(n_conduits), A(gs()[].G_F_threadinfo__kMinConduitsPerThread))
                _ = warnings[].emplace_back(Str.fromCPtr(buf))[]
            nt = cap
    if ((requested == Int32(0)) and (nt > Int32(1))):
        var pcores: Int32 = F_threadinfo__perfCores()
        if ((pcores > Int32(2)) and (nt > (pcores - Int32(2)))):
            nt = (pcores - Int32(2))
