                var source_2: Int32 = (links[].node1[].a[Int(uj)] if (links[].flow[].a[Int(uj)] >= Float64(0.0)) else links[].node2[].a[Int(uj)])
                if (ctx[].nodes[].type_[].a[Int(source_2.cast[DType.uint64]())] == T_NodeType__OUTFALL):
