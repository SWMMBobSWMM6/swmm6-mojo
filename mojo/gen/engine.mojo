def T_iface_InterfaceManager__readInflows(this: Ref[T_iface_InterfaceManager], var ctx: Ref[T_SimulationContext], var current_time: Float64) raises:
    if (not (rt_box(this[].infile_) != Obj())):
        return
    if this[].data_[].old_values[].empty():
        if (T_iface_InterfaceManager__readFileHeader(this, ctx) != Int32(0)):
            T_iface_InterfaceManager__closeFiles(this)
            return
    if (this[].data_[].count == Int32(0)):
        return
    if (this[].old_time_ > current_time):
        return
    while ((this[].new_time_ < current_time) and (this[].new_time_ != gs()[].G_F_iface__NO_DATE_InterfaceFile)):
        T_iface_InterfaceManager__setOldValues(this)
        _ = T_iface_InterfaceManager__readNextPeriod(this)
    if (this[].new_time_ == gs()[].G_F_iface__NO_DATE_InterfaceFile):
        return
    var dt_iface: Float64 = (this[].new_time_ - this[].old_time_)
    if (dt_iface > Float64(0.0)):
        this[].iface_frac_ = ((current_time - this[].old_time_) / dt_iface)
        this[].iface_frac_ = M.max_(Float64(0.0), M.min_(Float64(1.0), this[].iface_frac_))
    else:
        this[].iface_frac_ = Float64(0.0)
    var i: Int32 = Int32(0)
    while (i < this[].data_[].count):
        var node: Int32 = this[].data_[].node_idx[].a[Int(i.cast[DType.uint64]())]
        if ((node < Int32(0)) or (node >= T_SimulationContext__n_nodes(ctx))):
            i = (i + Int32(1))
            continue
        var flow: Float64 = T_iface_InterfaceManager__getFlow(this, i, this[].iface_frac_)
        if (Math.Abs(flow) < gs()[].G_F_constants__FLOW_TOL):
            i = (i + Int32(1))
            continue
        var __cp1 = rt_addr(ctx[].nodes[].iface_inflow[].a[Int(node.cast[DType.uint64]())])
        __cp1[] = (__cp1[] + flow)
        var n_polluts: Int32 = T_SimulationContext__n_pollutants(ctx)
        if ((((flow > Float64(0.0)) and (n_polluts > Int32(0))) and (not this[].pollut_map_[].empty())) and (not ctx[].nodes[].iface_qual_mass[].empty())):
            var base_q: UInt64 = (node.cast[DType.uint64]() * n_polluts.cast[DType.uint64]())
            var p: Int32 = Int32(0)
            while (p < n_polluts):
                var qual: Float64 = T_iface_InterfaceManager__getQuality(this, i, p, this[].iface_frac_)
                if (qual > Float64(0.0)):
                    var __cp2 = rt_addr(ctx[].nodes[].iface_qual_mass[].a[Int((base_q + p.cast[DType.uint64]()))])
                    __cp2[] = (__cp2[] + (flow * qual))
                p = (p + Int32(1))
        i = (i + Int32(1))

def T_iface_InterfaceManager__writeOutfallResults(this: Ref[T_iface_InterfaceManager], var ctx: Ref[T_SimulationContext], var current_time: Float64) raises:
    var __sp = rt_sp()
    var yr = rt_salloc[Int32]()
    var mon = rt_salloc[Int32]()
    var day = rt_salloc[Int32]()
    var hr = rt_salloc[Int32]()
    var mn = rt_salloc[Int32]()
    var sec = rt_salloc[Int32]()
    if (not (rt_box(this[].outfile_) != Obj())):
        rt_set_sp(__sp)
        return
    yr[] = Int32(0)
    mon[] = Int32(0)
    day[] = Int32(0)
    hr[] = Int32(0)
    mn[] = Int32(0)
    sec[] = Int32(0)
    F_datetime__decodeDate(current_time, yr, mon, day)
    F_datetime__decodeTime(current_time, hr, mn, sec)
    var i: Int32 = Int32(0)
    while (i < T_SimulationContext__n_nodes(ctx)):
        var ui: UInt64 = i.cast[DType.uint64]()
        if (not T_iface_InterfaceManager__isOutletNode(ctx, i)):
            i = (i + Int32(1))
            continue
        var name: Ref[Str] = T_NameIndex__names(ctx[].node_names)[].a[Int(ui)]
        _ = R.fprintf(this[].outfile_, rt_lit("\n%-16s"), A(name[].c_str()))
        _ = R.fprintf(this[].outfile_, rt_lit(" %04d %02d  %02d  %02d  %02d  %02d "), A(yr[]), A(mon[]), A(day[]), A(hr[]), A(mn[]), A(sec[]))
        var fu: Int32 = ctx[].options[].flow_units
        if ((fu < Int32(0)) or (fu > Int32(5))):
            fu = Int32(0)
        _ = R.fprintf(this[].outfile_, rt_lit(" %-10f"), A((ctx[].nodes[].inflow[].a[Int(ui)] * Ptr[Float64](gs()[].G_F_ucf__Qcf_UnitConversion, Int(Int64(0)))[Int(fu)])))
        var np: Int32 = T_SimulationContext__n_pollutants(ctx)
        var p: Int32 = Int32(0)
        while (p < np):
            var qi: UInt64 = ((ui * np.cast[DType.uint64]()) + p.cast[DType.uint64]())
            var conc: Float64 = (ctx[].nodes[].conc[].a[Int(qi)] if (qi < ctx[].nodes[].conc[].size()) else Float64(0.0))
            _ = R.fprintf(this[].outfile_, rt_lit(" %-10f"), A(conc))
            p = (p + Int32(1))
        i = (i + Int32(1))
    rt_set_sp(__sp)

