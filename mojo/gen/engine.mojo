        var dv_need_2: Float64 = (volume - v_accum)
        var a1_ext: Float64 = tbl[].y[].a[Int(last.cast[DType.uint64]())]
        var depth_2: Float64 = Float64(0.0)
        if (Math.Abs(s_2) < Float64(1e-10)):
