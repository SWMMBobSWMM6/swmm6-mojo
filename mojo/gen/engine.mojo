def F_transport__routeLegacyHeat(var ctx: Ref[T_SimulationContext], var dt: Float64) raises:
    if ((not ctx[].options[].heat_transport) or (dt <= Float64(0.0))):
        return
    var hs: Ref[T_HeatState] = ctx[].heat_state
    var nn: Int32 = T_SimulationContext__n_nodes(ctx)
    var nl: Int32 = T_SimulationContext__n_links(ctx)
    var t_init: Float64 = Ptr[Float64](ctx[].heat_config[].global_temp, Int(Int64(0)))[Int(Int32(6))]
    if (hs[].node_temp[].size() != nn.cast[DType.uint64]()):
        T_HeatState__resize(hs, nn, nl, t_init)
    var sc: Ref[T_transport__anon_transport_components_HeatModule_HeatLegacy_cpp_HeatScratch] = F_transport__anon_transport_components_HeatModule_HeatLegacy_cpp__scratch_HeatLegacy()
    T_transport__anon_transport_components_HeatModule_HeatLegacy_cpp_HeatScratch__ensure(sc, nn, nl)
    if (not hs[].legacy_seeded):
        Algo.fill[Float64](hs[].node_temp[].begin(), hs[].node_temp[].end(), t_init)
        Algo.fill[Float64](hs[].link_temp[].begin(), hs[].link_temp[].end(), t_init)
        F_transport__applyInitialTempOverrides(ctx)
        hs[].legacy_seeded = True
    F_transport_heat__applyHeatFluxes(ctx, dt)
    var i: Int32 = Int32(0)
    while (i < nn):
        sc[].node_old[].a[Int(i.cast[DType.uint64]())] = hs[].node_temp[].a[Int(i.cast[DType.uint64]())]
        i = (i + Int32(1))
    var j: Int32 = Int32(0)
    while (j < nl):
        sc[].link_old[].a[Int(j.cast[DType.uint64]())] = hs[].link_temp[].a[Int(j.cast[DType.uint64]())]
        j = (j + Int32(1))
    Algo.fill[Float64](sc[].temp_in[].begin(), sc[].temp_in[].end(), Float64(0.0))
    var j_2: Int32 = Int32(0)
    while (j_2 < nl):
        var uj: UInt64 = j_2.cast[DType.uint64]()
        var q: Float64 = Math.Abs(ctx[].links[].flow[].a[Int(uj)])
        if (q <= Float64(0.0)):
            j_2 = (j_2 + Int32(1))
            continue
        var downstream: Int32 = (ctx[].links[].node2[].a[Int(uj)] if (ctx[].links[].flow[].a[Int(uj)] >= Float64(0.0)) else ctx[].links[].node1[].a[Int(uj)])
        if ((downstream < Int32(0)) or (downstream >= nn)):
            j_2 = (j_2 + Int32(1))
            continue
        var __cp1 = rt_addr(sc[].temp_in[].a[Int(downstream.cast[DType.uint64]())])
        __cp1[] = (__cp1[] + (q * sc[].link_old[].a[Int(uj)]))
        j_2 = (j_2 + Int32(1))
    var i_2: Int32 = Int32(0)
    while (i_2 < nn):
        var ui: UInt64 = i_2.cast[DType.uint64]()
        if (ui < hs[].node_temp_vol_in[].size()):
            var __cp2 = rt_addr(sc[].temp_in[].a[Int(ui)])
            __cp2[] = (__cp2[] + hs[].node_temp_vol_in[].a[Int(ui)])
        i_2 = (i_2 + Int32(1))
    var i_3: Int32 = Int32(0)
    while (i_3 < nn):
        var ui_2: UInt64 = i_3.cast[DType.uint64]()
        var v_old: Float64 = ctx[].nodes[].old_volume[].a[Int(ui_2)]
        var v_in: Float64 = ctx[].nodes[].qual_vol_in[].a[Int(ui_2)]
        var q_in: Float64 = ((v_in / dt) if (dt > Float64(0.0)) else Float64(0.0))
        var t_old: Float64 = sc[].node_old[].a[Int(ui_2)]
        if (not F_quality__nodeIsReactor(ctx, i_3)):
            hs[].node_temp[].a[Int(ui_2)] = (((sc[].temp_in[].a[Int(ui_2)] * dt) / v_in) if (q_in > gs()[].G_F_quality__LEGACY_ZERO) else t_old)
            i_3 = (i_3 + Int32(1))
            continue
        if (q_in <= gs()[].G_F_quality__LEGACY_ZERO):
            hs[].node_temp[].a[Int(ui_2)] = t_old
            i_3 = (i_3 + Int32(1))
            continue
        var mass_in: Float64 = (sc[].temp_in[].a[Int(ui_2)] * dt)
        var t_in: Float64 = (mass_in / v_in)
        var t_new: Float64 = (((t_old * v_old) + mass_in) / (v_old + v_in))
        t_new = M.clamp(t_new, M.min_(t_old, t_in), M.max_(t_old, t_in))
        hs[].node_temp[].a[Int(ui_2)] = t_new
        i_3 = (i_3 + Int32(1))
    var is_steady: Bool = (ctx[].options[].routing_model == T_RoutingModel__STEADY)
    var j_3: Int32 = Int32(0)
    while (j_3 < nl):
        var uj_2: UInt64 = j_3.cast[DType.uint64]()
        var upstream: Int32 = (ctx[].links[].node1[].a[Int(uj_2)] if is_steady else (ctx[].links[].node1[].a[Int(uj_2)] if (ctx[].links[].flow[].a[Int(uj_2)] >= Float64(0.0)) else ctx[].links[].node2[].a[Int(uj_2)]))
        if ((upstream < Int32(0)) or (upstream >= nn)):
            j_3 = (j_3 + Int32(1))
            continue
        var un: UInt64 = upstream.cast[DType.uint64]()
        var t_up: Float64 = hs[].node_temp[].a[Int(un)]
        if F_quality__linkTakesUpstreamValue(ctx, j_3):
            hs[].link_temp[].a[Int(uj_2)] = t_up
            j_3 = (j_3 + Int32(1))
            continue
        var v_old_2: Float64 = ctx[].links[].old_volume[].a[Int(uj_2)]
        var t_old_2: Float64 = sc[].link_old[].a[Int(uj_2)]
        var t_new_2: Float64 = Float64(0.0)
        if is_steady:
            t_new_2 = t_up
        elif F_quality__linkIsDry(ctx, j_3):
            t_new_2 = t_up
        else:
            var q_in_2: Float64 = F_quality__conduitMixingInflow(ctx, j_3, dt)
            if (q_in_2 <= gs()[].G_F_quality__LEGACY_ZERO):
                t_new_2 = t_old_2
            else:
                var v_in_2: Float64 = (q_in_2 * dt)
                t_new_2 = (((t_old_2 * v_old_2) + (t_up * v_in_2)) / (v_old_2 + v_in_2))
                t_new_2 = M.clamp(t_new_2, M.min_(t_old_2, t_up), M.max_(t_old_2, t_up))
        hs[].link_temp[].a[Int(uj_2)] = t_new_2
        j_3 = (j_3 + Int32(1))

