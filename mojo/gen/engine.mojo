def F_msxlid__initialize(var c: Ref[T_SimulationContext]) raises:
    var r: Ref[T_ReactionData] = c[].reactions
    if r[].lid_controls[].empty():
        return
    var s: Ref[T_StorageData] = c[].node_subtypes[].storages
    var ns: Int32 = T_ReactionData__n_species(r)
    r[].lid[].node_mass[].resize(T_StorageData__count(s).cast[DType.uint64]())
    r[].lid[].node_outlet[].resize(T_StorageData__count(s).cast[DType.uint64]())
    r[].lid[].node_mobile_old[].resize(T_StorageData__count(s).cast[DType.uint64](), Float64(0.0))
    var row: Int32 = Int32(0)
    while (row < T_StorageData__count(s)):
        if F_msxlid__anon_quality_MsxLidReactions_cpp__enabledNode_MsxLidReactions(c, row):
            var state: Ref[T_LidNodeState] = s[].lid_state[].a[Int(row.cast[DType.uint64]())]
            var mass: Ref[Vec[Float64]] = r[].lid[].node_mass[].a[Int(row.cast[DType.uint64]())]
            var node: Int32 = s[].node_idx[].a[Int(row.cast[DType.uint64]())]
            if (mass[].size() == (state[].cells[].size() * ns.cast[DType.uint64]())):
                row = (row + Int32(1))
                continue
            r[].lid[].node_mobile_old[].a[Int(row.cast[DType.uint64]())] = c[].nodes[].volume[].a[Int(node.cast[DType.uint64]())]
            mass[].resize((state[].cells[].size() * ns.cast[DType.uint64]()))
            var i: UInt64 = UInt64(0)
            while (i < state[].cells[].size()):
                var water: Float64 = (state[].richards_water[].a[Int(i)] if (state[].richards and (i < state[].richards_water[].size())) else (state[].cells[].a[Int(i)][].theta * state[].cells[].a[Int(i)][].geometric_volume))
                var sp: Int32 = Int32(0)
                while (sp < ns):
                    mass[].a[Int(((i * ns.cast[DType.uint64]()) + sp.cast[DType.uint64]()))] = (water * r[].msx_node_conc[].a[Int(((node * ns) + sp).cast[DType.uint64]())])
                    sp = (sp + Int32(1))
                i = (i + UInt64(1))
        row = (row + Int32(1))

def F_msxlid__prepareNodes(var c: Ref[T_SimulationContext], var dt: Float64) raises:
    var r: Ref[T_ReactionData] = c[].reactions
    if (r[].lid_controls[].empty() or (not (dt > Float64(0.0)))):
        return
    F_msxlid__initialize(c)
    F_transport__armMsxRoutingLedger(c)
    var st: Ref[T_StorageData] = c[].node_subtypes[].storages
    var ns: Int32 = T_ReactionData__n_species(r)
    r[].msx_ext_mass_in[].resize((T_SimulationContext__n_nodes(c).cast[DType.uint64]() * ns.cast[DType.uint64]()), Float64(0.0))
    var row: Int32 = Int32(0)
    while (row < T_StorageData__count(st)):
        if F_msxlid__anon_quality_MsxLidReactions_cpp__enabledNode_MsxLidReactions(c, row):
            var state: Ref[T_LidNodeState] = st[].lid_state[].a[Int(row.cast[DType.uint64]())]
            if (state[].quality_old_water[].size() != state[].cells[].size()):
                row = (row + Int32(1))
                continue
            var node: Int32 = st[].node_idx[].a[Int(row.cast[DType.uint64]())]
            var base: Int32 = (node * ns)
            var water: Ref[Vec[Float64]] = state[].quality_old_water[].Clone()
            var mobile: Float64 = state[].quality_old_mobile
            var mass: Ref[Vec[Float64]] = r[].lid[].node_mass[].a[Int(row.cast[DType.uint64]())]
            var mobile_mass: Ref[Vec[Float64]] = Vec[Float64].new_(ns.cast[DType.uint64]())
            var external: Ref[Vec[Float64]] = Vec[Float64].new_(ns.cast[DType.uint64]())
            var capture: Float64 = Float64(0.0)
            var v__r1: Ref[Vec[Ref[T_LidWaterTransfer]]] = state[].quality_transfers
            var v__i2: Int64 = Int64(0)
            var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
            while (v__i2 < v__i2_n):
                var t: Ref[T_LidWaterTransfer] = v__r1[].a[Int(v__i2)]
                if (t[].from_ == Int32(-2)):
                    capture = (capture + t[].volume)
                v__i2 = (v__i2 + Int64(1))
            var incoming: Float64 = (c[].nodes[].qual_vol_in[].a[Int(node.cast[DType.uint64]())] + (capture if (T_SimulationContext__n_pollutants(c) > Int32(0)) else Float64(0.0)))
            var sp: Int32 = Int32(0)
            while (sp < ns):
                mobile_mass[].a[Int(sp.cast[DType.uint64]())] = (r[].msx_node_conc[].a[Int((base + sp).cast[DType.uint64]())] * mobile)
                if state[].richards:
                    var __cp1 = rt_addr(mobile_mass[].a[Int(sp.cast[DType.uint64]())])
                    __cp1[] = (__cp1[] + mass[].a[Int(sp.cast[DType.uint64]())])
                    mass[].a[Int(sp.cast[DType.uint64]())] = Float64(0.0)
                external[].a[Int(sp.cast[DType.uint64]())] = (M.max_(Float64(0.0), ((r[].msx_ext_mass_in[].a[Int((base + sp).cast[DType.uint64]())] * dt) / incoming)) if (incoming > Float64(0.0)) else Float64(0.0))
                sp = (sp + Int32(1))
            var v__r3: Ref[Vec[Ref[T_LidWaterTransfer]]] = state[].quality_transfers
            var v__i4: Int64 = Int64(0)
            var v__i4_n: Int64 = v__r3[].n.cast[DType.int64]()
            while (v__i4 < v__i4_n):
                var t_2: Ref[T_LidWaterTransfer] = v__r3[].a[Int(v__i4)]
