    var dummy: Ref[Vec[Float64]] = this[].dummy_vol_[].Clone()
    var inlet: Ref[Vec[UInt8]] = this[].inlet_control_[].Clone()
    var published: Ref[Vec[UInt8]] = this[].node_pub_[].Clone()
    var last: Float64 = this[].last_h_
    var minimum: Float64 = this[].min_h_
    var cached: Float64 = this[].dt_cache_
    var simulated: Float64 = this[].sim_time_
    var suggested: Float64 = this[].suggested_h_
