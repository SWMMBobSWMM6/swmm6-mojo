def T_quality_QualitySolver__mixAtNodes(this: Ref[T_quality_QualitySolver], var ctx: Ref[T_SimulationContext], var dt: Float64) raises:
    var np: Int32 = this[].n_pollutants_
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var poll: Ref[T_PollutantData] = ctx[].pollutants
    var mb: Ref[T_SimulationContext_MassBalance] = ctx[].mass_balance
    var zero_bf_opt: Bool = ctx[].options[].outfall_backflow_zero
    var reactions_active: Bool = F_transport__legacyReactionsActive(ctx)
    var any_treatment: Bool = T_TreatmentData__hasAny(ctx[].treatment)
    var i: Int32 = Int32(0)
    while (i < T_SimulationContext__n_nodes(ctx)):
        var ui: UInt64 = i.cast[DType.uint64]()
        var v_old: Float64 = nodes[].old_volume[].a[Int(ui)]
        var v_in: Float64 = nodes[].qual_vol_in[].a[Int(ui)]
        var is_storage: Bool = (nodes[].type_[].a[Int(ui)] == T_NodeType__STORAGE)
        var zero_bf: Bool = (zero_bf_opt and (nodes[].type_[].a[Int(ui)] == T_NodeType__OUTFALL))
        if (not F_quality__nodeIsReactor(ctx, i)):
            var q_node: Float64 = ((v_in / dt) if (dt > Float64(0.0)) else Float64(0.0))
            var p: Int32 = Int32(0)
            while (p < np):
                var idx: UInt64 = ((ui * np.cast[DType.uint64]()) + p.cast[DType.uint64]())
                if (idx >= nodes[].conc[].size()):
                    p = (p + Int32(1))
                    continue
                if (q_node > gs()[].G_F_quality__LEGACY_ZERO):
                    var mass_in: Float64 = ((nodes[].qual_mass_in[].a[Int(idx)] * dt) if (idx < nodes[].qual_mass_in[].size()) else Float64(0.0))
                    if (mass_in < Float64(0.0)):
                        var avail: Float64 = (nodes[].conc_old[].a[Int(idx)] * v_old)
                        if (mass_in < (-avail)):
                            F_quality__bookNegativeSourceClamp(ctx, i, p, (-(avail + mass_in)))
                            mass_in = (-avail)
                    nodes[].conc[].a[Int(idx)] = (mass_in / v_in)
                elif zero_bf:
                    nodes[].conc[].a[Int(idx)] = Float64(0.0)
                elif (nodes[].depth[].a[Int(ui)] > gs()[].G_F_quality__ZERO_DEPTH):
                    nodes[].conc[].a[Int(idx)] = nodes[].conc_old[].a[Int(idx)]
                else:
                    nodes[].conc[].a[Int(idx)] = (nodes[].qual_mass_in[].a[Int(idx)] if (idx < nodes[].qual_mass_in[].size()) else Float64(0.0))
                p = (p + Int32(1))
            i = (i + Int32(1))
            continue
        var f_evap: Float64 = F_quality__storageEvapFactor(ctx, i)
        var q_exfil: Float64 = Float64(0.0)
        if is_storage:
            var srow: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, i)
            if (srow >= Int32(0)):
                var us: UInt64 = srow.cast[DType.uint64]()
                var st: Ref[T_StorageData] = ctx[].node_subtypes[].storages
                var v_exfil: Float64 = (st[].exfil_loss[].a[Int(us)] if (us < st[].exfil_loss[].size()) else Float64(0.0))
                q_exfil = ((v_exfil / dt) if (dt > Float64(0.0)) else Float64(0.0))
        var q_in: Float64 = ((v_in / dt) if (dt > Float64(0.0)) else Float64(0.0))
        var dry: Bool = (F_quality__nodeIsDry(ctx, i, q_in) and (not F_lidnode__active(ctx, i)))
        var p_2: Int32 = Int32(0)
        while (p_2 < np):
            var idx_2: UInt64 = ((ui * np.cast[DType.uint64]()) + p_2.cast[DType.uint64]())
            if (idx_2 >= nodes[].conc[].size()):
                p_2 = (p_2 + Int32(1))
                continue
            var up: UInt64 = p_2.cast[DType.uint64]()
            var c1: Float64 = nodes[].conc_old[].a[Int(idx_2)]
            var seeped: Float64 = ((q_exfil * c1) * dt)
            c1 = (c1 * f_evap)
            var k: Float64 = (poll[].k_decay[].a[Int(up)] if (up < poll[].k_decay[].size()) else Float64(0.0))
            if reactions_active:
                k = Float64(0.0)
            if (((k != Float64(0.0)) and any_treatment) and F_quality__anon_quality_QualityRouting_cpp__nodeHasTreatmentFor_QualityRouting(ctx, i, p_2)):
                k = Float64(0.0)
            var reacted: Float64 = Float64(0.0)
            if (k != Float64(0.0)):
                var c2: Float64 = M.max_(Float64(0.0), (c1 * (Float64(1.0) - (k * dt))))
                reacted = ((c1 - c2) * v_old)
                c1 = c2
            var mass_in_2: Float64 = ((nodes[].qual_mass_in[].a[Int(idx_2)] * dt) if (idx_2 < nodes[].qual_mass_in[].size()) else Float64(0.0))
            if (mass_in_2 < Float64(0.0)):
                var avail_2: Float64 = (nodes[].conc_old[].a[Int(idx_2)] * v_old)
                if (mass_in_2 < (-avail_2)):
                    F_quality__bookNegativeSourceClamp(ctx, i, p_2, (-(avail_2 + mass_in_2)))
                    mass_in_2 = (-avail_2)
            var c_new: Float64 = Float64(0.0)
            if (q_in <= gs()[].G_F_quality__LEGACY_ZERO):
                c_new = c1
            else:
                var c_in: Float64 = (mass_in_2 / v_in)
                var c_max: Float64 = M.max_(c1, c_in)
                c_new = (((c1 * v_old) + mass_in_2) / (v_old + v_in))
                c_new = M.min_(c_new, c_max)
                c_new = M.max_(c_new, Float64(0.0))
            if dry:
                if (up < mb[].qual_routing_final_dry[].size()):
                    var __cp1 = rt_addr(mb[].qual_routing_final_dry[].a[Int(up)])
                    __cp1[] = (__cp1[] + (c_new * nodes[].volume[].a[Int(ui)]))
                c_new = Float64(0.0)
            c_new = M.max_(c_new, Float64(0.0))
            nodes[].conc[].a[Int(idx_2)] = c_new
            if ((reacted > Float64(0.0)) and (up < mb[].qual_routing_reacted[].size())):
                var __cp2 = rt_addr(mb[].qual_routing_reacted[].a[Int(up)])
                __cp2[] = (__cp2[] + reacted)
            if ((seeped != Float64(0.0)) and (up < mb[].qual_routing_seep[].size())):
                var __cp3 = rt_addr(mb[].qual_routing_seep[].a[Int(up)])
                __cp3[] = (__cp3[] + seeped)
            p_2 = (p_2 + Int32(1))
        i = (i + Int32(1))

