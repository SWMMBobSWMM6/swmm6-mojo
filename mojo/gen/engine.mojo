        this[].unmet_withdrawal_[].Assign(unmet)
        this[].node_carry_[].Assign(carry)
        this[].node_exch_[].Assign(exchange)
        this[].node_in_[].Assign(incoming)
        this[].node_out_[].Assign(outgoing)
        this[].flood_vol_[].Assign(flood)
        this[].cell_q_int_[].Assign(qint)
        this[].dummy_vol_[].Assign(dummy)
        this[].inlet_control_[].Assign(inlet)
        this[].node_pub_[].Assign(published)
        this[].last_h_ = last
        this[].min_h_ = minimum
        this[].dt_cache_ = cached
        this[].sim_time_ = simulated
        this[].suggested_h_ = suggested
        this[].total_steps_ = total
        this[].last_nsteps_ = previous_steps
        Algo.fill[Float64](this[].face_lat_spill_[].begin(), this[].face_lat_spill_[].end(), Float64(0.0))
        T_fv_ExplicitFvSolver__refreshDepths(this)
        T_fv_NetworkStateData__Assign(this[].state_, state)
        this[].state_clean_ = False
        this[].lists_valid_ = False
        this[].census_count_ = Int32(0)
        raise rt_throw(__e__t1)

def T_fv_ExplicitFvSolver__run_stats(this: Ref[T_fv_ExplicitFvSolver]) raises -> Ref[T_fv_INetworkSolver_RunStats]:
    var s: Ref[T_fv_INetworkSolver_RunStats] = T_fv_INetworkSolver_RunStats__new()
    s[].nsteps = this[].total_steps_
    s[].nflux = this[].total_flux_
    s[].last_h = this[].last_h_
    s[].min_h = this[].min_h_
    s[].avg_h = ((this[].sim_time_ / this[].total_steps_.cast[DType.float64]()) if (this[].total_steps_ > Int64(0)) else Float64(0.0))
    if (this[].active_n_ > Int64(0)):
        s[].active_frac_mean = (this[].active_sum_ / this[].active_n_.cast[DType.float64]())
        s[].active_frac_min = this[].active_min_
        s[].active_frac_max = this[].active_max_
    s[].n_tiers = M.min_(this[].lts_tiers_, gs()[].G_F_fv__kMaxLtsTiers)
    var k: Int32 = Int32(0)
    while (k < s[].n_tiers):
        Ptr[Int64](s[].tier_cells, Int(Int64(0)))[Int(k)] = this[].tier_occupancy_[Int(k.cast[DType.uint64]())]
        k = (k + Int32(1))
    s[].dt_argmin_pressurized = this[].dt_argmin_pressurized_
    s[].dt_argmin_band = this[].dt_argmin_band_
    s[].dt_argmin_free = this[].dt_argmin_free_
    s[].dt_argmin_node = this[].dt_argmin_node_
    s[].n_macro_cycles = this[].n_macro_cycles_
    s[].n_macro_rejected = this[].n_macro_rejected_
    return T_fv_INetworkSolver_RunStats__MoveNew(s)

def T_fv_ExplicitFvSolver__nodeVolumeFromDepth(this: Ref[T_fv_ExplicitFvSolver], var node: Int32, var depth: Float64) raises -> Float64:
    var un: UInt64 = node.cast[DType.uint64]()
    if (depth <= Float64(0.0)):
        return Float64(0.0)
    var full: Float64 = this[].mesh_[].node_full_depth[].a[Int(un)]
    if (((this[].mesh_[].node_can_pond[].a[Int(un)].cast[DType.int32]() != Int32(0)) and (full > Float64(0.0))) and (depth > full)):
        return (T_fv_ExplicitFvSolver__nodeVolumeFromDepth(this, node, full) + ((depth - full) * this[].mesh_[].node_ponded_area[].a[Int(un)]))
    var off: Int32 = this[].mesh_[].node_vol_off[].a[Int(un)]
    if (off < Int32(0)):
        return (this[].state_[].node_surf_area[].a[Int(un)] * depth)
    var dmax: Float64 = this[].mesh_[].node_vol_dmax[].a[Int(un)]
    var n: Int32 = gs()[].G_F_fv__kNodeVolSamples
    var vmax: Float64 = this[].mesh_[].node_vol_tbl[].a[Int(((off + n) - Int32(1)).cast[DType.uint64]())]
    if (depth >= dmax):
        return (vmax + (this[].mesh_[].node_vol_atop[].a[Int(un)] * (depth - dmax)))
    var dd: Float64 = (dmax / (n - Int32(1)).cast[DType.float64]())
    var i: Int32 = Conv.D2I((depth / dd))
    if (i > (n - Int32(2))):
        i = (n - Int32(2))
    if (i < Int32(0)):
        i = Int32(0)
    var t: Float64 = ((depth - (i.cast[DType.float64]() * dd)) / dd)
    var v0: Float64 = this[].mesh_[].node_vol_tbl[].a[Int((off + i).cast[DType.uint64]())]
    var v1: Float64 = this[].mesh_[].node_vol_tbl[].a[Int(((off + i) + Int32(1)).cast[DType.uint64]())]
    return (v0 + ((v1 - v0) * t))

def T_fv_ExplicitFvSolver__advanceImpl(this: Ref[T_fv_ExplicitFvSolver], var t_current: Float64, var t_target: Float64, var forcing: Ref[T_fv_FvStepForcing]) raises -> Float64:
    var __sp = rt_sp()
