def T_NodeData__save_hyd_state(this: Ref[T_NodeData]) raises:
    _ = Algo.copy_[Float64](this[].depth[].begin(), this[].depth[].end(), this[].old_depth[].begin())
    _ = Algo.copy_[Float64](this[].volume[].begin(), this[].volume[].end(), this[].old_volume[].begin())
    _ = Algo.copy_[Float64](this[].inflow[].begin(), this[].inflow[].end(), this[].old_inflow[].begin())
    var i: UInt64 = UInt64(0)
    while (i < this[].inflow[].size()):
        this[].old_net_inflow[].a[Int(i)] = (this[].inflow[].a[Int(i)] - this[].outflow[].a[Int(i)])
        i = (i + UInt64(1))

def T_NodeData__save_lat_qual_state(this: Ref[T_NodeData]) raises:
    _ = Algo.copy_[Float64](this[].lat_flow[].begin(), this[].lat_flow[].end(), this[].old_lat_flow[].begin())
    _ = Algo.copy_[Float64](this[].conc[].begin(), this[].conc[].end(), this[].conc_old[].begin())

