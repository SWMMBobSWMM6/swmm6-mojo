    this[].node_quality_value[].assign(unp, Float64(0.0))
    this[].node_quality_persist[].assign(unp, T_ForcingPersist__RESET)
    this[].node_temperature_mode[].assign(un, T_ForcingMode__NONE)
    this[].node_temperature_value[].assign(un, Float64(0.0))
    this[].node_temperature_persist[].assign(un, T_ForcingPersist__RESET)
    this[].node_age_mode[].assign(un, T_ForcingMode__NONE)
    this[].node_age_value[].assign(un, Float64(0.0))
    this[].node_age_persist[].assign(un, T_ForcingPersist__RESET)
    this[].link_flow_mode[].assign(ul, T_ForcingMode__NONE)
    this[].link_flow_value[].assign(ul, Float64(0.0))
    this[].link_flow_persist[].assign(ul, T_ForcingPersist__RESET)
    this[].link_setting_mode[].assign(ul, T_ForcingMode__NONE)
    this[].link_setting_value[].assign(ul, Float64(0.0))
    this[].link_setting_persist[].assign(ul, T_ForcingPersist__RESET)
    this[].link_seepage_mode[].assign(ul, T_ForcingMode__NONE)
    this[].link_seepage_value[].assign(ul, Float64(0.0))
    this[].link_seepage_persist[].assign(ul, T_ForcingPersist__RESET)
    var ulp: UInt64 = (n_links.cast[DType.uint64]() * n_pollutants.cast[DType.uint64]())
    this[].link_quality_mode[].assign(ulp, T_ForcingMode__NONE)
