    return (w1 + (((y - y1) / (y2 - y1)) * (w2 - w1)))

def F_transect__anon_hydraulics_Transect_cpp__shapeGetArea_Transect(var y: Float64, var w: Float64, var y1: Float64, var w1: Float64) raises -> Float64:
