def T_InitialQualityData__add(this: Ref[T_InitialQualityData], var link: Bool, var name: Ref[Str], var cons: Ref[Str], var v: Float64, var ei: Int32, var k: Int32, var fromFile: Bool) raises:
    this[].is_link[].push_back((Int32(1) if link else Int32(0)).cast[DType.uint8]())
    this[].elem_name[].push_back(name[].Clone())
    this[].elem_idx[].push_back(ei)
    this[].constituent[].push_back(cons[].Clone())
    this[].kind[].push_back(k)
    this[].value[].push_back(v)
    this[].from_file[].push_back((Int32(1) if fromFile else Int32(0)).cast[DType.uint8]())

def T_InitialQualityData__erase(this: Ref[T_InitialQualityData], var idx: Int32) raises:
    if ((idx < Int32(0)) or (idx >= T_InitialQualityData__count(this))):
        return
    var u: UInt64 = idx.cast[DType.uint64]()
    _ = this[].is_link[].erase(Iter[UInt8].op_add(this[].is_link[].begin(), u.cast[DType.int64]()))
    _ = this[].elem_name[].erase(Iter[Ref[Str]].op_add(this[].elem_name[].begin(), u.cast[DType.int64]()))
    _ = this[].elem_idx[].erase(Iter[Int32].op_add(this[].elem_idx[].begin(), u.cast[DType.int64]()))
    _ = this[].constituent[].erase(Iter[Ref[Str]].op_add(this[].constituent[].begin(), u.cast[DType.int64]()))
    _ = this[].kind[].erase(Iter[Int32].op_add(this[].kind[].begin(), u.cast[DType.int64]()))
    _ = this[].value[].erase(Iter[Float64].op_add(this[].value[].begin(), u.cast[DType.int64]()))
    if (u < this[].from_file[].size()):
        _ = this[].from_file[].erase(Iter[UInt8].op_add(this[].from_file[].begin(), u.cast[DType.int64]()))

