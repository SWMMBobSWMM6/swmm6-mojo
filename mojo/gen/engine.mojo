def T_surface_InfilBank__init(this: Ref[T_surface_InfilBank], var n: Int32) raises:
    T_surface_InfilBank__clear(this)
    this[].methods_[].assign(n.cast[DType.uint64](), T_InfilModel__HORTON)
    this[].owners_[].assign(n.cast[DType.uint64](), T_surface_InfilBank_Owner__BANK)
    this[].constant_[].assign(n.cast[DType.uint64](), Float64(0.0))
    this[].cumulative_[].assign(n.cast[DType.uint64](), Float64(0.0))

def T_surface_InfilBank__setMethod(this: Ref[T_surface_InfilBank], var e: Int32, var method: T_InfilModel, var p: Ptr[Float64], var opts: Ref[T_SimulationOptions]) raises:
    this[].methods_[].a[Int(e.cast[DType.uint64]())] = method
    var __sv1 = method
    while True:
        if __sv1 == T_InfilModel__HORTON or __sv1 == T_InfilModel__MOD_HORTON:
            if this[].horton_[].empty():
                this[].horton_[].resize(this[].methods_[].size())
            F_infil__horton_init(this[].horton_[].a[Int(e.cast[DType.uint64]())], p[Int(Int32(0))], p[Int(Int32(1))], p[Int(Int32(2))], p[Int(Int32(3))], p[Int(Int32(4))], opts)
            break
        elif __sv1 == T_InfilModel__GREEN_AMPT or __sv1 == T_InfilModel__MOD_GREEN_AMPT:
            if this[].grnampt_[].empty():
                this[].grnampt_[].resize(this[].methods_[].size())
            F_infil__grnampt_init(this[].grnampt_[].a[Int(e.cast[DType.uint64]())], p[Int(Int32(0))], p[Int(Int32(1))], p[Int(Int32(2))], opts)
            break
        elif __sv1 == T_InfilModel__CURVE_NUM:
            if this[].curvenum_[].empty():
                this[].curvenum_[].resize(this[].methods_[].size())
            F_infil__curvenum_init(this[].curvenum_[].a[Int(e.cast[DType.uint64]())], p[Int(Int32(0))], p[Int(Int32(2))])
            break
        elif __sv1 == T_InfilModel__CONSTANT:
            this[].constant_[].a[Int(e.cast[DType.uint64]())] = (p[Int(Int32(0))] / F_ucf__UCF(Int32(0), opts))
            break
        break

def T_surface_InfilBank__rateFeet(this: Ref[T_surface_InfilBank], var e: Int32, var precip: Float64, var runon: Float64, var depth: Float64, var dt: Float64, var factors: Ref[T_surface_InfilBank_Factors]) raises -> Float64:
    if ((this[].owners_[].a[Int(e.cast[DType.uint64]())] == T_surface_InfilBank_Owner__EXTERNAL) or (dt <= Float64(0.0))):
        return Float64(0.0)
    var f: Float64 = T_surface_InfilBank__evaluate(this, e, precip, runon, depth, dt, T_surface_InfilBank_Factors__New_rFactors(factors))
    var __cp1 = rt_addr(this[].cumulative_[].a[Int(e.cast[DType.uint64]())])
    __cp1[] = (__cp1[] + (M.max_(Float64(0.0), (f * Float64(0.3048))) * dt))
    return f

def T_surface_InfilBank__pack(this: Ref[T_surface_InfilBank], var i: Int32, model: P[Int32], var state: Ptr[Float64]) raises:
    Algo.fill[Float64](state, state.add(Int(Int64(6))), Float64(0.0))
    if ((i < Int32(0)) or (i.cast[DType.uint64]() >= this[].methods_[].size())):
        model[] = Int32(0)
        return
    var ui: UInt64 = i.cast[DType.uint64]()
    model[] = this[].methods_[].a[Int(ui)]
    if (this[].owners_[].a[Int(ui)] == T_surface_InfilBank_Owner__EXTERNAL):
        return
    var __sv1 = this[].methods_[].a[Int(ui)]
    while True:
        if __sv1 == T_InfilModel__HORTON or __sv1 == T_InfilModel__MOD_HORTON:
            var h: Ref[T_HortonState] = this[].horton_[].a[Int(ui)]
            state[Int(Int32(0))] = h[].tp
            state[Int(Int32(1))] = h[].Fe
            state[Int(Int32(2))] = h[].Fmh
            break
        elif __sv1 == T_InfilModel__GREEN_AMPT or __sv1 == T_InfilModel__MOD_GREEN_AMPT:
            var g: Ref[T_GreenAmptState] = this[].grnampt_[].a[Int(ui)]
            state[Int(Int32(0))] = g[].IMD
            state[Int(Int32(1))] = g[].F
            state[Int(Int32(2))] = g[].Fu
            state[Int(Int32(3))] = g[].T
            state[Int(Int32(4))] = (Float64(1.0) if g[].saturated else Float64(0.0))
            break
        elif __sv1 == T_InfilModel__CURVE_NUM:
            var c: Ref[T_CurveNumState] = this[].curvenum_[].a[Int(ui)]
            state[Int(Int32(0))] = c[].S
            state[Int(Int32(1))] = c[].Se
            state[Int(Int32(2))] = c[].P_
            state[Int(Int32(3))] = c[].F
            state[Int(Int32(4))] = c[].f
            state[Int(Int32(5))] = c[].T
            break
        elif __sv1 == T_InfilModel__CONSTANT:
            break
        break

def T_surface_InfilBank__unpack(this: Ref[T_surface_InfilBank], var i: Int32, var model: Int32, var state: Ptr[Float64]) raises:
    if ((i < Int32(0)) or (i.cast[DType.uint64]() >= this[].methods_[].size())):
        return
    var ui: UInt64 = i.cast[DType.uint64]()
    if (this[].owners_[].a[Int(ui)] == T_surface_InfilBank_Owner__EXTERNAL):
        return
    if (model != this[].methods_[].a[Int(ui)]):
        return
    var __sv1 = this[].methods_[].a[Int(ui)]
    while True:
        if __sv1 == T_InfilModel__HORTON or __sv1 == T_InfilModel__MOD_HORTON:
            var h: Ref[T_HortonState] = this[].horton_[].a[Int(ui)]
            h[].tp = state[Int(Int32(0))]
            h[].Fe = state[Int(Int32(1))]
            h[].Fmh = state[Int(Int32(2))]
            break
        elif __sv1 == T_InfilModel__GREEN_AMPT or __sv1 == T_InfilModel__MOD_GREEN_AMPT:
            var g: Ref[T_GreenAmptState] = this[].grnampt_[].a[Int(ui)]
            g[].IMD = state[Int(Int32(0))]
            g[].F = state[Int(Int32(1))]
            g[].Fu = state[Int(Int32(2))]
            g[].T = state[Int(Int32(3))]
            g[].saturated = (state[Int(Int32(4))] != Float64(0.0))
            break
        elif __sv1 == T_InfilModel__CURVE_NUM:
            var c: Ref[T_CurveNumState] = this[].curvenum_[].a[Int(ui)]
            c[].S = state[Int(Int32(0))]
            c[].Se = state[Int(Int32(1))]
            c[].P_ = state[Int(Int32(2))]
            c[].F = state[Int(Int32(3))]
            c[].f = state[Int(Int32(4))]
            c[].T = state[Int(Int32(5))]
            break
        elif __sv1 == T_InfilModel__CONSTANT:
            break
        break

def T_surface_InfilBank__clear(this: Ref[T_surface_InfilBank]) raises:
    this[].methods_[].clear()
    this[].owners_[].clear()
    this[].horton_[].clear()
    this[].grnampt_[].clear()
    this[].curvenum_[].clear()
    this[].constant_[].clear()
