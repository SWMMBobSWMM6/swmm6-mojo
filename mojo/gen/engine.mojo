    this[].step_sink_user_ = user

def __h198(var a0: Ref[Vec[Float64]], var a1: Ref[Vec[Float64]], var a2: Ref[Vec[Float64]], var a3: Ref[Vec[Float64]], var a4: Ref[Vec[Float64]], var a5: Ref[Vec[Float64]], var a6: Ref[Vec[Float64]], var a7: Ref[Vec[Float64]], var a8: Ref[Vec[Float64]], var a9: Ref[Vec[Float64]]) raises -> Ref[T_fv_AcceptedWaterVolumes]:
    var o = T_fv_AcceptedWaterVolumes__new()
    o[].face_forward = a0
    o[].face_reverse = a1
    o[].structure_forward = a2
    o[].structure_reverse = a3
    o[].cell_lateral = a4
    o[].cell_loss = a5
    o[].node_deficit = a6
    o[].face_lateral_left = a7
    o[].face_lateral_right = a8
    o[].face_spill = a9
    return o

def T_fv_ExplicitFvSolver__trackAcceptedWater(this: Ref[T_fv_ExplicitFvSolver], var enabled: Bool) raises:
    this[].water_tracking_ = enabled
    if (enabled and (rt_box(this[].mesh_) != Obj())):
        T_fv_AcceptedWaterVolumes__resize(this[].water_, T_fv_NetworkMeshData__n_faces(this[].mesh_).cast[DType.uint64](), this[].mesh_[].struct_link[].size(), T_fv_NetworkMeshData__n_cells(this[].mesh_).cast[DType.uint64](), T_fv_NetworkMeshData__n_nodes(this[].mesh_).cast[DType.uint64]())
    else:
        T_fv_AcceptedWaterVolumes__MoveFrom(this[].water_, __h198(Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_(), Vec[Float64].new_()))
    T_fv_AcceptedWaterVolumes__Assign(this[].save_water_, this[].water_)
    T_fv_AcceptedWaterVolumes__Assign(this[].rk_water_, this[].water_)

