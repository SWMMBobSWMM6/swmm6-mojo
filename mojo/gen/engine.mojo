        var downstream: Int32 = (links[].node2[].a[Int(uj)] if (links[].flow[].a[Int(uj)] >= Float64(0.0)) else links[].node1[].a[Int(uj)])
        if ((downstream < Int32(0)) or (downstream >= T_SimulationContext__n_nodes(ctx))):
