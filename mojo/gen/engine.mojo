def F_transport_heat__seedBedTemperature(var ctx: Ref[T_SimulationContext]) raises:
    var bed: Ref[T_BedZoneState] = ctx[].bed_state
    var nl: Int32 = T_SimulationContext__n_links(ctx)
    var sc: Ref[T_SedimentConfig] = ctx[].heat_config[].sediment
    var t0: Float64 = (sc[].initial_temp if sc[].has_initial_temp else sc[].ground_temp)
    if (not T_BedZoneState__sized(bed, nl)):
        bed[].link_temp[].assign((nl if (nl > Int32(0)) else Int32(0)).cast[DType.uint64](), t0)
        bed[].seeded = False
    if (not bed[].seeded):
        var v__r1: Ref[Vec[Float64]] = bed[].link_temp
        var v__i2: Int64 = Int64(0)
        var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
        while (v__i2 < v__i2_n):
            var t: P[Float64] = v__r1[].a.ptr(Int(v__i2))
            t[] = t0
            v__i2 = (v__i2 + Int64(1))
        bed[].seeded = True

def F_transport_heat__applyBedSoluteExchange(var ctx: Ref[T_SimulationContext], var link_conc: Ptr[Float64], var n_arr: Int32, var offset: Int32, var n_total: Int32, var dt: Float64) raises:
    if (((not F_transport_heat__bedExchangeEnabled(ctx)) or (not (dt > Float64(0.0)))) or (link_conc == Ptr[Float64]())):
        return
    if (((n_arr <= Int32(0)) or (offset < Int32(0))) or (n_total < (offset + n_arr))):
        return
    F_transport_heat__seedBedTemperature(ctx)
    var bed: Ref[T_BedZoneState] = ctx[].bed_state
    var nl_all: Int32 = T_SimulationContext__n_links(ctx)
    var need: UInt64 = ((nl_all if (nl_all > Int32(0)) else Int32(0)).cast[DType.uint64]() * n_total.cast[DType.uint64]())
    if ((bed[].n_species != n_total) or (bed[].link_conc[].size() != need)):
        bed[].link_conc[].assign(need, Float64(0.0))
        bed[].n_species = n_total
    var nl: Int32 = T_SimulationContext__n_links(ctx)
    var na: UInt64 = n_arr.cast[DType.uint64]()
    var nt: UInt64 = n_total.cast[DType.uint64]()
    var off: UInt64 = offset.cast[DType.uint64]()
    var j: Int32 = Int32(0)
    while (j < nl):
        var uj: UInt64 = j.cast[DType.uint64]()
        if ((uj < ctx[].heat_state[].mesh_contact_link[].size()) and (ctx[].heat_state[].mesh_contact_link[].a[Int(uj)].cast[DType.int32]() != Int32(0))):
            j = (j + Int32(1))
            continue
        if (uj >= bed[].link_temp[].size()):
            break
        var vol_ft3: Float64 = ctx[].links[].volume[].a[Int(uj)]
        if (not (vol_ft3 > Float64(0.0))):
            j = (j + Int32(1))
            continue
        var bed_m2: Float64 = F_transport_heat__linkBedAreaM2(ctx, j)
        if (not (bed_m2 > Float64(0.0))):
            j = (j + Int32(1))
            continue
        var sc: Ref[T_SedimentConfig] = F_transport_heat__sedimentFor(ctx, T_HeatElement__link(j))
        var vol_w: Float64 = (vol_ft3 * gs()[].G_F_transport_heat__kCuFtToCuM)
        var vol_b: Float64 = (bed_m2 * sc[].bed_thickness)
        var q_exch: Float64 = F_transport_heat__bedExchangeQ(sc, bed_m2)
        if ((not (q_exch > Float64(0.0))) or (not (vol_b > Float64(0.0)))):
            j = (j + Int32(1))
            continue
        var s: UInt64 = UInt64(0)
        while (s < na):
            var cw: P[Float64] = rt_addr(link_conc[Int(((uj * na) + s))])
            var cb: P[Float64] = rt_addr(bed[].link_conc[].a[Int((((uj * nt) + off) + s))])
            var st: Ref[T_transport_heat_SolutePairStep] = F_transport_heat__exchangePair(cw[], cb[], vol_w, vol_b, q_exch, dt)
            cw[] = (cw[] + st[].dc_w)
            cb[] = (cb[] + st[].dc_b)
            s = (s + UInt64(1))
        j = (j + Int32(1))

def F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__phi1_BedExchange(var z: Float64) raises -> Float64:
    if (Math.Abs(z) < Float64(1e-08)):
        return (Float64(1.0) + (Float64(0.5) * z))
