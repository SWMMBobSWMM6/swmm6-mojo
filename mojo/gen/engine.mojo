def T_Table__raw() raises -> Ref[T_Table]:
    var o = Ref[T_Table](gc_new[T_Table]())
    return o

def T_Table____init_rTable(this: Ref[T_Table], var p: Ref[T_Table]) raises:
    this[].id_ = p[].id_[].Clone()
    this[].type_ = p[].type_
    this[].comment = p[].comment[].Clone()
    this[].x = p[].x[].Clone()
    this[].y = p[].y[].Clone()
    this[].cursor = T_TableCursor__New_rTableCursor(p[].cursor)
    this[].n_relative = p[].n_relative
    this[].rel_anchor = p[].rel_anchor
    this[].is_file_based = p[].is_file_based
    this[].file_handle = p[].file_handle
    this[].file_path = T_FilePathPair__New_rFilePathPair(p[].file_path)
    this[].first_boundary = T_TableBlock__New_rTableBlock(p[].first_boundary)
    this[].last_boundary = T_TableBlock__New_rTableBlock(p[].last_boundary)
    this[].cache = T_TableBlock__New_rTableBlock(p[].cache)
    this[].dx_min = p[].dx_min
    this[].x_min = p[].x_min
    this[].x_max = p[].x_max
    this[].num_cols = p[].num_cols
    this[].total_rows = p[].total_rows
    this[].num_cache_rows = p[].num_cache_rows
    this[].data_start_offset = p[].data_start_offset
    this[].row_offsets = p[].row_offsets[].Clone()
    this[].column_ids = p[].column_ids[].Clone()
    this[].column_map = p[].column_map[].Clone()

def T_Table__New_rTable(var p: Ref[T_Table]) raises -> Ref[T_Table]:
    var o: Ref[T_Table] = T_Table__raw()
    T_Table____init_rTable(o, p)
    return o

def T_Table____init_mTable(this: Ref[T_Table], var p: Ref[T_Table]) raises:
    this[].id_ = Mv.Take[Ref[Str]](rt_addr(p[].id_))
    this[].type_ = p[].type_
    this[].comment = Mv.Take[Ref[Str]](rt_addr(p[].comment))
    this[].x = Mv.Take[Ref[Vec[Float64]]](rt_addr(p[].x))
    this[].y = Mv.Take[Ref[Vec[Float64]]](rt_addr(p[].y))
    this[].cursor = T_TableCursor__MoveNew(p[].cursor)
    this[].n_relative = p[].n_relative
    this[].rel_anchor = p[].rel_anchor
    this[].is_file_based = p[].is_file_based
    this[].file_handle = p[].file_handle
    this[].file_path = T_FilePathPair__MoveNew(p[].file_path)
    this[].first_boundary = T_TableBlock__MoveNew(p[].first_boundary)
    this[].last_boundary = T_TableBlock__MoveNew(p[].last_boundary)
    this[].cache = T_TableBlock__MoveNew(p[].cache)
    this[].dx_min = p[].dx_min
    this[].x_min = p[].x_min
    this[].x_max = p[].x_max
    this[].num_cols = p[].num_cols
    this[].total_rows = p[].total_rows
    this[].num_cache_rows = p[].num_cache_rows
    this[].data_start_offset = p[].data_start_offset
    this[].row_offsets = Mv.Take[Ref[Vec[Int64]]](rt_addr(p[].row_offsets))
    this[].column_ids = Mv.Take[Ref[Vec[Ref[Str]]]](rt_addr(p[].column_ids))
    this[].column_map = Mv.Take[Ref[UMap[Ref[Str], Int32]]](rt_addr(p[].column_map))

def T_Table__New_mTable(var p: Ref[T_Table]) raises -> Ref[T_Table]:
    var o: Ref[T_Table] = T_Table__raw()
    T_Table____init_mTable(o, p)
    return o

def T_Table____init_d(this: Ref[T_Table]) raises:
    this[].id_ = Str.new_()
    this[].type_ = T_TableType__TIMESERIES
    this[].comment = Str.new_()
    this[].x = Vec[Float64].new_()
    this[].y = Vec[Float64].new_()
    this[].cursor = T_TableCursor__new()
    this[].n_relative = Int32(0)
    this[].rel_anchor = Float64(0.0)
    this[].is_file_based = False
    this[].file_handle = Ref[CFile]()
    this[].file_path = T_FilePathPair__new()
    this[].first_boundary = T_TableBlock__new()
    this[].last_boundary = T_TableBlock__new()
    this[].cache = T_TableBlock__new()
    this[].dx_min = Float64(0.0)
    this[].x_min = Float64(0.0)
    this[].x_max = Float64(0.0)
    this[].num_cols = Int32(1)
    this[].total_rows = UInt64(0)
    this[].num_cache_rows = UInt64(8192)
    this[].data_start_offset = Int64(0)
    this[].row_offsets = Vec[Int64].new_()
    this[].column_ids = Vec[Ref[Str]].new_()
    this[].column_map = UMap[Ref[Str], Int32].new_()

def T_Table__New() raises -> Ref[T_Table]:
    var o: Ref[T_Table] = T_Table__raw()
    T_Table____init_d(o)
    return o

def T_Table__new() raises -> Ref[T_Table]:
    var this = T_Table__raw()
    T_Table____init_d(this)
    return this

def T_Table__Clone(this: Ref[T_Table]) raises -> Ref[T_Table]:
    var o: Ref[T_Table] = T_Table__raw()
    T_Table____CopyFrom_Table(o, this)
    return o

def T_Table____CopyFrom_Table(this: Ref[T_Table], var s: Ref[T_Table]) raises:
    this[].id_ = (s[].id_[].Clone() if not s[].id_.isnull() else Ref[Str]())
    this[].type_ = s[].type_
    this[].comment = (s[].comment[].Clone() if not s[].comment.isnull() else Ref[Str]())
    this[].x = (s[].x[].Clone() if not s[].x.isnull() else Ref[Vec[Float64]]())
    this[].y = (s[].y[].Clone() if not s[].y.isnull() else Ref[Vec[Float64]]())
    this[].cursor = (T_TableCursor__Clone(s[].cursor) if not s[].cursor.isnull() else Ref[T_TableCursor]())
    this[].n_relative = s[].n_relative
    this[].rel_anchor = s[].rel_anchor
