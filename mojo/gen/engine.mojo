    this[].name_[].push_back(Mv.Take[Ref[Str]](__h_name1))
    this[].kind_[].push_back(kind)
    this[].units_[].push_back(Mv.Take[Ref[Str]](__h_units2))
    if (kind == T_SpeciesKind__POLLUTANT):
        this[].n_pollutants_ = (this[].n_pollutants_ + Int32(1))
    var __r3 = (this[].name_[].size().cast[DType.int32]() - Int32(1))
    rt_set_sp(__sp)
    return __r3

