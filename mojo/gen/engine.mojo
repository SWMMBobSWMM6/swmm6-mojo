def T_LinkData__save_hyd_state(this: Ref[T_LinkData]) raises:
    _ = Algo.copy_[Float64](this[].flow[].begin(), this[].flow[].end(), this[].old_flow[].begin())
    _ = Algo.copy_[Float64](this[].depth[].begin(), this[].depth[].end(), this[].old_depth[].begin())
    _ = Algo.copy_[Float64](this[].volume[].begin(), this[].volume[].end(), this[].old_volume[].begin())

def T_LinkData__save_qual_state(this: Ref[T_LinkData]) raises:
    _ = Algo.copy_[Float64](this[].conc[].begin(), this[].conc[].end(), this[].conc_old[].begin())

def T_LinkData__reset_state(this: Ref[T_LinkData]) raises:
    Algo.fill[Float64](this[].flow[].begin(), this[].flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].kw_inflow[].begin(), this[].kw_inflow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].depth[].begin(), this[].depth[].end(), Float64(0.0))
    Algo.fill[Float64](this[].volume[].begin(), this[].volume[].end(), Float64(0.0))
    Algo.fill[Float64](this[].froude[].begin(), this[].froude[].end(), Float64(0.0))
    Algo.fill[T_FlowClass](this[].flow_class[].begin(), this[].flow_class[].end(), T_FlowClass__DRY)
    Algo.fill[Float64](this[].old_flow[].begin(), this[].old_flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_depth[].begin(), this[].old_depth[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_volume[].begin(), this[].old_volume[].end(), Float64(0.0))
    Algo.fill[Float64](this[].conc[].begin(), this[].conc[].end(), Float64(0.0))
    Algo.fill[Float64](this[].conc_old[].begin(), this[].conc_old[].end(), Float64(0.0))

