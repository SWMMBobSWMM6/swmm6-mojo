                    a_rain = (a_rain / total_area)
                    a_snow = (a_snow / total_area)
                    a_infil = (a_infil / total_area)
                snap[].sys_rainfall = a_rain.cast[DType.float64]()
                snap[].sys_snow_depth = a_snow.cast[DType.float64]()
                snap[].sys_evap = a_evap.cast[DType.float64]()
                snap[].sys_infil = a_infil.cast[DType.float64]()
                snap[].sys_runoff = a_runoff.cast[DType.float64]()
            if ((not this[].ctx_[].options[].ignore_quality) and (T_SimulationContext__n_reported_species(this[].ctx_) > Int32(0))):
                var np_s: UInt64 = T_SimulationContext__n_pollutants(this[].ctx_).cast[DType.uint64]()
                var nr_s: UInt64 = T_SimulationContext__n_reported_species(this[].ctx_).cast[DType.uint64]()
                var nN_s: UInt64 = T_SimulationContext__n_nodes(this[].ctx_).cast[DType.uint64]()
                var nL_s: UInt64 = T_SimulationContext__n_links(this[].ctx_).cast[DType.uint64]()
                var nS_s: UInt64 = T_SimulationContext__n_subcatches(this[].ctx_).cast[DType.uint64]()
                var age_col: Bool = (this[].ctx_[].options[].water_age and (nr_s > np_s))
                var temp_col: Bool = this[].ctx_[].options[].heat_transport
                var temp_i: UInt64 = (np_s + (UInt32(1) if this[].ctx_[].options[].water_age else UInt32(0)).cast[DType.uint64]())
                var rx: Ref[T_ReactionData] = this[].ctx_[].reactions
                var unm: UInt64 = (T_ReactionData__n_species(rx) if (T_ReactionData__n_species(rx) > Int32(0)) else Int32(0)).cast[DType.uint64]()
                var msx_i0: UInt64 = (temp_i + (UInt32(1) if this[].ctx_[].options[].heat_transport else UInt32(0)).cast[DType.uint64]())
                var kSecPerHour: Float64 = Float64(3600.0)
                var kDryReportDepth: Float64 = Float64(1e-09)
                snap[].node_quality[].assign((nN_s * nr_s), Float64(0.0))
                var n: UInt64 = UInt64(0)
                while (n < nN_s):
                    var p_2: UInt64 = UInt64(0)
                    while (p_2 < np_s):
                        var src: UInt64 = ((n * np_s) + p_2)
                        if ((src < this[].ctx_[].nodes[].conc[].size()) and (src < this[].ctx_[].nodes[].conc_old[].size())):
                            snap[].node_quality[].a[Int(((n * nr_s) + p_2))] = ((f1_rt * this[].ctx_[].nodes[].conc_old[].a[Int(src)]) + (f_rt * this[].ctx_[].nodes[].conc[].a[Int(src)]))
                        p_2 = (p_2 + UInt64(1))
                    if (age_col and (n < this[].ctx_[].water_age_state[].node_age[].size())):
                        var wet: Bool = ((n < snap[].nodes[].depth[].size()) and (snap[].nodes[].depth[].a[Int(n)] > kDryReportDepth))
                        snap[].node_quality[].a[Int(((n * nr_s) + np_s))] = ((this[].ctx_[].water_age_state[].node_age[].a[Int(n)] / kSecPerHour) if wet else Float64(0.0))
                    if (temp_col and (n < this[].ctx_[].heat_state[].node_temp[].size())):
                        snap[].node_quality[].a[Int(((n * nr_s) + temp_i))] = this[].ctx_[].heat_state[].node_temp[].a[Int(n)]
                    var r: UInt64 = UInt64(0)
                    while (r < rx[].reported_species[].size()):
                        var m: UInt64 = rx[].reported_species[].a[Int(r)].cast[DType.uint64]()
                        var src_2: UInt64 = ((n * unm) + m)
                        if (src_2 < rx[].msx_node_conc[].size()):
                            snap[].node_quality[].a[Int((((n * nr_s) + msx_i0) + r))] = rx[].msx_node_conc[].a[Int(src_2)]
                        r = (r + UInt64(1))
                    n = (n + UInt64(1))
                snap[].link_quality[].assign((nL_s * nr_s), Float64(0.0))
                var l: UInt64 = UInt64(0)
                while (l < nL_s):
                    var p_3: UInt64 = UInt64(0)
                    while (p_3 < np_s):
                        var src_3: UInt64 = ((l * np_s) + p_3)
                        if ((src_3 < this[].ctx_[].links[].conc[].size()) and (src_3 < this[].ctx_[].links[].conc_old[].size())):
                            snap[].link_quality[].a[Int(((l * nr_s) + p_3))] = ((f1_rt * this[].ctx_[].links[].conc_old[].a[Int(src_3)]) + (f_rt * this[].ctx_[].links[].conc[].a[Int(src_3)]))
                        p_3 = (p_3 + UInt64(1))
                    if (age_col and (l < this[].ctx_[].water_age_state[].link_age[].size())):
                        var holds: Bool = ((l < this[].ctx_[].links[].volume[].size()) and (this[].ctx_[].links[].volume[].a[Int(l)] > gs()[].G_F_quality__ZERO_VOLUME))
                        var conveys: Bool = ((l < this[].ctx_[].links[].flow[].size()) and (Math.Abs(this[].ctx_[].links[].flow[].a[Int(l)]) > gs()[].G_F_constants__TINY))
                        var wet_2: Bool = (holds or conveys)
                        snap[].link_quality[].a[Int(((l * nr_s) + np_s))] = ((this[].ctx_[].water_age_state[].link_age[].a[Int(l)] / kSecPerHour) if wet_2 else Float64(0.0))
                    if (temp_col and (l < this[].ctx_[].heat_state[].link_temp[].size())):
                        snap[].link_quality[].a[Int(((l * nr_s) + temp_i))] = this[].ctx_[].heat_state[].link_temp[].a[Int(l)]
                    var r_2: UInt64 = UInt64(0)
                    while (r_2 < rx[].reported_species[].size()):
                        var m_2: UInt64 = rx[].reported_species[].a[Int(r_2)].cast[DType.uint64]()
                        var src_4: UInt64 = ((l * unm) + m_2)
                        if (src_4 < rx[].msx_link_conc[].size()):
                            snap[].link_quality[].a[Int((((l * nr_s) + msx_i0) + r_2))] = rx[].msx_link_conc[].a[Int(src_4)]
                        r_2 = (r_2 + UInt64(1))
                    l = (l + UInt64(1))
                snap[].subcatch_quality[].assign((nS_s * nr_s), Float64(0.0))
                var ro_span_q: Float64 = (this[].new_runoff_ms_ - this[].old_runoff_ms_)
                var f_ro_q: Float64 = (((this[].ctx_[].next_report_ms - this[].old_runoff_ms_) / ro_span_q) if (ro_span_q > Float64(0.0)) else Float64(1.0))
                var f1_ro_q: Float64 = (Float64(1.0) - f_ro_q)
                var s_4: UInt64 = UInt64(0)
                while (s_4 < nS_s):
                    if (temp_col and (s_4 < this[].ctx_[].heat_state[].subcatch_runoff_temp[].size())):
                        snap[].subcatch_quality[].a[Int(((s_4 * nr_s) + temp_i))] = this[].ctx_[].heat_state[].subcatch_runoff_temp[].a[Int(s_4)]
                    var has_runoff: Bool = ((s_4 < snap[].subcatch[].runoff[].size()) and (snap[].subcatch[].runoff[].a[Int(s_4)] != Float64(0.0)))
                    if (not has_runoff):
                        s_4 = (s_4 + UInt64(1))
                        continue
                    var p_4: UInt64 = UInt64(0)
                    while (p_4 < np_s):
                        var src_5: UInt64 = ((s_4 * np_s) + p_4)
                        if ((src_5 < this[].ctx_[].subcatches[].conc[].size()) and (src_5 < this[].ctx_[].subcatches[].conc_old[].size())):
                            snap[].subcatch_quality[].a[Int(((s_4 * nr_s) + p_4))] = ((f1_ro_q * this[].ctx_[].subcatches[].conc_old[].a[Int(src_5)]) + (f_ro_q * this[].ctx_[].subcatches[].conc[].a[Int(src_5)]))
                        p_4 = (p_4 + UInt64(1))
                    var r_3: UInt64 = UInt64(0)
                    while (r_3 < rx[].reported_species[].size()):
                        var m_3: UInt64 = rx[].reported_species[].a[Int(r_3)].cast[DType.uint64]()
                        var src_6: UInt64 = ((s_4 * unm) + m_3)
                        if ((src_6 < rx[].surface[].washoff_conc[].size()) and (src_6 < rx[].surface[].washoff_conc_old[].size())):
                            snap[].subcatch_quality[].a[Int((((s_4 * nr_s) + msx_i0) + r_3))] = ((f1_ro_q * rx[].surface[].washoff_conc_old[].a[Int(src_6)]) + (f_ro_q * rx[].surface[].washoff_conc[].a[Int(src_6)]))
                        r_3 = (r_3 + UInt64(1))
                    if (age_col and (s_4 < this[].ctx_[].water_age_state[].subcatch_runoff_age[].size())):
                        snap[].subcatch_quality[].a[Int(((s_4 * nr_s) + np_s))] = (this[].ctx_[].water_age_state[].subcatch_runoff_age[].a[Int(s_4)] / kSecPerHour)
                    s_4 = (s_4 + UInt64(1))
            snap[].node_ids = T_NameIndex__names(this[].ctx_[].node_names)
            snap[].link_ids = T_NameIndex__names(this[].ctx_[].link_names)
            snap[].subcatch_ids = T_NameIndex__names(this[].ctx_[].subcatch_names)
            snap[].gage_ids = T_NameIndex__names(this[].ctx_[].gage_names)
            snap[].pollut_names = this[].ctx_[].reported_species_names
            T_IOThread__post(this[].io_thread_, T_SimulationSnapshot__MoveNew(snap))
        T_hydraulics_TimestepController__reset_output_timer(this[].ctx_)

def __lam80(__ctx: VP, var c: Ref[T_LidNodeConfig]) raises -> Bool:
    return (c[].control >= Int32(0))

def T_SWMMEngine__writeHotstartSave(this: Ref[T_SWMMEngine], var entry: Ref[T_HotstartSaveEntry]) raises:
    var __sp = rt_sp()
    var hs = rt_salloc[Ref[T_HotStartFile]]()
    var sp: Ref[Str] = (entry[].path[].absolute if (not entry[].path[].absolute[].empty()) else entry[].path[].original)
    if sp[].empty():
        rt_set_sp(__sp)
        return
    var lid_restart: Bool = Algo.any_of[Ref[T_LidNodeConfig], __call70](this[].ctx_[].node_subtypes[].storages[].lid[].begin(), this[].ctx_[].node_subtypes[].storages[].lid[].end(), Dlg(VP_null(), 80))
    var full_continuation: Bool = this[].ctx_[].options[].heat_transport
    var native: Bool = ((entry[].format == T_HotstartFormat__NATIVE) or ((entry[].format == T_HotstartFormat__AUTO) and (lid_restart or full_continuation)))
    var rc: Int32 = Int32(0)
    if native:
        hs[] = Ref[T_HotStartFile]()
        if (full_continuation and this[].checkpoint_enabled_):
            var snapshot: Ref[Str] = Str.new_()
            var error: Ref[Str] = T_SWMMEngine__checkpointBytes(this, snapshot, False)
            if (not error[].empty()):
                this[].ctx_[].warnings[].push_back(Str.Cat(rt_lit("SAVE HOTSTART: incomplete native continuation: "), error))
                rt_set_sp(__sp)
                return
            Mv.Reset[Ref[T_HotStartFile]](hs, T_HotStartManager__save_with_engine_checkpoint(this[].ctx_, this[].runoff_, this[].groundwater_, sp, snapshot))
        else:
            Mv.Reset[Ref[T_HotStartFile]](hs, T_HotStartManager__save(this[].ctx_, sp))
        rc = (Int32(0) if (rt_box(hs[]) != Obj()) else Int32(1))
    else:
        if lid_restart:
            this[].ctx_[].warnings[].push_back(Str.Cat(Str.Cat(rt_lit("SAVE HOTSTART: '"), sp), rt_lit("' is LEGACY; a legacy SWMM5 file carries no LID state.")))
        var runoff: Ref[Vec[Float64]] = T_SWMMEngine__legacyRunoffSection(this)
        rc = T_HotStartManager__save_legacy_routing(sp, this[].ctx_, runoff)
    if (rc != Int32(0)):
        this[].ctx_[].warnings[].push_back(Str.Cat(rt_lit("SAVE HOTSTART: "), T_HotStartManager__last_io_error()))
    rt_set_sp(__sp)

def T_SWMMEngine__writeDueHotstartSaves(this: Ref[T_SWMMEngine]) raises:
    var k: UInt64 = UInt64(0)
    while (k < this[].ctx_[].files[].hotstart_saves[].size()):
        var entry: Ref[T_HotstartSaveEntry] = this[].ctx_[].files[].hotstart_saves[].a[Int(k)]
        if (((entry[].datetime == Float64(0.0)) or (k >= this[].hotstart_save_done_[].size())) or (this[].hotstart_save_done_[].a[Int(k)].cast[DType.int32]() != Int32(0))):
            k = (k + UInt64(1))
            continue
        var due_ms: Float64 = ((entry[].datetime - this[].ctx_[].options[].start_date) * Float64(86400000.0))
        if ((this[].ctx_[].elapsed_ms + Float64(1.0)) < due_ms):
            k = (k + UInt64(1))
            continue
        this[].hotstart_save_done_[].a[Int(k)] = Int8(1)
        T_SWMMEngine__writeHotstartSave(this, entry)
        k = (k + UInt64(1))

def T_SWMMEngine__fillSurfaceSnapshot(this: Ref[T_SWMMEngine], var snap: Ref[T_SimulationSnapshot]) raises:
    pass

def T_SWMMEngine__accumulateAvgResults(this: Ref[T_SWMMEngine]) raises:
    var du: Ref[T_ucf_DisplayUnits] = T_ucf_DisplayUnits__from(this[].ctx_[].options)
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_nodes(this[].ctx_)):
        var uj: UInt64 = j.cast[DType.uint64]()
        var dd: Float32 = (this[].ctx_[].nodes[].depth[].a[Int(uj)] * du[].length).cast[DType.float32]()
        var __cp1 = rt_addr(this[].avg_[].node_depth[].a[Int(uj)])
        __cp1[] = (__cp1[] + dd)
        var __cp2 = rt_addr(this[].avg_[].node_head[].a[Int(uj)])
        __cp2[] = (__cp2[] + (dd + (this[].ctx_[].nodes[].invert_elev[].a[Int(uj)] * du[].length).cast[DType.float32]()))
        var __cp3 = rt_addr(this[].avg_[].node_volume[].a[Int(uj)])
        __cp3[] = (__cp3[] + (T_SWMMEngine__reportedNodeVolume__i(this, j) * du[].volume).cast[DType.float32]())
        var __cp4 = rt_addr(this[].avg_[].node_lat_inflow[].a[Int(uj)])
        __cp4[] = (__cp4[] + (this[].ctx_[].nodes[].lat_flow[].a[Int(uj)] * du[].flow).cast[DType.float32]())
        var __cp5 = rt_addr(this[].avg_[].node_total_inflow[].a[Int(uj)])
        __cp5[] = (__cp5[] + (this[].ctx_[].nodes[].inflow[].a[Int(uj)] * du[].flow).cast[DType.float32]())
        var __cp6 = rt_addr(this[].avg_[].node_overflow[].a[Int(uj)])
        __cp6[] = (__cp6[] + (this[].ctx_[].nodes[].overflow[].a[Int(uj)] * du[].flow).cast[DType.float32]())
        j = (j + Int32(1))
    T_SWMMEngine__ensureXspCache(this)
    var j_2: Int32 = Int32(0)
    while (j_2 < T_SimulationContext__n_links(this[].ctx_)):
        var uj_2: UInt64 = j_2.cast[DType.uint64]()
        var q: Float64 = this[].ctx_[].links[].flow[].a[Int(uj_2)]
        var d: Float64 = this[].ctx_[].links[].depth[].a[Int(uj_2)]
        var dir: Float64 = this[].ctx_[].links[].direction[].a[Int(uj_2)].cast[DType.float64]()
        var __cp7 = rt_addr(this[].avg_[].link_flow[].a[Int(uj_2)])
        __cp7[] = (__cp7[] + ((q * du[].flow) * dir).cast[DType.float32]())
        var __cp8 = rt_addr(this[].avg_[].link_depth[].a[Int(uj_2)])
        __cp8[] = (__cp8[] + (d * du[].length).cast[DType.float32]())
        var __cp9 = rt_addr(this[].avg_[].link_volume[].a[Int(uj_2)])
        __cp9[] = (__cp9[] + (this[].ctx_[].links[].volume[].a[Int(uj_2)] * du[].volume).cast[DType.float32]())
        var lt: T_LinkType = this[].ctx_[].links[].type_[].a[Int(uj_2)]
        if (lt == T_LinkType__CONDUIT):
            var xs: Ref[T_XSectParams] = this[].xsp_cache_[].a[Int(uj_2)]
            var cr: Int32 = T_LinkSubtypes__conduit_row(this[].ctx_[].link_subtypes, j_2)
            var nb: Int32 = (this[].ctx_[].link_subtypes[].conduits[].barrels[].a[Int(cr.cast[DType.uint64]())] if (cr >= Int32(0)) else Int32(1))
            var __cp10 = rt_addr(this[].avg_[].link_velocity[].a[Int(uj_2)])
            __cp10[] = (__cp10[] + ((F_link__getVelocity(xs, q, d, nb) * du[].length) * dir).cast[DType.float32]())
            var __cp11 = rt_addr(this[].avg_[].link_capacity[].a[Int(uj_2)])
            __cp11[] = (__cp11[] + F_link__getCapacity(xs, d).cast[DType.float32]())
        else:
            this[].avg_[].link_capacity[].a[Int(uj_2)] = (this[].ctx_[].links[].setting[].a[Int(uj_2)].cast[DType.float32]() * (this[].avg_[].n_steps + Int32(1)).cast[DType.float32]())
        j_2 = (j_2 + Int32(1))
    this[].avg_[].n_steps = (this[].avg_[].n_steps + Int32(1))

def T_SWMMEngine__applyAvgResults(this: Ref[T_SWMMEngine], var snap: Ref[T_SimulationSnapshot]) raises:
    if (this[].avg_[].n_steps <= Int32(0)):
        return
    var n: Float32 = this[].avg_[].n_steps.cast[DType.float32]()
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_nodes(this[].ctx_)):
        var uj: UInt64 = j.cast[DType.uint64]()
        snap[].nodes[].depth[].a[Int(uj)] = (this[].avg_[].node_depth[].a[Int(uj)] / n).cast[DType.float64]()
        snap[].nodes[].head[].a[Int(uj)] = (this[].avg_[].node_head[].a[Int(uj)] / n).cast[DType.float64]()
        snap[].nodes[].volume[].a[Int(uj)] = (this[].avg_[].node_volume[].a[Int(uj)] / n).cast[DType.float64]()
        snap[].nodes[].lateral_inflow[].a[Int(uj)] = (this[].avg_[].node_lat_inflow[].a[Int(uj)] / n).cast[DType.float64]()
        snap[].nodes[].total_inflow[].a[Int(uj)] = (this[].avg_[].node_total_inflow[].a[Int(uj)] / n).cast[DType.float64]()
        snap[].nodes[].overflow[].a[Int(uj)] = (this[].avg_[].node_overflow[].a[Int(uj)] / n).cast[DType.float64]()
        j = (j + Int32(1))
    var j_2: Int32 = Int32(0)
    while (j_2 < T_SimulationContext__n_links(this[].ctx_)):
        var uj_2: UInt64 = j_2.cast[DType.uint64]()
        snap[].links[].flow[].a[Int(uj_2)] = (this[].avg_[].link_flow[].a[Int(uj_2)] / n).cast[DType.float64]()
        snap[].links[].depth[].a[Int(uj_2)] = (this[].avg_[].link_depth[].a[Int(uj_2)] / n).cast[DType.float64]()
        snap[].links[].velocity[].a[Int(uj_2)] = (this[].avg_[].link_velocity[].a[Int(uj_2)] / n).cast[DType.float64]()
        snap[].links[].volume[].a[Int(uj_2)] = (this[].avg_[].link_volume[].a[Int(uj_2)] / n).cast[DType.float64]()
        snap[].links[].capacity[].a[Int(uj_2)] = (this[].avg_[].link_capacity[].a[Int(uj_2)] / n).cast[DType.float64]()
        j_2 = (j_2 + Int32(1))
    T_SWMMEngine_AvgAccumulator__reset(this[].avg_)

def T_SWMMEngine__applyForcings(this: Ref[T_SWMMEngine], var dt: Float64) raises:
    var f: Ref[T_ForcingData] = this[].ctx_[].forcing
    var g: Int32 = Int32(0)
    while (g < T_SimulationContext__n_gages(this[].ctx_)):
        var ug: UInt64 = g.cast[DType.uint64]()
        if (this[].ctx_[].options[].ignore_rainfall and (f[].gage_rainfall_mode[].a[Int(ug)] != T_ForcingMode__NONE)):
            this[].ctx_[].gages[].rainfall[].a[Int(ug)] = Float64(0.0)
            g = (g + Int32(1))
            continue
        if (f[].gage_rainfall_mode[].a[Int(ug)] == T_ForcingMode__OVERRIDE):
            this[].ctx_[].gages[].rainfall[].a[Int(ug)] = f[].gage_rainfall_value[].a[Int(ug)]
        elif (f[].gage_rainfall_mode[].a[Int(ug)] == T_ForcingMode__ADD):
            this[].ctx_[].gages[].rainfall[].a[Int(ug)] = (F_gage__getReportRainfall(this[].ctx_, g, this[].ctx_[].current_date) + f[].gage_rainfall_value[].a[Int(ug)])
        g = (g + Int32(1))
    var j: Int32 = Int32(0)
    while (j < T_SimulationContext__n_links(this[].ctx_)):
        var uj: UInt64 = j.cast[DType.uint64]()
        if (f[].link_setting_mode[].a[Int(uj)] == T_ForcingMode__OVERRIDE):
            this[].ctx_[].links[].setting[].a[Int(uj)] = f[].link_setting_value[].a[Int(uj)]
            this[].ctx_[].links[].target_setting[].a[Int(uj)] = f[].link_setting_value[].a[Int(uj)]
        elif (f[].link_setting_mode[].a[Int(uj)] == T_ForcingMode__ADD):
            var __cp1 = rt_addr(this[].ctx_[].links[].setting[].a[Int(uj)])
            __cp1[] = (__cp1[] + f[].link_setting_value[].a[Int(uj)])
            this[].ctx_[].links[].target_setting[].a[Int(uj)] = this[].ctx_[].links[].setting[].a[Int(uj)]
        j = (j + Int32(1))
    var j_2: Int32 = Int32(0)
    while (j_2 < T_SimulationContext__n_links(this[].ctx_)):
        var uj_2: UInt64 = j_2.cast[DType.uint64]()
        if (f[].link_flow_mode[].a[Int(uj_2)] == T_ForcingMode__OVERRIDE):
            this[].ctx_[].links[].flow[].a[Int(uj_2)] = f[].link_flow_value[].a[Int(uj_2)]
        elif (f[].link_flow_mode[].a[Int(uj_2)] == T_ForcingMode__ADD):
            var __cp2 = rt_addr(this[].ctx_[].links[].flow[].a[Int(uj_2)])
            __cp2[] = (__cp2[] + f[].link_flow_value[].a[Int(uj_2)])
        j_2 = (j_2 + Int32(1))
    if (this[].ctx_[].options[].heat_transport and (this[].ctx_[].heat_state[].node_temp[].size() == T_SimulationContext__n_nodes(this[].ctx_).cast[DType.uint64]())):
        var i: Int32 = Int32(0)
        while (i < T_SimulationContext__n_nodes(this[].ctx_)):
            var u: UInt64 = i.cast[DType.uint64]()
            if (u >= f[].node_temperature_mode[].size()):
                break
            if (f[].node_temperature_mode[].a[Int(u)] == T_ForcingMode__OVERRIDE):
