def F_inlet__getGutterAreaRatio(var g: Ref[T_inlet_Geom], var Wg: Float64, var A_: Float64) raises -> Float64:
    if (Wg >= g[].w):
        return Float64(1.0)
    if (g[].t <= Wg):
        return Float64(1.0)
    if (g[].t <= g[].w):
        return (Wg / g[].t)
    var As: Float64 = (((Float64(0.5) * (g[].t - g[].w)) * (g[].t - g[].w)) * g[].sx)
    var Ag: Float64 = (Wg * (((g[].t * g[].sx) + g[].a) - ((Wg * g[].sw) / Float64(2.0))))
    return (Ag / (A_ - As))

