            var n2: Int32 = links[].node2[].a[Int(uj)]
            if (n1 >= Int32(0)):
                this[].aa_skip_[].a[Int(n1.cast[DType.uint64]())] = UInt8(1)
            if (n2 >= Int32(0)):
                this[].aa_skip_[].a[Int(n2.cast[DType.uint64]())] = UInt8(1)
            ci = (ci + Int32(1))
    if (this[].surcharge_method == T_dynwave_SurchargeMethod__DYNAMIC_SLOT):
        var ci_2: Int32 = Int32(0)
