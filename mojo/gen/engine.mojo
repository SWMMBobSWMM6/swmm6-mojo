def T_ForcingData__elemSlot(var k: T_HeatElemKind) raises -> Int32:
    if (k == T_HeatElemKind__LINK):
        return Int32(0)
    if (k == T_HeatElemKind__NODE):
        return Int32(1)
    return Int32(-1)

