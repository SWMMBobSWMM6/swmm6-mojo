        if (this[].soa_[].host_node[].a[Int(ui)] >= Int32(0)):
            if ((up >= Int32(0)) and (links[].node2[].a[Int(up.cast[DType.uint64]())] == host)):
                q = (q + M.max_(Float64(0.0), links[].flow[].a[Int(up.cast[DType.uint64]())]))
