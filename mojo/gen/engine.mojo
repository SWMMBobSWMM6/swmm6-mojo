    this[].next_sequence_ = (this[].next_sequence_ + Int32(1))
    var rc: Int32 = T_PluginFactory__update_all(this[].factory_, snap)
    if (rc != Int32(0)):
        this[].last_error_[].v = rc
    this[].tasks_completed_[].v = (this[].tasks_completed_[].v + Int32(1))

def T_IOThread__stop(this: Ref[T_IOThread]) raises:
    this[].stop_flag_[].v = True
    this[].running_[].v = False

def T_IOThread__flush(this: Ref[T_IOThread]) raises -> Int32:
    return T_IOThread__last_error(this)

def T_IOThread__run(this: Ref[T_IOThread]) raises:
    pass

