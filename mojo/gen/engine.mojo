def F_threadinfo__resolveRequested(var requested: Int32, var what: CPtr, var warnings: Ref[Vec[Ref[Str]]]) raises -> Int32:
    var omp_max: Int32 = F_threadinfo__ompMaxThreads()
    if (requested <= Int32(0)):
        return omp_max
    var nt: Int32 = requested
    if (not (rt_box(warnings) != Obj())):
        return nt
    var buf: CPtr = R.Buf(Int32(512))
    var logical: Int32 = F_threadinfo__logicalCpus()
    var reserved: Int32 = F_threadinfo__hostReservedThreads()
    if ((logical > Int32(0)) and ((nt + reserved) > logical)):
        if (reserved > Int32(0)):
            _ = R.snprintf(buf, UInt64(512), rt_lit("THREADS = %d plus the %d threads the host application reserves for itself exceed the %d logical processors on this machine (%s). The run is oversubscribed and is likely to be slower; active spin-wait is disabled for this run."), A(nt), A(reserved), A(logical), A(what))
        else:
            _ = R.snprintf(buf, UInt64(512), rt_lit("THREADS = %d exceeds the %d logical processors on this machine (%s). The run will be oversubscribed and is likely to be slower; active spin-wait is disabled for this run."), A(nt), A(logical), A(what))
        _ = warnings[].emplace_back(Str.fromCPtr(buf))[]
    elif (nt > omp_max):
        _ = R.snprintf(buf, UInt64(512), rt_lit("THREADS = %d exceeds the OpenMP limit of %d in this process (OMP_NUM_THREADS / OMP_THREAD_LIMIT / CPU affinity) for the %s; requesting %d anyway."), A(nt), A(omp_max), A(what), A(nt))
        _ = warnings[].emplace_back(Str.fromCPtr(buf))[]
    return nt

def F_threadinfo__dwThreads(var requested: Int32, var n_conduits: Int32, var warnings: Ref[Vec[Ref[Str]]]) raises -> Int32:
