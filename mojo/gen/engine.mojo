def T_inlet_InletSolver__adjustQualInflows(this: Ref[T_inlet_InletSolver], var ctx: Ref[T_SimulationContext], var dt: Float64) raises:
    var ni: Int32 = this[].soa_[].count
    if (ni == Int32(0)):
        return
    var np: Int32 = T_SimulationContext__n_pollutants(ctx)
    if (np == Int32(0)):
        return
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var nn: Int32 = T_SimulationContext__n_nodes(ctx)
    var unp: UInt64 = np.cast[DType.uint64]()
    var ii: Int32 = Int32(0)
    while (ii < ni):
        var ui: UInt64 = ii.cast[DType.uint64]()
        var bypass: Int32 = this[].soa_[].bypass_node[].a[Int(ui)]
        var capture: Int32 = this[].soa_[].node_idx[].a[Int(ui)]
        if ((bypass < Int32(0)) or (bypass >= nn)):
            ii = (ii + Int32(1))
            continue
        if ((capture < Int32(0)) or (capture >= nn)):
            ii = (ii + Int32(1))
            continue
        var qNet: Float64 = (this[].soa_[].flow_capture[].a[Int(ui)] - this[].soa_[].backflow[].a[Int(ui)])
        var ub: UInt64 = bypass.cast[DType.uint64]()
        var uc: UInt64 = capture.cast[DType.uint64]()
        if (qNet > Float64(0.0)):
            var __cp1 = rt_addr(nodes[].qual_vol_in[].a[Int(uc)])
            __cp1[] = (__cp1[] + (qNet * dt))
            var p: UInt64 = UInt64(0)
            while (p < unp):
                var nd_idx: UInt64 = ((uc * unp) + p)
                var by_idx: UInt64 = ((ub * unp) + p)
                if ((nd_idx < nodes[].qual_mass_in[].size()) and (by_idx < nodes[].conc_old[].size())):
                    var __cp2 = rt_addr(nodes[].qual_mass_in[].a[Int(nd_idx)])
                    __cp2[] = (__cp2[] + (qNet * nodes[].conc_old[].a[Int(by_idx)]))
                p = (p + UInt64(1))
        elif (qNet < Float64(0.0)):
            var qBkf: Float64 = (-qNet)
            var __cp3 = rt_addr(nodes[].qual_vol_in[].a[Int(ub)])
            __cp3[] = (__cp3[] + (qBkf * dt))
            var p_2: UInt64 = UInt64(0)
            while (p_2 < unp):
                var nd_idx_2: UInt64 = ((ub * unp) + p_2)
                var cp_idx: UInt64 = ((uc * unp) + p_2)
                if ((nd_idx_2 < nodes[].qual_mass_in[].size()) and (cp_idx < nodes[].conc_old[].size())):
                    var __cp4 = rt_addr(nodes[].qual_mass_in[].a[Int(nd_idx_2)])
                    __cp4[] = (__cp4[] + (qBkf * nodes[].conc_old[].a[Int(cp_idx)]))
                p_2 = (p_2 + UInt64(1))
        ii = (ii + Int32(1))

def T_inlet_InletSolver__adjustFloodingTotals(this: Ref[T_inlet_InletSolver], var ctx: Ref[T_SimulationContext], var dt: Float64) raises:
    var ni: Int32 = this[].soa_[].count
    if (ni == Int32(0)):
        return
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var mb: Ref[T_SimulationContext_MassBalance] = ctx[].mass_balance
    var nn: Int32 = T_SimulationContext__n_nodes(ctx)
    var j: Int32 = Int32(0)
    while (j < nn):
        var uj: UInt64 = j.cast[DType.uint64]()
        if ((uj >= this[].is_capture_node_[].size()) or (not (this[].is_capture_node_[].a[Int(uj)].cast[DType.int32]() != Int32(0)))):
            j = (j + Int32(1))
            continue
        var q: Float64 = nodes[].overflow[].a[Int(uj)]
        if (q <= Float64(0.0)):
            j = (j + Int32(1))
            continue
        mb[].routing_flooding = (mb[].routing_flooding - (q * dt))
        mb[].step_flooding = (mb[].step_flooding - q)
        var np: Int32 = T_SimulationContext__n_pollutants(ctx)
        var p: Int32 = Int32(0)
        while (p < np):
            var up: UInt64 = p.cast[DType.uint64]()
            var __cp1 = rt_addr(mb[].qual_routing_flood[].a[Int(up)])
            __cp1[] = (__cp1[] - ((q * nodes[].conc[].a[Int(((uj * np.cast[DType.uint64]()) + up))]) * dt))
            p = (p + Int32(1))
        j = (j + Int32(1))

def T_inlet_InletSolver__gatherStats(this: Ref[T_inlet_InletSolver], var ctx: Ref[T_SimulationContext]) raises:
    var n: Int32 = M.min_(this[].soa_[].count, T_InletUsageStore__count(ctx[].inlet_usages))
    if (n <= Int32(0)):
        return
    T_InletUsageStore__resize_stats(ctx[].inlet_usages, T_InletUsageStore__count(ctx[].inlet_usages))
    T_SimulationContext_InletDiag__resize(ctx[].inlet_diag, n)
    var i: Int32 = Int32(0)
    while (i < n):
        var ui: UInt64 = i.cast[DType.uint64]()
        ctx[].inlet_usages[].stat_capture_vol[].a[Int(ui)] = this[].soa_[].stat_capture_vol[].a[Int(ui)]
        ctx[].inlet_usages[].stat_bypass_vol[].a[Int(ui)] = this[].soa_[].stat_bypass_vol[].a[Int(ui)]
        ctx[].inlet_usages[].stat_backflow_vol[].a[Int(ui)] = this[].soa_[].stat_backflow_vol[].a[Int(ui)]
        ctx[].inlet_usages[].stat_peak_flow[].a[Int(ui)] = this[].soa_[].stat_peak_flow[].a[Int(ui)]
        var dg: Ref[T_SimulationContext_InletDiag] = ctx[].inlet_diag
        dg[].host_node[].a[Int(ui)] = this[].soa_[].host_node[].a[Int(ui)]
        dg[].up_link[].a[Int(ui)] = this[].soa_[].up_link[].a[Int(ui)]
        dg[].is_sag[].a[Int(ui)] = this[].soa_[].is_sag[].a[Int(ui)]
        dg[].num_inlets[].a[Int(ui)] = this[].soa_[].num_inlets[].a[Int(ui)]
        dg[].flow_periods[].a[Int(ui)] = this[].soa_[].flow_periods[].a[Int(ui)]
        dg[].capture_periods[].a[Int(ui)] = this[].soa_[].capture_periods[].a[Int(ui)]
        dg[].backflow_periods[].a[Int(ui)] = this[].soa_[].backflow_periods[].a[Int(ui)]
        dg[].peak_flow[].a[Int(ui)] = this[].soa_[].peak_flow[].a[Int(ui)]
        dg[].peak_flow_capture[].a[Int(ui)] = this[].soa_[].peak_flow_capture[].a[Int(ui)]
        dg[].avg_flow_capture[].a[Int(ui)] = this[].soa_[].avg_flow_capture[].a[Int(ui)]
        dg[].bypass_freq[].a[Int(ui)] = this[].soa_[].bypass_freq[].a[Int(ui)]
        i = (i + Int32(1))

def T_inlet_InletSolver__geomOf(this: Ref[T_inlet_InletSolver], var ctx: Ref[T_SimulationContext], var ii: Int32, var xs: Ref[T_XSectParams]) raises -> Ref[T_inlet_Geom]:
    var ui: UInt64 = ii.cast[DType.uint64]()
    var g: Ref[T_inlet_Geom] = T_inlet_Geom__new()
    g[].sx = this[].soa_[].sx[].a[Int(ui)]
    g[].sl = this[].soa_[].slope[].a[Int(ui)]
    g[].a = this[].soa_[].gutter_depression[].a[Int(ui)]
    g[].w = this[].soa_[].gutter_width[].a[Int(ui)]
    g[].n = this[].soa_[].road_roughness[].a[Int(ui)]
    g[].nsides = this[].soa_[].n_sides[].a[Int(ui)]
    g[].t_crown = this[].soa_[].t_crown[].a[Int(ui)]
    g[].qfactor = this[].soa_[].flow_factor[].a[Int(ui)]
    g[].xs = xs
    if ((this[].soa_[].local_depress[].a[Int(ui)] * this[].soa_[].local_width[].a[Int(ui)]) > Float64(0.0)):
        g[].a = (g[].a + this[].soa_[].local_depress[].a[Int(ui)])
        g[].w = this[].soa_[].local_width[].a[Int(ui)]
    g[].sw = ((g[].sx + (g[].a / g[].w)) if ((g[].w * g[].a) > Float64(0.0)) else g[].sx)
    g[].beta = (((Float64(1.486) * Math.Sqrt(g[].sl)) / g[].n) if ((g[].n > Float64(0.0)) and (g[].sl > Float64(0.0))) else Float64(0.0))
    return T_inlet_Geom__MoveNew(g)

