def T_SubcatchData__MoveNew(var s: Ref[T_SubcatchData]) raises -> Ref[T_SubcatchData]:
    var o: Ref[T_SubcatchData] = T_SubcatchData__raw()
    T_SubcatchData__MoveFrom(o, s)
    return o

def T_SubcatchData__resize_total_load(this: Ref[T_SubcatchData], var n_sc: Int32, var n_poll: Int32) raises:
    this[].total_load_n_pollutants = n_poll
    this[].total_load[].assign((n_sc.cast[DType.uint64]() * n_poll.cast[DType.uint64]()), Float64(0.0))

def T_SubcatchData__count(this: Ref[T_SubcatchData]) raises -> Int32:
    return this[].area[].size().cast[DType.int32]()

def T_SubcatchData__resize(this: Ref[T_SubcatchData], var n: Int32) raises:
    var un: UInt64 = n.cast[DType.uint64]()
    this[].outlet_node[].assign(un, Int32(-1))
    this[].outlet_subcatch[].assign(un, Int32(-1))
    this[].outlet_name[].resize(un)
    this[].snowpack_name[].resize(un)
    this[].gage_name[].resize(un)
    this[].gage[].assign(un, Int32(-1))
    this[].area[].assign(un, Float64(0.0))
    this[].width[].assign(un, Float64(0.0))
    this[].slope[].assign(un, Float64(0.0))
    this[].curb_length[].assign(un, Float64(0.0))
    this[].rain_scale_factor[].assign(un, Float64(1.0))
    this[].snow_scale_factor[].assign(un, Float64(1.0))
    this[].frac_imperv[].assign(un, Float64(0.0))
    this[].frac_imperv_no_store[].assign(un, Float64(0.0))
