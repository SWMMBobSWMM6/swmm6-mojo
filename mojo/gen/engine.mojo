def F_transport_heat__bedCouplingFromContact(var ctx: Ref[T_SimulationContext], var sc: Ref[T_SedimentConfig], var bed_m2: Float64, var vol_ft3: Float64, var t_gr: Float64) raises -> Ref[T_transport_heat_BedCoupling]:
    var g: Ref[T_transport_heat_BedCoupling] = T_transport_heat_BedCoupling__new()
    if ((not (bed_m2 > Float64(0.0))) or (not (vol_ft3 > Float64(0.0)))):
        return T_transport_heat_BedCoupling__MoveNew(g)
    var rho_cp_s: Float64 = (sc[].sed_density * sc[].sed_specific_heat)
    var y_bed: Float64 = sc[].bed_thickness
    var y_gr: Float64 = sc[].ground_depth
    if (not (y_bed > Float64(0.0))):
        return T_transport_heat_BedCoupling__MoveNew(g)
    var k_eff: Float64 = (sc[].thermal_diffusivity * rho_cp_s)
    var g_cond: Float64 = ((k_eff * bed_m2) / y_bed)
    var g_adv: Float64 = (((ctx[].options[].water_density * ctx[].options[].water_specific_heat) * sc[].hyporheic_velocity) * bed_m2)
    g[].g_wb = (g_cond + g_adv)
    g[].g_bg = (((k_eff * bed_m2) / y_gr) if (y_gr > Float64(0.0)) else Float64(0.0))
    g[].c_w = (((ctx[].options[].water_density * ctx[].options[].water_specific_heat) * vol_ft3) * gs()[].G_F_transport_heat__kCuFtToCuM)
    g[].c_b = ((rho_cp_s * bed_m2) * y_bed)
    g[].t_gr = t_gr
    return T_transport_heat_BedCoupling__MoveNew(g)

def F_transport_heat__groundTempFor(var ctx: Ref[T_SimulationContext], var sc: Ref[T_SedimentConfig], var t_gr_global: Float64) raises -> Float64:
