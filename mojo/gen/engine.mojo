            if (disc_2 < Float64(0.0)):
                disc_2 = Float64(0.0)
            depth_2 = (tbl[].x[].a[Int(last.cast[DType.uint64]())] + (((-a1_ext) + Math.Sqrt(disc_2)) / s_2))
