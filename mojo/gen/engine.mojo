def T_OutfallData____CopyFrom_OutfallData(this: Ref[T_OutfallData], var s: Ref[T_OutfallData]) raises:
    this[].node_idx = (s[].node_idx[].Clone() if not s[].node_idx.isnull() else Ref[Vec[Int32]]())
