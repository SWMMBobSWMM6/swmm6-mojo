        gs()[].G_T_iface_InterfaceManager__S_flow_words_16 = Ary[CPtr].of(rt_lit("CFS"), rt_lit("GPM"), rt_lit("MGD"), rt_lit("CMS"), rt_lit("LPS"), rt_lit("MLD"))
        gs()[].G_T_iface_InterfaceManager__S_flow_words_16_done = True
    var fu: Int32 = ctx[].options[].flow_units
    if ((fu < Int32(0)) or (fu > Int32(5))):
        fu = Int32(0)
    _ = R.fprintf(this[].outfile_, rt_lit("\nFLOW %s"), A(Ptr[CPtr](gs()[].G_T_iface_InterfaceManager__S_flow_words_16, Int(Int64(0)))[Int(fu)]))
