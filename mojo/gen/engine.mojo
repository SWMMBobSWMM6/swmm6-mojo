def T_fv_ExplicitFvSolver__divergence(this: Ref[T_fv_ExplicitFvSolver], var d: Ref[T_fv_INetworkSolver_Divergence]) raises -> Bool:
    if (this[].div_link_ < Int32(0)):
        return False
    d[].link = this[].div_link_
    d[].value = this[].div_value_
    d[].what = this[].div_what_
    return True

