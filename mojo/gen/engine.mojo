    Algo.fill[Float64](this[].snow_melt_age_imperv[].begin(), this[].snow_melt_age_imperv[].end(), Float64(-1.0))
    Algo.fill[Float64](this[].snow_melt_age_perv[].begin(), this[].snow_melt_age_perv[].end(), Float64(-1.0))
    Algo.fill[Float64](this[].evap_loss[].begin(), this[].evap_loss[].end(), Float64(0.0))
    Algo.fill[Float64](this[].infil_loss[].begin(), this[].infil_loss[].end(), Float64(0.0))
    Algo.fill[Float64](this[].ponded_depth[].begin(), this[].ponded_depth[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_runoff[].begin(), this[].old_runoff[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_gw_flow[].begin(), this[].old_gw_flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].snow_depth[].begin(), this[].snow_depth[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_snow_depth[].begin(), this[].old_snow_depth[].end(), Float64(0.0))
    Algo.fill[Float64](this[].lid_drain_flow[].begin(), this[].lid_drain_flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_lid_drain_flow[].begin(), this[].old_lid_drain_flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].runon_inflow[].begin(), this[].runon_inflow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].old_runon_inflow[].begin(), this[].old_runon_inflow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].runon_rate[].begin(), this[].runon_rate[].end(), Float64(0.0))
    Algo.fill[Float64](this[].gw_sw_head[].begin(), this[].gw_sw_head[].end(), Float64(0.0))
    Algo.fill[Float64](this[].gw_node_avail_flow[].begin(), this[].gw_node_avail_flow[].end(), Float64(0.0))
    Algo.fill[Float64](this[].washoff_load[].begin(), this[].washoff_load[].end(), Float64(0.0))
