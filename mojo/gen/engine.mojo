def F_infil__horton_getInfil(var state: Ref[T_HortonState], var precip: Float64, var depth: Float64, var dt: Float64) raises -> Float64:
    var ia: Float64 = (precip + (depth / dt))
    var f0: Float64 = state[].f0
    var fmin: Float64 = state[].fmin
    var df: Float64 = (f0 - fmin)
    var kd: Float64 = state[].decay
    var Fmax: Float64 = state[].Fmax
    var tp: Float64 = state[].tp
    var kr: Float64 = state[].regen
    if (((df < Float64(0.0)) or (kd < Float64(0.0))) or (kr < Float64(0.0))):
        return Float64(0.0)
    if ((df == Float64(0.0)) or (kd == Float64(0.0))):
        var fp: Float64 = f0
        fp = M.min_(fp, ia)
        return M.max_(Float64(0.0), fp)
    var fp_2: Float64 = Float64(0.0)
    var tlim: Float64 = (Float64(16.0) / kd)
    if (ia > gs()[].G_F_infil__TINY_Infiltration):
        var t1: Float64 = (tp + dt)
        var Fp: Float64 = Float64(0.0)
        var F1: Float64 = Float64(0.0)
        if (tp >= tlim):
            Fp = ((fmin * tp) + (df / kd))
            F1 = (Fp + (fmin * dt))
        else:
            Fp = ((fmin * tp) + ((df / kd) * (Float64(1.0) - Math.Exp(((-kd) * tp)))))
            F1 = ((fmin * t1) + ((df / kd) * (Float64(1.0) - Math.Exp(((-kd) * t1)))))
        fp_2 = ((F1 - Fp) / dt)
        fp_2 = (fp_2 if (fp_2 >= fmin) else fmin)
        fp_2 = M.min_(fp_2, ia)
        if (t1 > tlim):
            tp = t1
        elif (fp_2 < ia):
            tp = t1
        else:
            F1 = (Fp + (fp_2 * dt))
            tp = (tp + (dt / Float64(2.0)))
            var iter_: Int32 = Int32(0)
            while (iter_ < Int32(20)):
                var kt: Float64 = (Float64(60.0) if (Float64(60.0) <= (kd * tp)) else (kd * tp))
                var ex: Float64 = Math.Exp((-kt))
                var FF: Float64 = (((fmin * tp) + ((df / kd) * (Float64(1.0) - ex))) - F1)
                var FF1: Float64 = (fmin + (df * ex))
                var r: Float64 = (FF / FF1)
                tp = (tp - r)
                if (Math.Abs(r) <= (Float64(0.001) * dt)):
                    break
                iter_ = (iter_ + Int32(1))
        if (Fmax > Float64(0.0)):
            if ((state[].Fe + (fp_2 * dt)) > Fmax):
                fp_2 = ((Fmax - state[].Fe) / dt)
            fp_2 = M.max_(fp_2, Float64(0.0))
            state[].Fe = (state[].Fe + (fp_2 * dt))
    elif (kr > Float64(0.0)):
        var r_2: Float64 = Math.Exp(((-kr) * dt))
        tp = (Float64(1.0) - Math.Exp(((-kd) * tp)))
        tp = ((-Math.Log((Float64(1.0) - (r_2 * tp)))) / kd)
        if (Fmax > Float64(0.0)):
            state[].Fe = ((fmin * tp) + ((df / kd) * (Float64(1.0) - Math.Exp(((-kd) * tp)))))
    state[].tp = tp
    return fp_2

def F_infil__modHorton_getInfil(var state: Ref[T_HortonState], var precip: Float64, var depth: Float64, var dt: Float64) raises -> Float64:
    var f: Float64 = Float64(0.0)
    var f0: Float64 = state[].f0
    var fmin: Float64 = state[].fmin
    var df: Float64 = (f0 - fmin)
    var kd: Float64 = state[].decay
    var kr: Float64 = state[].regen
    if (((df < Float64(0.0)) or (kd < Float64(0.0))) or (kr < Float64(0.0))):
        return Float64(0.0)
    if ((df == Float64(0.0)) or (kd == Float64(0.0))):
        var fp: Float64 = f0
        var fa: Float64 = (precip + (depth / dt))
        fp = M.min_(fp, fa)
        return M.max_(Float64(0.0), fp)
    var fa_2: Float64 = (precip + (depth / dt))
    if (fa_2 > gs()[].G_F_infil__TINY_Infiltration):
        if ((state[].Fmax > Float64(0.0)) and (state[].Fe >= state[].Fmax)):
            return Float64(0.0)
        var fp_2: Float64 = (f0 - (kd * state[].Fe))
        fp_2 = M.max_(fp_2, fmin)
        f = M.min_(fa_2, fp_2)
        if (state[].Fmax > Float64(0.0)):
            if ((state[].Fmh + (f * dt)) > state[].Fmax):
                f = ((state[].Fmax - state[].Fmh) / dt)
            f = M.max_(f, Float64(0.0))
            state[].Fmh = (state[].Fmh + (f * dt))
        state[].Fe = (state[].Fe + (M.max_((f - fmin), Float64(0.0)) * dt))
        if (state[].Fmax > Float64(0.0)):
            state[].Fe = M.min_(state[].Fe, state[].Fmax)
    elif (kr > Float64(0.0)):
        var decay_factor: Float64 = Math.Exp(((-kr) * dt))
        state[].Fe = (state[].Fe * decay_factor)
        state[].Fe = M.max_(state[].Fe, Float64(0.0))
        state[].Fmh = (state[].Fmh * decay_factor)
        state[].Fmh = M.max_(state[].Fmh, Float64(0.0))
    return f

def F_infil__grnampt_getInfil(var state: Ref[T_GreenAmptState], var precip: Float64, var depth: Float64, var dt: Float64, var model_type: T_InfilModel, var infil_factor: Float64, var recovery_factor: Float64) raises -> Float64:
    var sqrt_if: Float64 = Math.Sqrt(infil_factor)
    var Fumax: Float64 = ((state[].IMDmax * state[].Lu) * sqrt_if)
    var ks: Float64 = (state[].Ks * infil_factor)
    var lu: Float64 = (state[].Lu * sqrt_if)
    state[].T = (state[].T - dt)
    if state[].saturated:
        return F_infil__grnampt_getSatInfil_Infiltration(state, dt, precip, depth, ks, lu, Fumax, recovery_factor)
    return F_infil__grnampt_getUnsatInfil_Infiltration(state, dt, precip, depth, model_type, ks, lu, Fumax, recovery_factor)

def F_infil__curvenum_getInfil(var state: Ref[T_CurveNumState], var precip: Float64, var depth: Float64, var dt: Float64, var recovery_factor: Float64) raises -> Float64:
    var MIN_TOTAL_DEPTH: Float64 = Float64(0.004167)
    var fa: Float64 = (precip + (depth / dt))
    var f1: Float64 = Float64(0.0)
    if (precip > gs()[].G_F_infil__TINY_Infiltration):
        if (state[].T >= state[].Tmax):
            state[].P_ = Float64(0.0)
            state[].F = Float64(0.0)
            state[].f = Float64(0.0)
            state[].Se = state[].S
        state[].T = Float64(0.0)
        state[].P_ = (state[].P_ + (precip * dt))
        var F1: Float64 = (state[].P_ * (Float64(1.0) - (state[].P_ / (state[].P_ + state[].Se))))
        f1 = ((F1 - state[].F) / dt)
        if ((f1 < Float64(0.0)) or (state[].S <= Float64(0.0))):
            f1 = Float64(0.0)
    elif ((depth > MIN_TOTAL_DEPTH) and (state[].S > Float64(0.0))):
        f1 = state[].f
        if ((f1 * dt) > state[].S):
            f1 = (state[].S / dt)
    else:
        state[].T = (state[].T + dt)
    if (f1 > Float64(0.0)):
        f1 = M.min_(f1, fa)
        f1 = M.max_(f1, Float64(0.0))
        state[].F = (state[].F + (f1 * dt))
        if (state[].regen > Float64(0.0)):
            state[].S = (state[].S - (f1 * dt))
            state[].S = M.max_(state[].S, Float64(0.0))
    else:
        state[].S = (state[].S + (((state[].regen * state[].Smax) * dt) * recovery_factor))
        state[].S = M.min_(state[].S, state[].Smax)
    state[].f = f1
    return f1

def F_infil__constant_getInfil(var rate_ftsec: Float64, var precip: Float64, var depth: Float64, var dt: Float64) raises -> Float64:
    var ia: Float64 = (precip + (depth / dt))
    return M.max_(Float64(0.0), M.min_(rate_ftsec, ia))

def F_infil__horton_init(var state: Ref[T_HortonState], var f0: Float64, var fmin: Float64, var decay: Float64, var regen: Float64, var Fmax: Float64, var opts: Ref[T_SimulationOptions]) raises:
    var ucf_rain: Float64 = F_ucf__UCF(Int32(0), opts)
    var ucf_depth: Float64 = F_ucf__UCF(Int32(1), opts)
    state[].f0 = (f0 / ucf_rain)
    state[].fmin = (fmin / ucf_rain)
    state[].decay = (decay / Float64(3600.0))
    state[].regen = ((((-Math.Log(Float64(0.020000000000000018))) / regen) / gs()[].G_F_ucf__SEC_PER_DAY_UnitConversion) if (regen > Float64(0.0)) else Float64(0.0))
    state[].Fmax = ((Fmax / ucf_depth) if (Fmax > Float64(0.0)) else Float64(0.0))
    state[].tp = Float64(0.0)
    state[].Fe = Float64(0.0)

def F_infil__grnampt_init(var state: Ref[T_GreenAmptState], var S: Float64, var Ks: Float64, var IMD: Float64, var opts: Ref[T_SimulationOptions]) raises:
    var ucf_rain: Float64 = F_ucf__UCF(Int32(0), opts)
    var ucf_depth: Float64 = F_ucf__UCF(Int32(1), opts)
    state[].S = (S / ucf_depth)
    state[].Ks = (Ks / ucf_rain)
    state[].IMDmax = IMD
    state[].IMD = IMD
    state[].F = Float64(0.0)
    var ksat: Float64 = ((state[].Ks * Float64(12.0)) * Float64(3600.0))
    state[].Lu = ((Float64(4.0) * Math.Sqrt(ksat)) / Float64(12.0))
    state[].Fumax = (state[].IMDmax * state[].Lu)
    state[].Fu = Float64(0.0)
    state[].saturated = False

def F_infil__curvenum_init(var state: Ref[T_CurveNumState], var CN: Float64, var regen_days: Float64) raises:
    CN = M.max_(CN, Float64(10.0))
    CN = M.min_(CN, Float64(99.0))
    state[].Smax = (((Float64(1000.0) / CN) - Float64(10.0)) / Float64(12.0))
    state[].S = state[].Smax
    state[].Se = state[].Smax
    state[].P_ = Float64(0.0)
    state[].F = Float64(0.0)
    state[].f = Float64(0.0)
    var SEC_PER_DAY: Float64 = Float64(86400.0)
    state[].regen = ((Float64(1.0) / (regen_days * SEC_PER_DAY)) if (regen_days > Float64(0.0)) else Float64(0.0))
    state[].T = Float64(0.0)
    state[].Tmax = ((Float64(0.06) / state[].regen) if (state[].regen > Float64(0.0)) else Float64(10000000000.0))

def F_infil__grnampt_getF2_Infiltration(var f1: Float64, var c1: Float64, var ks: Float64, var ts: Float64) raises -> Float64:
    var f2: Float64 = f1
    var f2min: Float64 = (f1 + (ks * ts))
    if (c1 == Float64(0.0)):
        return f2min
    if ((ts < Float64(10.0)) and (f1 > (Float64(0.01) * c1))):
        f2 = (f1 + ((ks * (Float64(1.0) + (c1 / f1))) * ts))
        return M.max_(f2, f2min)
    var c2: Float64 = ((c1 * Math.Log((f1 + c1))) - (ks * ts))
    var i: Int32 = Int32(1)
    while (i <= Int32(20)):
        var df2: Float64 = ((((f2 - f1) - (c1 * Math.Log((f2 + c1)))) + c2) / (Float64(1.0) - (c1 / (f2 + c1))))
        if (Math.Abs(df2) < Float64(1e-05)):
            return M.max_(f2, f2min)
        f2 = (f2 - df2)
        i = (i + Int32(1))
    return f2min

def F_infil__grnampt_getSatInfil_Infiltration(var s: Ref[T_GreenAmptState], var tstep: Float64, var irate: Float64, var depth: Float64, var ks: Float64, var lu: Float64, var Fumax: Float64, var recovery_factor: Float64) raises -> Float64:
    var ia: Float64 = (irate + (depth / tstep))
    if (ia < gs()[].G_F_infil__TINY_Infiltration):
        return Float64(0.0)
    s[].T = ((Float64(5400.0) / lu) / recovery_factor)
    var c1: Float64 = ((s[].S + depth) * s[].IMD)
    var F2: Float64 = F_infil__grnampt_getF2_Infiltration(s[].F, c1, ks, tstep)
    var dF: Float64 = (F2 - s[].F)
    if (dF > (ia * tstep)):
        dF = (ia * tstep)
        s[].saturated = False
    s[].F = (s[].F + dF)
    s[].Fu = (s[].Fu + dF)
    s[].Fu = M.min_(s[].Fu, Fumax)
    return (dF / tstep)

def F_infil__grnampt_getUnsatInfil_Infiltration(var s: Ref[T_GreenAmptState], var tstep: Float64, var irate: Float64, var depth: Float64, var model_type: T_InfilModel, var ks: Float64, var lu: Float64, var Fumax: Float64, var recovery_factor: Float64) raises -> Float64:
    var ia: Float64 = (irate + (depth / tstep))
    if (ia < gs()[].G_F_infil__TINY_Infiltration):
        ia = Float64(0.0)
    if (ia == Float64(0.0)):
        if (s[].Fu <= Float64(0.0)):
            return Float64(0.0)
        var kr: Float64 = ((lu / Float64(90000.0)) * recovery_factor)
        var dF: Float64 = ((kr * Fumax) * tstep)
        s[].F = (s[].F - dF)
        s[].Fu = (s[].Fu - dF)
        if (s[].Fu <= Float64(0.0)):
            s[].Fu = Float64(0.0)
            s[].F = Float64(0.0)
            s[].IMD = s[].IMDmax
            return Float64(0.0)
        if (s[].T <= Float64(0.0)):
            s[].IMD = ((Fumax - s[].Fu) / lu)
            s[].F = Float64(0.0)
        return Float64(0.0)
    if (ia <= ks):
        var dF_2: Float64 = (ia * tstep)
        s[].F = (s[].F + dF_2)
        s[].Fu = (s[].Fu + dF_2)
        s[].Fu = M.min_(s[].Fu, Fumax)
        if ((model_type == T_InfilModel__GREEN_AMPT) and (s[].T <= Float64(0.0))):
            s[].IMD = ((Fumax - s[].Fu) / lu)
            s[].F = Float64(0.0)
        return ia
    s[].T = ((Float64(5400.0) / lu) / recovery_factor)
    var Fs: Float64 = (((ks * (s[].S + depth)) * s[].IMD) / (ia - ks))
    if (s[].F > Fs):
        s[].saturated = True
        return F_infil__grnampt_getSatInfil_Infiltration(s, tstep, irate, depth, ks, lu, Fumax, recovery_factor)
    if ((s[].F + (ia * tstep)) < Fs):
        var dF_3: Float64 = (ia * tstep)
        s[].F = (s[].F + dF_3)
        s[].Fu = (s[].Fu + dF_3)
        s[].Fu = M.min_(s[].Fu, Fumax)
        return ia
    var ts: Float64 = (tstep - ((Fs - s[].F) / ia))
    if (ts <= Float64(0.0)):
        ts = Float64(0.0)
    var c1: Float64 = ((s[].S + depth) * s[].IMD)
    var F2: Float64 = F_infil__grnampt_getF2_Infiltration(Fs, c1, ks, ts)
    if (F2 > (Fs + (ia * ts))):
        F2 = (Fs + (ia * ts))
    var dF_4: Float64 = (F2 - s[].F)
    s[].F = F2
    s[].Fu = (s[].Fu + dF_4)
    s[].Fu = M.min_(s[].Fu, Fumax)
    s[].saturated = True
    return (dF_4 / tstep)

