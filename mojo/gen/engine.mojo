def F_fv__advanceNetworkChecked(var solver: Ref[T_fv_INetworkSolver], var start: Float64, var target: Float64, var forcing: Ref[T_fv_FvStepForcing]) raises -> Float64:
    if (((not Dbl.IsFinite(start)) or (not Dbl.IsFinite(target))) or (target < start)):
        raise rt_throw(rt_exc_make(4, Str.fromCPtr(rt_lit("FV routing times must be finite and ordered."))))
    var reached: Float64 = T_fv_INetworkSolver__advance__v(solver, start, target, forcing)
    var tolerance: Float64 = (Float64(3.552713678800501e-15) * M.max_(Ary[Float64].of(Float64(1.0), Math.Abs(start), Math.Abs(target))))
    if (((not Dbl.IsFinite(reached)) or (reached < start)) or (Math.Abs((reached - target)) > tolerance)):
        raise rt_throw(rt_exc_make(3, Str.fromCPtr(rt_lit("FV backend did not reach the requested routing time; partial results were not published."))))
    return reached

