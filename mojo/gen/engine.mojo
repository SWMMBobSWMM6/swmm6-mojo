def F___table_lookup_cursor(var tbl: Ref[T_Table], var x_query: Float64) raises -> Float64:
    var n: Int32 = tbl[].x[].size().cast[DType.int32]()
    if (n == Int32(0)):
        return Float64(0.0)
    if (n == Int32(1)):
        return tbl[].y[].a[Int(UInt64(0))]
    if (x_query <= tbl[].x[].a[Int(UInt64(0))]):
        tbl[].cursor[].index = Int32(0)
        tbl[].cursor[].direction = Int32(1)
        return tbl[].y[].a[Int(UInt64(0))]
    if (x_query > tbl[].x[].a[Int((n - Int32(1)).cast[DType.uint64]())]):
        tbl[].cursor[].index = (n - Int32(1))
        tbl[].cursor[].direction = Int32(-1)
        return tbl[].y[].a[Int((n - Int32(1)).cast[DType.uint64]())]
    var idx: Int32 = M.clamp(tbl[].cursor[].index, Int32(0), (n - Int32(2)))
    while ((idx < (n - Int32(1))) and (tbl[].x[].a[Int((idx + Int32(1)).cast[DType.uint64]())] < x_query)):
        idx = (idx + Int32(1))
        tbl[].cursor[].direction = Int32(1)
    while ((idx > Int32(0)) and (tbl[].x[].a[Int(idx.cast[DType.uint64]())] >= x_query)):
        idx = (idx - Int32(1))
        tbl[].cursor[].direction = Int32(-1)
    tbl[].cursor[].index = idx
    var x1: Float64 = tbl[].x[].a[Int(idx.cast[DType.uint64]())]
    var y1: Float64 = tbl[].y[].a[Int(idx.cast[DType.uint64]())]
    var x2: Float64 = tbl[].x[].a[Int((idx + Int32(1)).cast[DType.uint64]())]
    var y2: Float64 = tbl[].y[].a[Int((idx + Int32(1)).cast[DType.uint64]())]
    var dx: Float64 = (x2 - x1)
    if (Math.Abs(dx) < Float64(1e-20)):
        return ((y1 + y2) / Float64(2.0))
    return (y1 + (((x_query - x1) * (y2 - y1)) / dx))

def F___table_tseries_lookup_cursor(var tbl: Ref[T_Table], var x_query: Float64) raises -> Float64:
    var n: Int32 = tbl[].x[].size().cast[DType.int32]()
    if (n == Int32(0)):
        return Float64(0.0)
    if (x_query <= tbl[].x[].a[Int(UInt64(0))]):
        tbl[].cursor[].index = Int32(0)
        tbl[].cursor[].direction = Int32(1)
        return (Float64(0.0) if (x_query < tbl[].x[].a[Int(UInt64(0))]) else tbl[].y[].a[Int(UInt64(0))])
    if (x_query >= tbl[].x[].a[Int((n - Int32(1)).cast[DType.uint64]())]):
        tbl[].cursor[].index = (n - Int32(1))
        tbl[].cursor[].direction = Int32(-1)
        return (Float64(0.0) if (x_query > tbl[].x[].a[Int((n - Int32(1)).cast[DType.uint64]())]) else tbl[].y[].a[Int((n - Int32(1)).cast[DType.uint64]())])
    return F___table_lookup_cursor(tbl, x_query)

def F___table_getStorageVolume(var tbl: Ref[T_Table], var depth: Float64) raises -> Float64:
    var n: Int32 = tbl[].x[].size().cast[DType.int32]()
    if ((n == Int32(0)) or (depth <= Float64(0.0))):
        return Float64(0.0)
    var x1: Float64 = tbl[].x[].a[Int(UInt64(0))]
    var a1: Float64 = tbl[].y[].a[Int(UInt64(0))]
    if (depth <= x1):
        if (x1 < Float64(1e-06)):
            return Float64(0.0)
        return ((((a1 / x1) * depth) * depth) / Float64(2.0))
    var v: Float64 = Float64(0.0)
    var dx: Float64 = Float64(0.0)
    var dy: Float64 = Float64(0.0)
    var i: Int32 = Int32(1)
    while (i < n):
        var x2: Float64 = tbl[].x[].a[Int(i.cast[DType.uint64]())]
        var a2: Float64 = tbl[].y[].a[Int(i.cast[DType.uint64]())]
        if (x2 >= depth):
            var dxi: Float64 = (x2 - x1)
            var a: Float64 = Float64(0.0)
            if (Math.Abs(dxi) < Float64(1e-20)):
                a = ((a1 + a2) / Float64(2.0))
            else:
                a = (a1 + (((depth - x1) * (a2 - a1)) / dxi))
            return (v + (((a1 + a) / Float64(2.0)) * (depth - x1)))
        dx = (x2 - x1)
        dy = (a2 - a1)
        v = (v + (((a1 + a2) / Float64(2.0)) * dx))
        x1 = x2
        a1 = a2
        i = (i + Int32(1))
    if (dx > Float64(1e-06)):
        var s: Float64 = (dy / dx)
        var a_2: Float64 = (a1 + (s * (depth - x1)))
        if (a_2 < Float64(0.0)):
            v = (v - (((a1 * a1) / s) / Float64(2.0)))
        else:
            v = (v + (((a1 + a_2) / Float64(2.0)) * (depth - x1)))
    return v

def F___table_getStorageDepth(var tbl: Ref[T_Table], var volume: Float64) raises -> Float64:
    var n: Int32 = tbl[].x[].size().cast[DType.int32]()
    if ((n == Int32(0)) or (volume <= Float64(0.0))):
        return Float64(0.0)
    var x1: Float64 = tbl[].x[].a[Int(UInt64(0))]
    var a1: Float64 = tbl[].y[].a[Int(UInt64(0))]
    var v_accum: Float64 = Float64(0.0)
    var i: Int32 = Int32(1)
    while (i < n):
        var x2: Float64 = tbl[].x[].a[Int(i.cast[DType.uint64]())]
        var a2: Float64 = tbl[].y[].a[Int(i.cast[DType.uint64]())]
        var dv: Float64 = (((a1 + a2) / Float64(2.0)) * (x2 - x1))
        if ((v_accum + dv) >= volume):
            var dx: Float64 = (x2 - x1)
            var dv_need: Float64 = (volume - v_accum)
            if (dx < Float64(1e-10)):
                return x1
            var s: Float64 = ((a2 - a1) / dx)
            var depth: Float64 = Float64(0.0)
            if (Math.Abs(s) < Float64(1e-10)):
                depth = ((x1 + (dv_need / a1)) if (a1 > Float64(0.0)) else x1)
            else:
                var disc: Float64 = ((a1 * a1) + ((Float64(2.0) * s) * dv_need))
                if (disc < Float64(0.0)):
