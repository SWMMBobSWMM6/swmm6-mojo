    if mesh_richards:
        var v__r1: Ref[Vec[Ref[T_LidNodeState]]] = ctx[].node_subtypes[].storages[].lid_state
        var v__i2: Int64 = Int64(0)
        var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
