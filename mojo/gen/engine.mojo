        return F___table_tseries_lookup_cursor(T_TableData__op_Index__i(ctx[].tables, sc[].ground_ts_index), ctx[].current_date)
    return sc[].ground_temp

def F_transport_heat__bedExchangeEnabled(var ctx: Ref[T_SimulationContext]) raises -> Bool:
