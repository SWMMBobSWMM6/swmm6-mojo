def F_dynwave__isOpenShape_DynamicWave(var shape: T_XsectShape) raises -> Bool:
    var __sv1 = shape
    if __sv1 == T_XsectShape__DUMMY or __sv1 == T_XsectShape__RECT_OPEN or __sv1 == T_XsectShape__TRAPEZOIDAL or __sv1 == T_XsectShape__TRIANGULAR or __sv1 == T_XsectShape__PARABOLIC or __sv1 == T_XsectShape__POWER or __sv1 == T_XsectShape__IRREGULAR or __sv1 == T_XsectShape__STREET_XSECT:
        return True
    else:
        return False

def F_dynwave__conveyArea_DynamicWave(var a: Float64, var a_full: Float64) raises -> Float64:
    return (a_full if (a > a_full) else a)

def F_dynwave__buildXSP_DynamicWave(var ctx: Ref[T_SimulationContext], var uk: UInt64) raises -> Ref[T_XSectParams]:
    var links: Ref[T_LinkData] = ctx[].links
    var xs: Ref[T_XSectParams] = T_XSectParams__new()
    var ls: T_XsectShape = links[].xsect_shape[].a[Int(uk)]
    xs[].type_ = F_link__translateShape(ls)
    xs[].y_full = links[].xsect_y_full[].a[Int(uk)]
    xs[].a_full = links[].xsect_a_full[].a[Int(uk)]
    xs[].w_max = links[].xsect_w_max[].a[Int(uk)]
    xs[].yw_max = links[].xsect_yw_max[].a[Int(uk)]
    xs[].r_full = links[].xsect_r_full[].a[Int(uk)]
    xs[].s_full = links[].xsect_s_full[].a[Int(uk)]
    xs[].s_max = links[].xsect_s_max[].a[Int(uk)]
    xs[].y_bot = links[].xsect_y_bot[].a[Int(uk)]
    xs[].a_bot = links[].xsect_a_bot[].a[Int(uk)]
    xs[].s_bot = links[].xsect_s_bot[].a[Int(uk)]
    xs[].r_bot = links[].xsect_r_bot[].a[Int(uk)]
    if (((ls == T_XsectShape__IRREGULAR) or (ls == T_XsectShape__CUSTOM)) or (ls == T_XsectShape__STREET_XSECT)):
        var ci: Int32 = links[].xsect_curve[].a[Int(uk)]
        if ((ci >= Int32(0)) and (ci.cast[DType.uint64]() < ctx[].transect_tables[].size())):
            var td: Ref[T_transect_TransectData] = ctx[].transect_tables[].a[Int(ci.cast[DType.uint64]())]
            xs[].transect = ci
            xs[].area_tbl = Ptr[Float64](td[].area_tbl, Int(Int64(0)))
            xs[].hrad_tbl = Ptr[Float64](td[].hrad_tbl, Int(Int64(0)))
            xs[].width_tbl = Ptr[Float64](td[].width_tbl, Int(Int64(0)))
            xs[].area_lut = td[].area_lut
            xs[].transect_tbl_size = gs()[].G_F_transect__N_TRANSECT_TBL
    return T_XSectParams__MoveNew(xs)

def F_dynwave__chamberPipeVolumeChange_DynamicWave(var ctx: Ref[T_SimulationContext], var node: Int32, var link: Int32, var area1: Float64, var area2: Float64, var iteration_depth: Ptr[Float64]) raises -> Float64:
    var n1: Int32 = ctx[].links[].node1[].a[Int(link.cast[DType.uint64]())]
    var n2: Int32 = ctx[].links[].node2[].a[Int(link.cast[DType.uint64]())]
    var other: Int32 = (n2 if (n1 == node) else n1)
    if (ctx[].nodes[].type_[].a[Int(other.cast[DType.uint64]())] == T_NodeType__OUTFALL):
        return (ctx[].links[].volume[].a[Int(link.cast[DType.uint64]())] - ctx[].links[].old_volume[].a[Int(link.cast[DType.uint64]())])
    var old1: Float64 = F_dynwave__chamberEndArea_DynamicWave(ctx, link, (ctx[].nodes[].old_depth[].a[Int(n1.cast[DType.uint64]())] - ctx[].links[].offset1[].a[Int(link.cast[DType.uint64]())]))
    var old2: Float64 = F_dynwave__chamberEndArea_DynamicWave(ctx, link, (ctx[].nodes[].old_depth[].a[Int(n2.cast[DType.uint64]())] - ctx[].links[].offset2[].a[Int(link.cast[DType.uint64]())]))
    if (ctx[].nodes[].storage_area[].a[Int(n1.cast[DType.uint64]())] > Float64(0.0)):
        area1 = F_dynwave__chamberEndArea_DynamicWave(ctx, link, (iteration_depth[Int(n1)] - ctx[].links[].offset1[].a[Int(link.cast[DType.uint64]())]))
    if (ctx[].nodes[].storage_area[].a[Int(n2.cast[DType.uint64]())] > Float64(0.0)):
        area2 = F_dynwave__chamberEndArea_DynamicWave(ctx, link, (iteration_depth[Int(n2)] - ctx[].links[].offset2[].a[Int(link.cast[DType.uint64]())]))
    var before: Float64 = ((old1 / (old1 + old2)) if ((old1 + old2) > Float64(0.0)) else Float64(0.5))
    var after: Float64 = ((area1 / (area1 + area2)) if ((area1 + area2) > Float64(0.0)) else Float64(0.5))
    if (n1 != node):
        before = (Float64(1.0) - before)
        after = (Float64(1.0) - after)
    return ((after * ctx[].links[].volume[].a[Int(link.cast[DType.uint64]())]) - (before * ctx[].links[].old_volume[].a[Int(link.cast[DType.uint64]())]))

def F_dynwave__chamberEndArea_DynamicWave(var ctx: Ref[T_SimulationContext], var link: Int32, var depth: Float64) raises -> Float64:
    var xs: Ref[T_XSectParams] = F_dynwave__buildXSP_DynamicWave(ctx, link.cast[DType.uint64]())
    if (depth <= Float64(0.0)):
        return Float64(0.0)
    if (depth < xs[].y_full):
        return F_xsect__getAofY(xs, depth)
    var slot: Float64 = Float64(0.0)
    if ((ctx[].options[].surcharge_method == Int32(1)) and (not F_dynwave__isOpenShape_DynamicWave(ctx[].links[].xsect_shape[].a[Int(link.cast[DType.uint64]())]))):
        var ratio: Float64 = (depth / xs[].y_full)
        slot = ((Float64(0.01) * xs[].w_max) if (ratio > Float64(1.78)) else ((xs[].w_max * Float64(0.5423)) * Math.Exp((-Math.Pow(ratio, Float64(2.4))))))
    return (xs[].a_full + ((depth - xs[].y_full) * slot))

def F_dynwave__computeYnorm_DynamicWave(var xs: Ref[T_XSectParams], var beta: Float64, var q_max: Float64, var q: Float64) raises -> Float64:
    if ((beta <= Float64(0.0)) or (q <= Float64(0.0))):
        return Float64(0.0)
    if ((q_max > Float64(0.0)) and (q > q_max)):
        q = q_max
    var s: Float64 = (q / beta)
    var a: Float64 = F_xsect__getAofS(xs, s)
    return F_xsect__getYofA(xs, a)

