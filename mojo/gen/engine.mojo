def T_iface_InterfaceManager__openFiles(this: Ref[T_iface_InterfaceManager], var infile_path: Ref[Str], var outfile_path: Ref[Str]) raises -> Int32:
    if ((not infile_path[].empty()) and (not outfile_path[].empty())):
        if infile_path[].Equals(outfile_path):
            return Int32(-1)
    if (not outfile_path[].empty()):
        this[].outfile_ = F_io__fopen_utf8(outfile_path, rt_lit("wt"))
        if (not (rt_box(this[].outfile_) != Obj())):
            return Int32(-2)
    if (not infile_path[].empty()):
        this[].infile_ = F_io__fopen_utf8(infile_path, rt_lit("rt"))
        if (not (rt_box(this[].infile_) != Obj())):
            return Int32(-3)
    return Int32(0)

def T_iface_InterfaceManager__readFileHeader(this: Ref[T_iface_InterfaceManager], var ctx: Ref[T_SimulationContext]) raises -> Int32:
    if (not (rt_box(this[].infile_) != Obj())):
        return Int32(-1)
    var line: CPtr = R.Buf(Int32(1025))
    var s1: CPtr = R.Buf(Int32(1025))
    var s2: CPtr = R.Buf(Int32(1025))
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if (R.sscanf(line, rt_lit("%s"), A(s1)) != Int32(1)):
        return Int32(-1)
    if (R.strncmp(s1, rt_lit("SWMM5"), UInt64(5)) != Int32(0)):
        return Int32(-1)
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if ((R.sscanf(line, rt_lit("%d"), A(rt_addr(this[].iface_step_))) != Int32(1)) or (this[].iface_step_ <= Int32(0))):
        return Int32(-1)
    var n_constit = rt_cell[Int32](Int32(0))
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if (R.sscanf(line, rt_lit("%d"), A(n_constit)) != Int32(1)):
        return Int32(-1)
    this[].n_iface_polluts_ = (n_constit[] - Int32(1))
    if (this[].n_iface_polluts_ < Int32(0)):
        return Int32(-1)
    this[].n_values_per_node_ = (Int32(1) + this[].n_iface_polluts_)
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if (R.sscanf(line, rt_lit("%s %s"), A(s1), A(s2)) < Int32(2)):
        return Int32(-1)
    if (R.strncmp(s1, rt_lit("FLOW"), UInt64(4)) != Int32(0)):
        return Int32(-1)
    if (not gs()[].G_T_iface_InterfaceManager__S_flow_words_15_done):
        gs()[].G_T_iface_InterfaceManager__S_flow_words_15 = Ary[CPtr].of(rt_lit("CFS"), rt_lit("GPM"), rt_lit("MGD"), rt_lit("CMS"), rt_lit("LPS"), rt_lit("MLD"))
        gs()[].G_T_iface_InterfaceManager__S_flow_words_15_done = True
    this[].iface_flow_units_ = Int32(0)
    var fi: Int32 = Int32(0)
    while (fi < Int32(6)):
        if (R.strncmp(s2, Ptr[CPtr](gs()[].G_T_iface_InterfaceManager__S_flow_words_15, Int(Int64(0)))[Int(fi)], UInt64(3)) == Int32(0)):
            this[].iface_flow_units_ = fi
            break
        fi = (fi + Int32(1))
    var n_polluts: Int32 = T_SimulationContext__n_pollutants(ctx)
    if (n_polluts > Int32(0)):
        this[].pollut_map_[].assign(n_polluts.cast[DType.uint64](), Int32(-1))
    var i: Int32 = Int32(0)
    while (i < this[].n_iface_polluts_):
        if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
            return Int32(-1)
        if (R.sscanf(line, rt_lit("%s %s"), A(s1), A(s2)) < Int32(2)):
            return Int32(-1)
        var j: Int32 = T_NameIndex__find(ctx[].pollutant_names, Str.new_(s1))
        if ((j >= Int32(0)) and (j < n_polluts)):
            this[].pollut_map_[].a[Int(j.cast[DType.uint64]())] = i
        i = (i + Int32(1))
    var n_nodes = rt_cell[Int32](Int32(0))
    if (not (not R.fgets(line, gs()[].G_F_iface__MAXLINE_InterfaceFile, this[].infile_).isnull())):
        return Int32(-1)
    if ((R.sscanf(line, rt_lit("%d"), A(n_nodes)) != Int32(1)) or (n_nodes[] <= Int32(0))):
        return Int32(-1)
    T_iface_InterfaceFileSoA__resize(this[].data_, n_nodes[])
    var un: UInt64 = n_nodes[].cast[DType.uint64]()
