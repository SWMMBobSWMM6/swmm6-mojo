def T_SimulationOptions__totalDurationMs(this: Ref[T_SimulationOptions]) raises -> Float64:
    if (this[].total_duration_ms >= Float64(0.0)):
        return this[].total_duration_ms
    return (Math.Floor(((this[].end_date - this[].start_date) * Float64(86400.0))) * Float64(1000.0))

