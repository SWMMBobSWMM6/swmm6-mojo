def T_SimulationContext__MoveNew(var s: Ref[T_SimulationContext]) raises -> Ref[T_SimulationContext]:
    var o: Ref[T_SimulationContext] = T_SimulationContext__raw()
    T_SimulationContext__MoveFrom(o, s)
    return o

def T_SimulationContext__refreshReportedSpecies(this: Ref[T_SimulationContext]) raises:
    this[].reported_species_names[].clear()
    var p: Int32 = Int32(0)
    while (p < T_SimulationContext__n_pollutants(this)):
        this[].reported_species_names[].push_back(T_NameIndex__name_of(this[].pollutant_names, p)[].Clone())
        p = (p + Int32(1))
    if this[].options[].water_age:
        this[].reported_species_names[].push_back(Str.new_(rt_lit("__WATER_AGE__")))
    if this[].options[].heat_transport:
        this[].reported_species_names[].push_back(Str.new_(rt_lit("__TEMPERATURE__")))
    this[].reactions[].reported_species[].clear()
    var m: Int32 = Int32(0)
    while (m < T_ReactionData__n_species(this[].reactions)):
        if ((not this[].reactions[].report_enabled[].empty()) and (not (this[].reactions[].report_enabled[].a[Int(m.cast[DType.uint64]())].cast[DType.int32]() != Int32(0)))):
            m = (m + Int32(1))
            continue
        this[].reactions[].reported_species[].push_back(m)
        this[].reported_species_names[].push_back(this[].reactions[].species_name[].a[Int(m.cast[DType.uint64]())][].Clone())
        m = (m + Int32(1))

def T_SimulationContext__n_reported_species(this: Ref[T_SimulationContext]) raises -> Int32:
    return this[].reported_species_names[].size().cast[DType.int32]()

def T_SimulationContext__logControlAction(this: Ref[T_SimulationContext], var e: Ref[T_SimulationContext_ControlLogEntry]) raises:
    if (this[].control_log[].size() >= gs()[].G_T_SimulationContext__kMaxControlLog):
        this[].control_log_dropped = (this[].control_log_dropped + UInt64(1))
        return
    this[].control_log[].push_back(T_SimulationContext_ControlLogEntry__Clone(e))

def T_SimulationContext__updateMaxStats(var arr: Ptr[Ref[T_SimulationContext_MaxStats]], var obj_type: Int32, var idx: Int32, var value: Float64) raises:
    var candidate: Ref[T_SimulationContext_MaxStats] = T_SimulationContext_MaxStats__new()
    candidate[].obj_type = obj_type
    candidate[].index = idx
    candidate[].value = value
    var k: Int32 = Int32(0)
    while (k < gs()[].G_T_SimulationContext__MAX_STATS):
        if (Math.Abs(candidate[].value) > Math.Abs(arr[Int(k)][].value)):
            var tmp: Ref[T_SimulationContext_MaxStats] = T_SimulationContext_MaxStats__New_rMaxStats(arr[Int(k)])
            T_SimulationContext_MaxStats__Assign(arr[Int(k)], candidate)
            T_SimulationContext_MaxStats__Assign(candidate, tmp)
        k = (k + Int32(1))

def __h47(var a0: Int32, var a1: Int32, var a2: Float64) raises -> Ref[T_SimulationContext_MaxStats]:
    var o = T_SimulationContext_MaxStats__new()
    o[].obj_type = a0
    o[].index = a1
    o[].value = a2
    return o

def __h48(var a0: Int32, var a1: Int32, var a2: Float64) raises -> Ref[T_SimulationContext_MaxStats]:
    var o = T_SimulationContext_MaxStats__new()
    o[].obj_type = a0
    o[].index = a1
    o[].value = a2
    return o

def __h49(var a0: Int32, var a1: Int32, var a2: Float64) raises -> Ref[T_SimulationContext_MaxStats]:
    var o = T_SimulationContext_MaxStats__new()
    o[].obj_type = a0
    o[].index = a1
    o[].value = a2
    return o

def T_SimulationContext__finalize_max_stats(this: Ref[T_SimulationContext]) raises:
    var k: Int32 = Int32(0)
    while (k < gs()[].G_T_SimulationContext__MAX_STATS):
        T_SimulationContext_MaxStats__MoveFrom(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_courant_crit, Int(Int64(0)))[Int(k)], __h47(Int32(0), Int32(-1), Float64(-1.0)))
        T_SimulationContext_MaxStats__MoveFrom(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_flow_turns, Int(Int64(0)))[Int(k)], __h48(Int32(1), Int32(-1), Float64(-1.0)))
        T_SimulationContext_MaxStats__MoveFrom(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_non_converged, Int(Int64(0)))[Int(k)], __h49(Int32(0), Int32(-1), Float64(0.0)))
        k = (k + Int32(1))
    var rpt_steps: Int64 = this[].routing_stats[].report_steps
    if (rpt_steps > Int64(2)):
        var z: Float64 = (Float64(100.0) / (Float64(0.6666666666666666) * (rpt_steps - Int64(2)).cast[DType.float64]()))
        var j: Int32 = Int32(0)
        while (j < T_SimulationContext__n_links(this)):
            var x: Float64 = (this[].links[].stat_flow_turns[].a[Int(j.cast[DType.uint64]())].cast[DType.float64]() * z)
            T_SimulationContext__updateMaxStats(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_flow_turns, Int(Int64(0))), Int32(1), j, x)
            j = (j + Int32(1))
    var step_count: Int64 = this[].routing_stats[].n_steps
    var dw: Bool = (this[].options[].routing_model == T_RoutingModel__DYNWAVE)
    if dw:
        var j_2: Int32 = Int32(0)
        while (j_2 < T_SimulationContext__n_nodes(this)):
            T_SimulationContext__updateMaxStats(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_non_converged, Int(Int64(0))), Int32(0), j_2, (this[].nodes[].stat_non_converged_count[].a[Int(j_2.cast[DType.uint64]())].cast[DType.float64]() / step_count.cast[DType.float64]()))
            j_2 = (j_2 + Int32(1))
    if (((not dw) or (this[].options[].variable_step == Float64(0.0))) or (step_count == Int64(0))):
        return
    var inv_steps: Float64 = (Float64(1.0) / step_count.cast[DType.float64]())
    var j_3: Int32 = Int32(0)
    while (j_3 < T_SimulationContext__n_nodes(this)):
        var x_2: Float64 = (this[].nodes[].stat_time_courant_critical[].a[Int(j_3.cast[DType.uint64]())] * inv_steps)
        T_SimulationContext__updateMaxStats(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_courant_crit, Int(Int64(0))), Int32(0), j_3, (Float64(100.0) * x_2))
        j_3 = (j_3 + Int32(1))
    var j_4: Int32 = Int32(0)
    while (j_4 < T_SimulationContext__n_links(this)):
        var x_3: Float64 = (this[].links[].stat_time_courant_critical[].a[Int(j_4.cast[DType.uint64]())] * inv_steps)
        T_SimulationContext__updateMaxStats(Ptr[Ref[T_SimulationContext_MaxStats]](this[].max_courant_crit, Int(Int64(0))), Int32(1), j_4, (Float64(100.0) * x_3))
        j_4 = (j_4 + Int32(1))

def __h50(var a0: Ref[Vec[Float64]], var a1: Ref[Vec[Float64]], var a2: Ref[Vec[Float64]], var a3: Ref[Vec[Float64]]) raises -> Ref[T_SimulationContext_OutfallExports]:
    var o = T_SimulationContext_OutfallExports__new()
    o[].water_m3 = a0
    o[].reverse_m3 = a1
    o[].heat_j = a2
    o[].pollutant_amounts = a3
