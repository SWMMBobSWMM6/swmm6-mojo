def F_inlet__findOnSagCurbFlows(var d: Ref[T_inlet_Design], var g: Ref[T_inlet_Geom], var depth: Float64, var L: Float64, var Qw: Ptr[Float64], var Qo: Ptr[Float64]) raises:
    var throat: Int32 = d[].curb_throat
