def F_transport__formatReportBlock(var m: Ref[T_transport_Matrix]) raises -> Ref[Str]:
    var __sp = rt_sp()
    var out_ = rt_salloc[Ref[Str]]()
    out_[] = Str.new_()
    _ = out_[][].append(rt_lit("  Transport by domain (Domain x Species; on(n) = rows carried,\n"))
    _ = out_[][].append(rt_lit("  off:KEY = switched off by that option, n/a = not carried):\n"))
    var buf: CPtr = R.Buf(Int32(256))
    _ = R.snprintf(buf, UInt64(256), rt_lit("  %-14s %-14s %-14s %-14s %-14s\n"), A(rt_lit("")), A(rt_lit("Pollutants")), A(rt_lit("MSX")), A(rt_lit("Age")), A(rt_lit("Temperature")))
    _ = out_[][].append(buf)
    var d: Int32 = Int32(0)
    while (d < Int32(4)):
        var line: Ref[Str] = Str.new_(rt_lit("  "))
        _ = R.snprintf(buf, UInt64(256), rt_lit("%-14s "), A(F_transport__domainName(d)))
        _ = line[].append(buf)
        var c: Int32 = Int32(0)
        while (c < Int32(4)):
            var cell: Ref[T_transport_Cell] = Ptr[Ref[T_transport_Cell]](Ptr[Ary[Ref[T_transport_Cell]]](m[].cells, Int(Int64(0)))[Int(d)], Int(Int64(0)))[Int(c)]
            var tok: Ref[Str] = Str.new_()
            var __sv1 = cell[].state
            while True:
                if __sv1 == T_transport_CellState__ENABLED:
                    tok[].MoveFrom(Str.Cat(Str.Cat(rt_lit("on("), Str.to_string(cell[].count)), rt_lit(")")))
                    break
                elif __sv1 == T_transport_CellState__DISABLED_BY_USER:
                    tok[].MoveFrom(Str.Cat(rt_lit("off:"), cell[].reason))
                    break
                else:
                    tok[].Assign(rt_lit("n/a"))
                    break
                break
            _ = R.snprintf(buf, UInt64(256), rt_lit("%-14s "), A(tok[].c_str()))
            _ = line[].append(buf)
            c = (c + Int32(1))
        _ = out_[][].append(line)
        _ = out_[][].append(Int32(10))
        d = (d + Int32(1))
    var any_: Bool = False
    var d_2: Int32 = Int32(0)
    while (d_2 < Int32(4)):
        var c_2: Int32 = Int32(0)
        while (c_2 < Int32(4)):
            var cell_2: Ref[T_transport_Cell] = Ptr[Ref[T_transport_Cell]](Ptr[Ary[Ref[T_transport_Cell]]](m[].cells, Int(Int64(0)))[Int(d_2)], Int(Int64(0)))[Int(c_2)]
            if ((cell_2[].state != T_transport_CellState__UNAVAILABLE) or cell_2[].reason[].empty()):
                c_2 = (c_2 + Int32(1))
                continue
            if (not any_):
                _ = out_[][].append(rt_lit("  n/a because:\n"))
                any_ = True
            _ = R.snprintf(buf, UInt64(256), rt_lit("    %-14s %-12s %s\n"), A(F_transport__domainName(d_2)), A(F_transport__speciesClassName(c_2)), A(cell_2[].reason[].c_str()))
            _ = out_[][].append(buf)
            c_2 = (c_2 + Int32(1))
        d_2 = (d_2 + Int32(1))
    var __r2 = Mv.Take[Ref[Str]](out_)
    rt_set_sp(__sp)
    return __r2

