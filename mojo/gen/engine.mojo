def F_hydkernels__fricSlopeHW(var velocity: Float64, var hyd_rad: Float64, var c_hw: Float64) raises -> Float64:
    if ((c_hw <= Float64(0.0)) or (hyd_rad <= Float64(0.0))):
        return Float64(0.0)
    var v_abs: Float64 = ((-velocity) if (velocity < Float64(0.0)) else velocity)
    return Math.Pow((v_abs / ((Float64(1.318) * c_hw) * Math.Pow(hyd_rad, Float64(0.63)))), Float64(1.8518518518518516))

def F_hydkernels__fricSlopeDW(var velocity: Float64, var hyd_rad: Float64, var roughness: Float64) raises -> Float64:
    if (hyd_rad <= Float64(0.0)):
        return Float64(0.0)
    var v_abs: Float64 = ((-velocity) if (velocity < Float64(0.0)) else velocity)
    var diameter: Float64 = (Float64(4.0) * hyd_rad)
    var re: Float64 = ((v_abs * diameter) / gs()[].G_F_hydkernels__kViscosity)
    if (re <= Float64(0.0)):
        return Float64(0.0)
    var f: Float64 = Float64(0.0)
    if (re <= Float64(2000.0)):
        f = (Float64(64.0) / re)
    else:
        var e_over_d: Float64 = (roughness / diameter)
        var arg: Float64 = ((e_over_d / Float64(3.7)) + (Float64(5.74) / Math.Pow(re, Float64(0.9))))
        if (arg <= Float64(0.0)):
            return Float64(0.0)
        var logarg: Float64 = Math.Log10(arg)
        f = (Float64(0.25) / (logarg * logarg))
    return (((f * v_abs) * v_abs) / ((Float64(2.0) * gs()[].G_F_hydkernels__kGravity) * diameter))

def F_hydkernels__culvertInflow(var q_proposed: Float64, var head: Float64, var y_full: Float64, var a_full: Float64, var slope: Float64, var cc: Ref[T_hydkernels_CulvertCurve], var mitered: Bool, dqdh: P[Float64]) raises -> Float64:
    dqdh[] = Float64(0.0)
    if (((head <= Float64(0.0)) or (y_full <= Float64(0.0))) or (a_full <= Float64(0.0))):
        return q_proposed
    if (cc[].K == Float64(0.0)):
        return q_proposed
    var AD: Float64 = (a_full * Math.Sqrt(y_full))
    var y_norm: Float64 = (head / y_full)
    var scf: Float64 = ((Float64(-7.0) * slope) if mitered else (Float64(0.5) * slope))
    var y1_norm: Float64 = Float64(0.95)
    var y2_norm: Float64 = (((Float64(16.0) * cc[].C) + cc[].Y) - scf)
    if (y2_norm < y1_norm):
        y2_norm = (y1_norm + Float64(0.01))
    var q_inlet: Float64 = Float64(0.0)
    if (y_norm <= y1_norm):
        var arg: Float64 = (y_norm / cc[].K)
        if (arg <= Float64(0.0)):
            return q_proposed
        q_inlet = (AD * Math.Pow(arg, (Float64(1.0) / cc[].M)))
        dqdh[] = (q_inlet / (head * cc[].M))
    elif (y_norm >= y2_norm):
        var arg_2: Float64 = (((y_norm - cc[].Y) + scf) / cc[].C)
        if (arg_2 <= Float64(0.0)):
            return q_proposed
        q_inlet = (AD * Math.Sqrt(arg_2))
        dqdh[] = ((Float64(0.5) * q_inlet) / ((arg_2 * y_full) * cc[].C))
    else:
        var arg1: Float64 = (y1_norm / cc[].K)
        var q1: Float64 = (AD * Math.Pow(arg1, (Float64(1.0) / cc[].M)))
        var arg2: Float64 = (((y2_norm - cc[].Y) + scf) / cc[].C)
        var q2: Float64 = ((AD * Math.Sqrt(arg2)) if (arg2 > Float64(0.0)) else q1)
        var frac: Float64 = ((y_norm - y1_norm) / (y2_norm - y1_norm))
        q_inlet = (q1 + (frac * (q2 - q1)))
        dqdh[] = ((q2 - q1) / ((y2_norm - y1_norm) * y_full))
    return (q_inlet if (q_inlet < q_proposed) else q_proposed)

def F_hydstruct__flapGateBlocks(var ctx: Ref[T_SimulationContext], var j: Int32, var n1: Int32, var n2: Int32, var q: Float64) raises -> Bool:
    var uj: UInt64 = j.cast[DType.uint64]()
    if ((ctx[].links[].has_flap_gate[].a[Int(uj)].cast[DType.int32]() != Int32(0)) and ((q * ctx[].links[].direction[].a[Int(uj)].cast[DType.float64]()) < Float64(0.0))):
        return True
    var n: Int32 = Int32(-1)
    if (q < Float64(0.0)):
        n = n2
    if (q > Float64(0.0)):
        n = n1
    if (n < Int32(0)):
        return False
    if (ctx[].nodes[].type_[].a[Int(n.cast[DType.uint64]())] != T_NodeType__OUTFALL):
        return False
    var ofr: Int32 = T_NodeSubtypes__outfall_row(ctx[].node_subtypes, n)
    return ((ofr >= Int32(0)) and (ctx[].node_subtypes[].outfalls[].has_flap_gate[].a[Int(ofr.cast[DType.uint64]())].cast[DType.int32]() != Int32(0)))

def F_hydstruct__tailwaterHead_HydStructures(var ctx: Ref[T_SimulationContext], var un1: UInt64, var un2: UInt64) raises -> Float64:
    var rm: T_RoutingModel = ctx[].options[].routing_model
    if ((rm == T_RoutingModel__KINWAVE) or (rm == T_RoutingModel__STEADY)):
        return ctx[].nodes[].invert_elev[].a[Int(un1)]
    return (ctx[].nodes[].depth[].a[Int(un2)] + ctx[].nodes[].invert_elev[].a[Int(un2)])

def F_hydstruct__buildXSP_HydStructures(var ctx: Ref[T_SimulationContext], var uk: UInt64) raises -> Ref[T_XSectParams]:
    var links: Ref[T_LinkData] = ctx[].links
    var xs: Ref[T_XSectParams] = T_XSectParams__new()
    var ls: T_XsectShape = links[].xsect_shape[].a[Int(uk)]
    xs[].type_ = F_link__translateShape(ls)
    xs[].y_full = links[].xsect_y_full[].a[Int(uk)]
    xs[].a_full = links[].xsect_a_full[].a[Int(uk)]
    xs[].w_max = links[].xsect_w_max[].a[Int(uk)]
    xs[].r_full = links[].xsect_r_full[].a[Int(uk)]
    xs[].s_full = links[].xsect_s_full[].a[Int(uk)]
    xs[].s_max = links[].xsect_s_max[].a[Int(uk)]
    xs[].y_bot = links[].xsect_y_bot[].a[Int(uk)]
    xs[].a_bot = links[].xsect_a_bot[].a[Int(uk)]
    xs[].s_bot = links[].xsect_s_bot[].a[Int(uk)]
    xs[].r_bot = links[].xsect_r_bot[].a[Int(uk)]
    if (((ls == T_XsectShape__IRREGULAR) or (ls == T_XsectShape__CUSTOM)) or (ls == T_XsectShape__STREET_XSECT)):
        var ci: Int32 = links[].xsect_curve[].a[Int(uk)]
        if ((ci >= Int32(0)) and (ci.cast[DType.uint64]() < ctx[].transect_tables[].size())):
            var td: Ref[T_transect_TransectData] = ctx[].transect_tables[].a[Int(ci.cast[DType.uint64]())]
            xs[].transect = ci
            xs[].area_tbl = Ptr[Float64](td[].area_tbl, Int(Int64(0)))
            xs[].hrad_tbl = Ptr[Float64](td[].hrad_tbl, Int(Int64(0)))
            xs[].width_tbl = Ptr[Float64](td[].width_tbl, Int(Int64(0)))
            xs[].area_lut = td[].area_lut
            xs[].transect_tbl_size = gs()[].G_F_transect__N_TRANSECT_TBL
    return T_XSectParams__MoveNew(xs)

