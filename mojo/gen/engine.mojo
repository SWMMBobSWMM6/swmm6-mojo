def T_SWMMEngine__MoveNew(var s: Ref[T_SWMMEngine]) raises -> Ref[T_SWMMEngine]:
    var o: Ref[T_SWMMEngine] = T_SWMMEngine__raw()
    T_SWMMEngine__MoveFrom(o, s)
    return o

def T_SWMMEngine__Dispose(this: Ref[T_SWMMEngine]) raises:
    if ((this[].ctx_[].state == T_EngineState__RUNNING) or (this[].ctx_[].state == T_EngineState__ENDED)):
        _ = T_SWMMEngine__close(this)
    F_perf__end_process_model(rt_box(this), False)
    T_rdii_iface_RdiiInterfaceFile.__dispose(this[].rdii_iface_file_)
    T_runoff_iface_RunoffInterfaceFile.__dispose(this[].runoff_iface_file_)
    T_transport_ArdEngine.__dispose(this[].ard_)
    T_lid_LIDSolver.__dispose(this[].lid_)
    T_climate_ClimateFileReader.__dispose(this[].climate_file_)
    T_IOThread.__dispose(this[].io_thread_)
    T_PluginFactory.__dispose(this[].plugins_)

struct __Ctx86(Movable):
    var this: Ref[T_SWMMEngine]

def __mk86(this: Ref[T_SWMMEngine]) -> VP:
    var c = gc_new[__Ctx86]()
    c[].this = this
    return c.unsafe_bitcast[NoneType]()

def __lam86(__ctx: VP, var msg: Ref[Str]) raises:
    var __c = __ctx.unsafe_bitcast[__Ctx86]()
    T_SWMMEngine__emit_warning(__c[].this, Int32(10), msg[].c_str())
    return

@no_inline
def T_IPluginComponentInfo__has_input__v(o: Ref[T_IPluginComponentInfo]) raises -> Bool:
    var t = o[].__tid
    if t == 1000:
        return T_BuiltinDefaultInputPluginInfo__has_input(o.cast[T_BuiltinDefaultInputPluginInfo]())
    if t == 1001 or t == 1002 or t == 1003:
        return T_IPluginComponentInfo__has_input(o)
    raise rt_unreachable()

@no_inline
def T_IPluginComponentInfo__create_input_plugin__v(o: Ref[T_IPluginComponentInfo]) raises -> Ref[T_IInputPlugin]:
    var t = o[].__tid
    if t == 1000 or t == 1001 or t == 1002 or t == 1003:
        return T_IPluginComponentInfo__create_input_plugin(o)
    raise rt_unreachable()

@no_inline
def T_IInputPlugin__initialize__v(o: Ref[T_IInputPlugin], a0: Ref[Vec[Ref[Str]]], a1: Ref[T_IPluginComponentInfo]) raises -> Int32:
