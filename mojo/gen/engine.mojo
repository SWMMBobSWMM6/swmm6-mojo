def T_ForcingData_ElemClimateChannel__apply__i_d(this: Ref[T_ForcingData_ElemClimateChannel], var i: Int32, var base: Float64) raises -> Float64:
    if (i < Int32(0)):
        return base
    var u: UInt64 = i.cast[DType.uint64]()
    if ((u >= this[].mode[].size()) or (this[].mode[].a[Int(u)] == T_ForcingMode__NONE)):
        return base
    return (this[].value[].a[Int(u)] if (this[].mode[].a[Int(u)] == T_ForcingMode__OVERRIDE) else (base + this[].value[].a[Int(u)]))

def T_ForcingData_ElemClimateChannel__resetPerStep(this: Ref[T_ForcingData_ElemClimateChannel]) raises:
    var i: UInt64 = UInt64(0)
    while (i < this[].mode[].size()):
        if (this[].persist[].a[Int(i)] == T_ForcingPersist__RESET):
            this[].mode[].a[Int(i)] = T_ForcingMode__NONE
        i = (i + UInt64(1))

