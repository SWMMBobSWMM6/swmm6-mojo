        var __cp4 = rt_addr(nodes[].lat_flow[].a[Int(uh)])
        __cp4[] = (__cp4[] - (qcap - qbf_2))
        var __cp5 = rt_addr(nodes[].lat_flow[].a[Int(capture_2.cast[DType.uint64]())])
        __cp5[] = (__cp5[] + qcap)
