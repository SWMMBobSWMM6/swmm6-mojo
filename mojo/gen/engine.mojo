def T_ForcingData__resize(this: Ref[T_ForcingData], var n_nodes: Int32, var n_links: Int32, var n_subcatches: Int32, var n_gages: Int32, var n_pollutants: Int32) raises:
    this[].n_nodes_ = n_nodes
