            xs[].yw_max = y_3
            xs[].y_bot = yb
            xs[].s_bot = ((m1 + m2) / Float64(2.0))
            xs[].r_bot = (Math.Sqrt((Float64(1.0) + (m1 * m1))) + Math.Sqrt((Float64(1.0) + (m2 * m2))))
            xs[].w_max = (yb + (y_3 * (m1 + m2)))
            xs[].a_full = ((yb + (xs[].s_bot * y_3)) * y_3)
            xs[].r_full = (xs[].a_full / (yb + (y_3 * xs[].r_bot)))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            xs[].s_max = xs[].s_full
            return Int32(0)
        elif __sv1 == T_XSectShape__TRIANGULAR:
            var y_4: Float64 = (p[Int(Int32(0))] / ucf)
            var w_3: Float64 = (p[Int(Int32(1))] / ucf)
