def T_controls_ControlEngine__computePIDSetting(this: Ref[T_controls_ControlEngine], var pid: Ref[T_controls_PIDState], var control_value: Float64, var current_setting: Float64, var is_pump: Bool, var dt: Float64) raises -> Float64:
