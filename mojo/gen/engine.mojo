        ctx[].spatial[].node_x[].a[Int(idx.cast[DType.uint64]())] = F_input__to_double(tok[].a[Int(UInt64(1))][].Clone(), Float64(0.0))
        ctx[].spatial[].node_y[].a[Int(idx.cast[DType.uint64]())] = F_input__to_double(tok[].a[Int(UInt64(2))][].Clone(), Float64(0.0))
        if (ctx[].spatial[].node_has_xy[].size() < ctx[].spatial[].node_x[].size()):
            ctx[].spatial[].node_has_xy[].resize(ctx[].spatial[].node_x[].size(), UInt8(0))
        ctx[].spatial[].node_has_xy[].a[Int(idx.cast[DType.uint64]())] = UInt8(1)
        v__i2 = (v__i2 + Int64(1))

def F_input__ensure_node_capacity_NodesHandler(var ctx: Ref[T_SimulationContext], var idx: Int32) raises:
