    T_rdii_iface_RdiiInterfaceFile__close(this[].rdii_iface_file_)
    T_SWMMEngine__closeRunoffIface(this)
    T_PluginFactory__unload_all(this[].plugins_)
    this[].ctx_[].state = T_EngineState__CLOSED
    return Int32(0)

