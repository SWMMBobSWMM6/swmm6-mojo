    var un: UInt64 = n_nodes.cast[DType.uint64]()
    var ul: UInt64 = n_links.cast[DType.uint64]()
    var us: UInt64 = n_subcatches.cast[DType.uint64]()
    var ug: UInt64 = n_gages.cast[DType.uint64]()
