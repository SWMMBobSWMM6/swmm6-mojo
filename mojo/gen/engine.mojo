def F_climate__resolveRadiation(var ctx: Ref[T_SimulationContext], var date: Float64, var seconds: Float64, var output: Ref[T_climate_RadiationState]) raises -> Ref[Str]:
    var __sp = rt_sp()
    var year = rt_salloc[Int32]()
    var month = rt_salloc[Int32]()
    var day = rt_salloc[Int32]()
    var value = rt_salloc[Float64]()
    var temperature = rt_salloc[Float64]()
    var error_5 = rt_salloc[Ref[Str]]()
    var humidity = rt_salloc[Float64]()
    var error_6 = rt_salloc[Ref[Str]]()
    if ((((not Dbl.IsFinite(date)) or (not Dbl.IsFinite(seconds))) or (seconds <= Float64(0.0))) or (seconds > Float64(86400.0))):
        var __r1 = Str.new_(rt_lit("Invalid radiation interval."))
        rt_set_sp(__sp)
        return __r1
    var cfg: Ref[T_surface_SnowConfig] = ctx[].snowpacks[].config
    var climate: Ref[T_climate_ClimateState] = ctx[].climate_state
    var solar: Ref[T_SolarConfig] = ctx[].heat_config[].solar
    var next_: Ref[T_climate_RadiationState] = T_climate_RadiationState__new()
    next_[].date = date
    next_[].seconds = seconds
    next_[].temperature = (((climate[].temperature - Float64(32.0)) * Float64(5.0)) / Float64(9.0))
    next_[].humidity = (climate[].humidity * Float64(0.01))
    next_[].wind = (climate[].wind_speed * Float64(0.44704))
    var longitude: Float64 = (solar[].longitude_deg if solar[].has_longitude else ((-climate[].dtlong) * Float64(15.0)))
    var timezone: Float64 = (solar[].timezone_hours if solar[].has_longitude else Float64(0.0))
    var elevation: Float64 = (solar[].elevation_m if solar[].has_elevation else (climate[].elev * Float64(0.3048)))
    next_[].latitude = (solar[].latitude_deg if solar[].has_latitude else climate[].latitude)
    if cfg[].site[].has:
        next_[].latitude = cfg[].site[].val[].latitude
        longitude = cfg[].site[].val[].longitude
        timezone = cfg[].site[].val[].timezone
        elevation = cfg[].site[].val[].elevation
    next_[].pressure = (F_climate__pressureFromElevation(elevation) * Float64(100.0))
    var pos: Ref[T_climate_SolarPosition] = F_climate__solarPosition(F_datetime__dayOfYear(date), ((date - Math.Floor(date)) * Float64(24.0)), next_[].latitude, longitude, timezone)
    next_[].declination = pos[].declination_deg
    next_[].hour_angle = pos[].hour_angle_deg
    var integral: Ref[T_surface_SolarIntegral] = F_surface__solarIntegral(next_[].latitude, next_[].declination, next_[].hour_angle, (seconds / Float64(3600.0)), Float64(0.0), Float64(0.0))
    next_[].cosine = rt_asg(rt_addr(next_[].horizontal), integral[].horizontal)
    year[] = Int32(0)
    month[] = Int32(0)
    day[] = Int32(0)
    F_datetime__decodeDate(date, year, month, day)
    var range_: Float64 = F_climate__anon_hydrology_UebForcing_cpp__dailyRange_UebForcing(ctx, date)
    var monthly: Ref[Opt[Float64]] = cfg[].monthly_range[Int(M.clamp((month[] - Int32(1)), Int32(0), Int32(11)).cast[DType.uint64]())][].Clone()
    if (range_ < Float64(0.0)):
        range_ = monthly[].value_or(Float64(0.0))
    var mean_range: Float64 = monthly[].value_or(range_)
    var b: Float64 = (Float64(0.036) * Math.Exp((Float64(-0.154) * mean_range)))
    next_[].transmittance = (cfg[].bc_a * (Float64(1.0) - Math.Exp(((-b) * Math.Pow(range_, cfg[].bc_c)))))
    next_[].cloud = (Float64(1.0) - (next_[].transmittance / cfg[].bc_a))
    var cloud: Ref[T_CloudConfig] = ctx[].heat_config[].cloud
    if cloud[].configured:
