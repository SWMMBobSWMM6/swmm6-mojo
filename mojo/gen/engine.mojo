def T_exfil_ExfilSoA__resize(this: Ref[T_exfil_ExfilSoA], var n: Int32) raises:
    this[].count = n
    var un: UInt64 = n.cast[DType.uint64]()
    this[].node_idx[].assign(un, Int32(-1))
    this[].btm_area[].assign(un, Float64(0.0))
    this[].bank_min_depth[].assign(un, Float64(0.0))
    this[].bank_max_depth[].assign(un, Float64(0.0))
    this[].bank_max_area[].assign(un, Float64(0.0))
    this[].btm_ga[].resize(un)
    this[].bank_ga[].resize(un)

def T_exfil_ExfilSolver__raw() raises -> Ref[T_exfil_ExfilSolver]:
    var o = Ref[T_exfil_ExfilSolver](gc_new[T_exfil_ExfilSolver]())
    return o

def T_exfil_ExfilSolver__init(this: Ref[T_exfil_ExfilSolver], var ctx: Ref[T_SimulationContext]) raises:
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var n_nodes: Int32 = T_NodeData__count(nodes)
    var n_exfil: Int32 = Int32(0)
    var i: Int32 = Int32(0)
    while (i < n_nodes):
        var ui: UInt64 = i.cast[DType.uint64]()
        var sr: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, i)
        var ksat: Float64 = (F_lidnode__bottomConductivity(ctx, sr) if (sr >= Int32(0)) else Float64(0.0))
        if ((nodes[].type_[].a[Int(ui)] == T_NodeType__STORAGE) and (ksat > Float64(0.0))):
            n_exfil = (n_exfil + Int32(1))
        i = (i + Int32(1))
    if (n_exfil == Int32(0)):
        this[].soa_[].count = Int32(0)
        return
    T_exfil_ExfilSoA__resize(this[].soa_, n_exfil)
    var BIG: Float64 = Float64(10000000000.0)
    var k: Int32 = Int32(0)
    var i_2: Int32 = Int32(0)
    while (i_2 < n_nodes):
        var ui_2: UInt64 = i_2.cast[DType.uint64]()
        var sr_2: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, i_2)
        var exf_suction: Float64 = (ctx[].node_subtypes[].storages[].exfil_suction[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Float64(0.0))
        var exf_ksat: Float64 = (F_lidnode__bottomConductivity(ctx, sr_2) if (sr_2 >= Int32(0)) else Float64(0.0))
        var exf_imd: Float64 = (ctx[].node_subtypes[].storages[].exfil_imd[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Float64(0.0))
        if ((nodes[].type_[].a[Int(ui_2)] != T_NodeType__STORAGE) or (exf_ksat <= Float64(0.0))):
            i_2 = (i_2 + Int32(1))
            continue
        var uk: UInt64 = k.cast[DType.uint64]()
        this[].soa_[].node_idx[].a[Int(uk)] = i_2
        F_infil__grnampt_init(this[].soa_[].btm_ga[].a[Int(uk)], exf_suction, exf_ksat, exf_imd, ctx[].options)
        F_infil__grnampt_init(this[].soa_[].bank_ga[].a[Int(uk)], exf_suction, exf_ksat, exf_imd, ctx[].options)
        var curve_idx: Int32 = (ctx[].node_subtypes[].storages[].curve[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Int32(-1))
        if (curve_idx >= Int32(0)):
            var curve: Ref[T_Table] = T_TableData__op_Index__i(ctx[].tables, curve_idx)
            this[].soa_[].btm_area[].a[Int(uk)] = F___table_lookupEx(curve, Float64(0.0))
            this[].soa_[].bank_min_depth[].a[Int(uk)] = Float64(0.0)
            this[].soa_[].bank_max_depth[].a[Int(uk)] = Float64(0.0)
            this[].soa_[].bank_max_area[].a[Int(uk)] = Float64(0.0)
            if (not curve[].x[].empty()):
                var alast: Float64 = curve[].y[].a[Int(UInt64(0))]
                var ci: UInt64 = UInt64(1)
                while (ci < curve[].x[].size()):
                    var d: Float64 = curve[].x[].a[Int(ci)]
                    var a: Float64 = curve[].y[].a[Int(ci)]
                    if (a < alast):
                        break
                    elif (a > alast):
                        this[].soa_[].bank_max_area[].a[Int(uk)] = a
                        this[].soa_[].bank_max_depth[].a[Int(uk)] = d
                    elif (this[].soa_[].bank_max_area[].a[Int(uk)] == Float64(0.0)):
                        this[].soa_[].bank_min_depth[].a[Int(uk)] = d
                    else:
                        break
                    alast = a
                    ci = (ci + UInt64(1))
            var ucf_len: Float64 = F_ucf__UCF(Int32(3), ctx[].options)
            var __cp1 = rt_addr(this[].soa_[].btm_area[].a[Int(uk)])
            __cp1[] = (__cp1[] / (ucf_len * ucf_len))
            var __cp2 = rt_addr(this[].soa_[].bank_max_area[].a[Int(uk)])
            __cp2[] = (__cp2[] / (ucf_len * ucf_len))
            var __cp3 = rt_addr(this[].soa_[].bank_min_depth[].a[Int(uk)])
            __cp3[] = (__cp3[] / ucf_len)
            var __cp4 = rt_addr(this[].soa_[].bank_max_depth[].a[Int(uk)])
            __cp4[] = (__cp4[] / ucf_len)
        else:
            var a_coeff: Float64 = (ctx[].node_subtypes[].storages[].a[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Float64(0.0))
            var b_coeff: Float64 = (ctx[].node_subtypes[].storages[].b[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Float64(0.0))
            var c_coeff: Float64 = (ctx[].node_subtypes[].storages[].c[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else Float64(0.0))
            var sshape: T_StorageShape = (ctx[].node_subtypes[].storages[].shape[].a[Int(sr_2.cast[DType.uint64]())] if (sr_2 >= Int32(0)) else T_StorageShape__FUNCTIONAL)
            var btm: Float64 = c_coeff
            if F___storage_shape_is_geometric(sshape):
                pass
            elif (b_coeff == Float64(0.0)):
                btm = (btm + a_coeff)
            this[].soa_[].btm_area[].a[Int(uk)] = btm
            this[].soa_[].bank_min_depth[].a[Int(uk)] = Float64(0.0)
