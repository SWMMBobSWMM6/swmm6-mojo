        while (j <= u[].num_inlets):
            var qIncrement: Float64 = ((u[].clog_factor * F___table_lookupEx(curve, (qBypassed * ucf_flow))) / ucf_flow)
            qIncrement = M.min_(qIncrement, qMax)
            qIncrement = M.min_(qIncrement, qBypassed)
            qCaptured = (qCaptured + qIncrement)
            qBypassed = (qBypassed - qIncrement)
            if (qBypassed < gs()[].G_F_inlet__MIN_RUNOFF_FLOW):
                break
            j = (j + Int32(1))
    elif (curve_kind == Int32(2)):
        qCaptured = (((u[].num_inlets.cast[DType.float64]() * u[].clog_factor) * F___table_lookupEx(curve, (depth * ucf_len))) / ucf_flow)
    return (qCaptured * sides.cast[DType.float64]())

def F_inlet__getInletArea(var d: Ref[T_inlet_Design], var u: Ref[T_inlet_UsageParams]) raises -> Float64:
