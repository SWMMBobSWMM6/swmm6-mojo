            xs[].w_max = w_2
            xs[].yw_max = y_2
            xs[].s_bot = p[Int(Int32(2))]
            xs[].a_full = (y_2 * w_2)
            xs[].r_full = (xs[].a_full / (((Float64(2.0) - xs[].s_bot) * y_2) + w_2))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
