def T_exfil_ExfilSolver__computeAll(this: Ref[T_exfil_ExfilSolver], var ctx: Ref[T_SimulationContext], var dt: Float64) raises:
    var __h_dt1 = rt_cell[Float64](dt)
    var nodes: Ref[T_NodeData] = ctx[].nodes
    var k: Int32 = Int32(0)
    while (k < this[].soa_[].count):
        var uk: UInt64 = k.cast[DType.uint64]()
        var ni: Int32 = this[].soa_[].node_idx[].a[Int(uk)]
        if (ni < Int32(0)):
            k = (k + Int32(1))
            continue
        var uni: UInt64 = ni.cast[DType.uint64]()
        if (F_lidnode__richardsMode(ctx, ni) or (F_lidnode__bottomMode(ctx, ni) != T_LidNodeBottom__Current)):
            ctx[].node_subtypes[].storages[].exfil_rate[].a[Int(T_NodeSubtypes__storage_row(ctx[].node_subtypes, ni).cast[DType.uint64]())] = Float64(0.0)
            k = (k + Int32(1))
            continue
        if ((uni < nodes[].aquifer2d_bed[].size()) and (nodes[].aquifer2d_bed[].a[Int(uni)].cast[DType.int32]() != Int32(0))):
            var sr0: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, ni)
            if (sr0 >= Int32(0)):
                ctx[].node_subtypes[].storages[].exfil_rate[].a[Int(sr0.cast[DType.uint64]())] = Float64(0.0)
            k = (k + Int32(1))
            continue
        var depth: Float64 = nodes[].depth[].a[Int(uni)]
        var total_loss: Float64 = Float64(0.0)
        var infil_factor = rt_cell[Float64](ctx[].climate_state[].infil_factor)
        var recovery_factor = rt_cell[Float64](ctx[].climate_state[].recovery_factor)
        var ga_rate: Dlg = Dlg(__mk198(infil_factor, __h_dt1, recovery_factor), 198)
        total_loss = (total_loss + ((__call128(ga_rate, this[].soa_[].btm_ga[].a[Int(uk)], depth) * this[].soa_[].btm_area[].a[Int(uk)]) * F_lidnode__bottomCloggingFactor(ctx, T_NodeSubtypes__storage_row(ctx[].node_subtypes, ni))))
        if (depth > this[].soa_[].bank_min_depth[].a[Int(uk)]):
            var area: Float64 = F_node__getSurfArea(ctx[].nodes, this[].soa_[].node_idx[].a[Int(uk)], depth, ctx[].tables, F_ucf__getUnitSystem(ctx[].options[].flow_units), ctx[].node_subtypes)
            area = (M.min_(area, this[].soa_[].bank_max_area[].a[Int(uk)]) - this[].soa_[].btm_area[].a[Int(uk)])
            if (area > Float64(0.0)):
                var bank_depth: Float64 = depth
                if (this[].soa_[].bank_ga[].a[Int(uk)][].IMDmax != Float64(0.0)):
                    if (depth > this[].soa_[].bank_max_depth[].a[Int(uk)]):
                        bank_depth = ((depth - this[].soa_[].bank_max_depth[].a[Int(uk)]) + ((this[].soa_[].bank_max_depth[].a[Int(uk)] - this[].soa_[].bank_min_depth[].a[Int(uk)]) / Float64(2.0)))
                    else:
                        bank_depth = ((depth - this[].soa_[].bank_min_depth[].a[Int(uk)]) / Float64(2.0))
                total_loss = (total_loss + (area * __call128(ga_rate, this[].soa_[].bank_ga[].a[Int(uk)], bank_depth)))
        var sr: Int32 = T_NodeSubtypes__storage_row(ctx[].node_subtypes, uni.cast[DType.int32]())
        if (sr >= Int32(0)):
            ctx[].node_subtypes[].storages[].exfil_rate[].a[Int(sr.cast[DType.uint64]())] = total_loss
        k = (k + Int32(1))

