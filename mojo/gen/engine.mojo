            __cp3[] = (__cp3[] + this[].dps_[].P_hat[].a[Int(uci)])
            var __ip4 = rt_addr(gs()[].G_T_dynwave_DWSolver__S_node_P_count_34[].a[Int(n2.cast[DType.uint64]())])
            __ip4[] = (__ip4[] + Int32(1))
        ci = (ci + Int32(1))
    var ci_2: Int32 = Int32(0)
