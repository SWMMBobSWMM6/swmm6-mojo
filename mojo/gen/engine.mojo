    var i: UInt64 = UInt64(0)
    while (i < this[].name_[].size()):
        if name[].Clone()[].Equals(this[].name_[].a[Int(i)][].Clone()):
            return i.cast[DType.int32]()
        i = (i + UInt64(1))
    return Int32(-1)

