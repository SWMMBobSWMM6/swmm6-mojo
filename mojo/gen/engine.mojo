def T_fv_PressurizedHeadSolver__cellPressurized(var mesh: Ref[T_fv_NetworkMeshData], var state: Ref[T_fv_NetworkStateData], var cell: Int32) raises -> Bool:
    var uc: UInt64 = cell.cast[DType.uint64]()
    if (not state[].cell_tpa[].empty()):
        return (state[].cell_tpa[].a[Int(uc)].cast[DType.int32]() != Int32(0))
    var g: Ref[T_fv_FvGeometry] = mesh[].geom[].a[Int(mesh[].cell_geom[].a[Int(uc)].cast[DType.uint64]())]
    return ((not (g[].is_open.cast[DType.int32]() != Int32(0))) and (state[].cell_h[].a[Int(uc)] >= g[].y_crown))

def T_fv_PressurizedHeadSolver__faceModeOf(var mesh: Ref[T_fv_NetworkMeshData], var state: Ref[T_fv_NetworkStateData], var f: Int32) raises -> UInt8:
    var uf: UInt64 = f.cast[DType.uint64]()
    if (mesh[].face_gate[].a[Int(uf)].cast[DType.int32]() != Int32(0)):
        return UInt8(0)
    if (mesh[].face_culvert[].a[Int(uf)] >= Int32(0)):
        return UInt8(0)
    var cl: Int32 = mesh[].face_cl[].a[Int(uf)]
    var cr: Int32 = mesh[].face_cr[].a[Int(uf)]
    var nd: Int32 = mesh[].face_node[].a[Int(uf)]
    if ((nd < Int32(0)) and ((cl < Int32(0)) or (cr < Int32(0)))):
        return UInt8(0)
    var pl: Bool = False
    var pr: Bool = False
    var cell_side_press: Bool = False
    if (cl >= Int32(0)):
        pl = T_fv_PressurizedHeadSolver__cellPressurized(mesh, state, cl)
        cell_side_press = (cell_side_press or pl)
    if (cr >= Int32(0)):
        pr = T_fv_PressurizedHeadSolver__cellPressurized(mesh, state, cr)
        cell_side_press = (cell_side_press or pr)
    if (nd >= Int32(0)):
        var gp: Bool = T_fv_PressurizedHeadSolver__ghostPressurized(mesh, state, f)
        if (cl < Int32(0)):
            pl = gp
        if (cr < Int32(0)):
            pr = gp
    if (not cell_side_press):
        return UInt8(0)
    return (Int32(1) if (pl and pr) else Int32(2)).cast[DType.uint8]()

def T_fv_PressurizedHeadSolver__ghostPressurized(var mesh: Ref[T_fv_NetworkMeshData], var state: Ref[T_fv_NetworkStateData], var f: Int32) raises -> Bool:
    var uf: UInt64 = f.cast[DType.uint64]()
    var nd: Int32 = mesh[].face_node[].a[Int(uf)]
    if (nd < Int32(0)):
        return False
    var other: Int32 = (mesh[].face_cl[].a[Int(uf)] if (mesh[].face_cl[].a[Int(uf)] >= Int32(0)) else mesh[].face_cr[].a[Int(uf)])
    if (other < Int32(0)):
