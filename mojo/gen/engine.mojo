def T_SimulationContext_RoutingStepStats__record_step(this: Ref[T_SimulationContext_RoutingStepStats], var dt: Float64, var steady: Bool, var first_step: Bool) raises:
    if steady:
        this[].steady_time = (this[].steady_time + dt)
        return
    if (not first_step):
        this[].min_step = M.min_(this[].min_step, dt)
        var i: Int32 = Int32(0)
        while (i < gs()[].G_T_SimulationContext_RoutingStepStats__N_TIME_BINS):
            if (dt >= Ptr[Float64](this[].step_intervals, Int(Int64(0)))[Int((i + Int32(1)))]):
                var __ip1 = rt_addr(Ptr[Int64](this[].step_counts, Int(Int64(0)))[Int(i)])
                __ip1[] = (__ip1[] + Int64(1))
                break
            i = (i + Int32(1))
    this[].max_step = M.max_(this[].max_step, dt)
    this[].sum_step = (this[].sum_step + dt)
    this[].n_steps = (this[].n_steps + Int64(1))

def T_SimulationContext_RoutingStepStats__update_iterations(this: Ref[T_SimulationContext_RoutingStepStats], var iters: Int32, var converged: Bool) raises:
    this[].sum_iterations = (this[].sum_iterations + iters.cast[DType.float64]())
    if (not converged):
        this[].n_non_converged = (this[].n_non_converged + Int64(1))

def T_SimulationContext_RoutingStepStats__init_histogram(this: Ref[T_SimulationContext_RoutingStepStats], var route_step: Float64, var min_route_step: Float64) raises:
    if (route_step <= Float64(0.0)):
        return
    if (min_route_step <= Float64(0.0)):
        min_route_step = route_step
    var log_hi: Float64 = Math.Log10(route_step)
    var log_lo: Float64 = Math.Log10(min_route_step)
    var delta: Float64 = ((log_hi - log_lo) / gs()[].G_T_SimulationContext_RoutingStepStats__N_TIME_BINS.cast[DType.float64]())
    Ptr[Float64](this[].step_intervals, Int(Int64(0)))[Int(Int32(0))] = route_step
    var i: Int32 = Int32(1)
    while (i <= gs()[].G_T_SimulationContext_RoutingStepStats__N_TIME_BINS):
        Ptr[Float64](this[].step_intervals, Int(Int64(0)))[Int(i)] = Math.Pow(Float64(10.0), (log_hi - (i.cast[DType.float64]() * delta)))
        i = (i + Int32(1))
    Ptr[Float64](this[].step_intervals, Int(Int64(0)))[Int(gs()[].G_T_SimulationContext_RoutingStepStats__N_TIME_BINS)] = min_route_step

def T_SimulationContext_RoutingStepStats__build_histogram(this: Ref[T_SimulationContext_RoutingStepStats]) raises:
    if ((this[].n_steps == Int64(0)) or (this[].max_step <= Float64(0.0))):
        return
    var hi: Float64 = this[].max_step
    var lo: Float64 = (this[].min_step if (this[].min_step < Float64(1e+30)) else Float64(0.0))
    if (lo <= Float64(0.0)):
        lo = hi
    T_SimulationContext_RoutingStepStats__init_histogram(this, hi, lo)

def T_SimulationContext_RoutingStepStats__avg_step(this: Ref[T_SimulationContext_RoutingStepStats]) raises -> Float64:
    return ((this[].sum_step / this[].n_steps.cast[DType.float64]()) if (this[].n_steps > Int64(0)) else Float64(0.0))

def T_SimulationContext_RoutingStepStats__pct_non_converged(this: Ref[T_SimulationContext_RoutingStepStats]) raises -> Float64:
    return (((Float64(100.0) * this[].n_non_converged.cast[DType.float64]()) / this[].n_steps.cast[DType.float64]()) if (this[].n_steps > Int64(0)) else Float64(0.0))

def T_SimulationContext_RoutingStepStats__computed_avg_iterations(this: Ref[T_SimulationContext_RoutingStepStats]) raises -> Float64:
