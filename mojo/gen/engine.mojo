def F_fv_secgeom__areaOfDepth(var xs: Ref[T_XSectParams], var h: Float64) raises -> Float64:
    if (h <= Float64(0.0)):
        return Float64(0.0)
    if (h > xs[].y_full):
        h = xs[].y_full
    var __sv1 = xs[].type_
    if __sv1 == T_XSectShape__CIRCULAR or __sv1 == T_XSectShape__FORCE_MAIN:
        return F_fv_secgeom_detail__circArea((Float64(0.5) * xs[].y_full), h)
    elif __sv1 == T_XSectShape__FILLED_CIRCULAR:
        var r: Float64 = (Float64(0.5) * (xs[].y_full + xs[].y_bot))
        return (F_fv_secgeom_detail__circArea(r, (xs[].y_bot + h)) - F_fv_secgeom_detail__circArea(r, xs[].y_bot))
    elif __sv1 == T_XSectShape__RECT_CLOSED or __sv1 == T_XSectShape__RECT_OPEN:
        return (h * xs[].w_max)
    elif __sv1 == T_XSectShape__TRAPEZOIDAL:
        return ((xs[].y_bot + (xs[].s_bot * h)) * h)
    elif __sv1 == T_XSectShape__TRIANGULAR:
        return ((xs[].s_bot * h) * h)
    elif __sv1 == T_XSectShape__PARABOLIC:
        return (((Float64(1.3333333333333333) * xs[].r_bot) * h) * Math.Sqrt(h))
    elif __sv1 == T_XSectShape__POWERFUNC:
        return (xs[].r_bot * Math.Pow(h, (xs[].s_bot + Float64(1.0))))
    else:
        return F_xsect__getAofY(xs, h)

def F_fv_secgeom__widthOfDepth(var xs: Ref[T_XSectParams], var h: Float64) raises -> Float64:
    if (h < Float64(0.0)):
        return Float64(0.0)
    if (h > xs[].y_full):
