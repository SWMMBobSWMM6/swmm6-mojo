    if (mesh_richards and (this[].model_ != T_RouteModel__DYNWAVE)):
        raise rt_throw(rt_exc_make(3, Str.fromCPtr(rt_lit("Joint Mesh Richards routing is qualified only for native dynamic wave."))))
    if (rt_box(this[].checkpoint_context_) != Obj()):
        T_Router__checkCheckpointStep(this, ctx, dt, evap_rate, (non_conduit_fn.id != 0), owned_callback)
