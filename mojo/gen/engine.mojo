def T_inlet_InletSolver__updateStats(this: Ref[T_inlet_InletSolver], var ii: Int32, var q: Float64) raises:
    var ui: UInt64 = ii.cast[DType.uint64]()
    var qCapture: Float64 = this[].soa_[].flow_capture[].a[Int(ui)]
    var qBackflow: Float64 = this[].soa_[].backflow[].a[Int(ui)]
    var qNet: Float64 = (qCapture - qBackflow)
    var qBypass: Float64 = (q - qNet)
    var fCapture: Float64 = Float64(0.0)
    if ((q < gs()[].G_F_inlet__MIN_RUNOFF_FLOW) and (qBackflow <= Float64(0.0))):
        return
    var __ip1 = rt_addr(this[].soa_[].flow_periods[].a[Int(ui)])
    __ip1[] = (__ip1[] + Int32(1))
    if (qNet > Float64(0.0)):
        var __ip2 = rt_addr(this[].soa_[].capture_periods[].a[Int(ui)])
        __ip2[] = (__ip2[] + Int32(1))
        fCapture = (qNet / q)
        fCapture = M.min_(fCapture, Float64(1.0))
        var __cp3 = rt_addr(this[].soa_[].avg_flow_capture[].a[Int(ui)])
        __cp3[] = (__cp3[] + fCapture)
        if (qBypass > gs()[].G_F_inlet__MIN_RUNOFF_FLOW):
            var __cp4 = rt_addr(this[].soa_[].bypass_freq[].a[Int(ui)])
            __cp4[] = (__cp4[] + Float64(1.0))
    else:
        var __ip5 = rt_addr(this[].soa_[].backflow_periods[].a[Int(ui)])
        __ip5[] = (__ip5[] + Int32(1))
    if (q > this[].soa_[].peak_flow[].a[Int(ui)]):
        this[].soa_[].peak_flow[].a[Int(ui)] = q
        this[].soa_[].peak_flow_capture[].a[Int(ui)] = (fCapture * Float64(100.0))

def T_inlet_InletSolver__computeBackflowRatios(this: Ref[T_inlet_InletSolver]) raises:
    var ni: Int32 = this[].soa_[].count
    if (ni == Int32(0)):
        return
    var n_links: Int32 = Int32(0)
    var n_std_links: Int32 = Int32(0)
    var n_custom: Int32 = Int32(0)
    var total_area: Float64 = Float64(0.0)
    var ii: Int32 = (ni - Int32(1))
    while (ii >= Int32(0)):
        var m: Int32 = this[].soa_[].node_idx[].a[Int(ii.cast[DType.uint64]())]
        if (m < Int32(0)):
            ii = (ii - Int32(1))
            continue
        n_links = (n_links + Int32(1))
        var area: Float64 = F_inlet__getInletArea(T_inlet_InletSolver__designOf(this, ii), T_inlet_InletSolver__usageOf(this, ii))
        if (area > Float64(0.0)):
            n_std_links = (n_std_links + Int32(1))
            total_area = (total_area + area)
        else:
            n_custom = (n_custom + this[].soa_[].num_inlets[].a[Int(ii.cast[DType.uint64]())])
        ii = (ii - Int32(1))
    if (n_links == Int32(0)):
        return
    var f: Float64 = (n_std_links.cast[DType.float64]() / n_links.cast[DType.float64]())
    var ii_2: Int32 = (ni - Int32(1))
    while (ii_2 >= Int32(0)):
        var ui: UInt64 = ii_2.cast[DType.uint64]()
        this[].soa_[].backflow_ratio[].a[Int(ui)] = Float64(0.0)
        if (this[].soa_[].node_idx[].a[Int(ui)] < Int32(0)):
            ii_2 = (ii_2 - Int32(1))
            continue
        var area_2: Float64 = F_inlet__getInletArea(T_inlet_InletSolver__designOf(this, ii_2), T_inlet_InletSolver__usageOf(this, ii_2))
        if (area_2 > Float64(0.0)):
            if (total_area > Float64(0.0)):
                this[].soa_[].backflow_ratio[].a[Int(ui)] = ((area_2 / total_area) * f)
        elif (n_custom > Int32(0)):
            this[].soa_[].backflow_ratio[].a[Int(ui)] = ((this[].soa_[].num_inlets[].a[Int(ui)].cast[DType.float64]() / n_custom.cast[DType.float64]()) * (Float64(1.0) - f))
        ii_2 = (ii_2 - Int32(1))

