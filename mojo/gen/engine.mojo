def F_xsect__setParams(var xs: Ref[T_XSectParams], var type_: Int32, var p: Ptr[Float64], var ucf: Float64) raises -> Int32:
    xs[].type_ = type_
    var shape: T_XSectShape = type_
    var __sv1 = shape
    while True:
        if __sv1 == T_XSectShape__CIRCULAR:
            var d: Float64 = (p[Int(Int32(0))] / ucf)
            xs[].y_full = d
            xs[].w_max = d
            xs[].yw_max = (d / Float64(2.0))
            xs[].a_full = (((gs()[].G_F_xsect__PI / Float64(4.0)) * d) * d)
            xs[].r_full = (d / Float64(4.0))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            xs[].s_max = (Float64(1.08) * xs[].s_full)
            return Int32(0)
        elif __sv1 == T_XSectShape__FORCE_MAIN:
            var d_2: Float64 = (p[Int(Int32(0))] / ucf)
            xs[].y_full = d_2
            xs[].w_max = d_2
            xs[].yw_max = (d_2 / Float64(2.0))
            xs[].a_full = (((gs()[].G_F_xsect__PI / Float64(4.0)) * d_2) * d_2)
            xs[].r_full = (d_2 / Float64(4.0))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.63)))
            xs[].s_max = (Float64(1.06949) * xs[].s_full)
            xs[].r_bot = p[Int(Int32(1))]
            return Int32(0)
        elif __sv1 == T_XSectShape__RECT_CLOSED:
            var y: Float64 = (p[Int(Int32(0))] / ucf)
            var w: Float64 = (p[Int(Int32(1))] / ucf)
            xs[].y_full = y
            xs[].w_max = w
            xs[].yw_max = y
            xs[].a_full = (y * w)
            xs[].r_full = (xs[].a_full / (Float64(2.0) * (y + w)))
            xs[].s_full = (xs[].a_full * Math.Pow(xs[].r_full, Float64(0.6666666666666666)))
            var a_max: Float64 = (gs()[].G_F_xsect__RECT_ALFMAX * xs[].a_full)
            xs[].s_max = (a_max * Math.Pow(T_xsect_XsectEval__rect_closed_getRofA(F_xsect__hostEval(), xs, a_max), Float64(0.6666666666666666)))
            return Int32(0)
        elif __sv1 == T_XSectShape__RECT_OPEN:
            var y_2: Float64 = (p[Int(Int32(0))] / ucf)
            var w_2: Float64 = (p[Int(Int32(1))] / ucf)
