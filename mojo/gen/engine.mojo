def T_SimulationSnapshot__Assign(this: Ref[T_SimulationSnapshot], var s: Ref[T_SimulationSnapshot]) raises:
    if (rt_box(this) == rt_box(s)):
        return
    this[].sim_time = s[].sim_time
    this[].wall_time_unix = s[].wall_time_unix
    this[].output_step_index = s[].output_step_index
