    culvert[].xsect = xs
    culvert[].yFull = xs[].y_full
    culvert[].ad = (xs[].a_full * Math.Sqrt(culvert[].yFull))
    var __sv1 = code
    while True:
        if __sv1 == Int32(5) or __sv1 == Int32(37) or __sv1 == Int32(46):
            culvert[].scf = (Float64(-7.0) * slope)
            break
        else:
            culvert[].scf = (Float64(0.5) * slope)
            break
        break
    var q: Float64 = Float64(0.0)
    var y2: Float64 = (culvert[].yFull * (((Float64(16.0) * P_[].C) + P_[].Y) - culvert[].scf))
    if (y >= y2):
        q = F_culvert__anon_hydraulics_Culvert_cpp__getSubmergedFlow_Culvert(P_, y, culvert)
    else:
        var y1: Float64 = (Float64(0.95) * culvert[].yFull)
        if (y <= y1):
            q = F_culvert__anon_hydraulics_Culvert_cpp__getUnsubmergedFlow_Culvert(P_, y, culvert)
        else:
            q = F_culvert__anon_hydraulics_Culvert_cpp__getTransitionFlow_Culvert(P_, y, y1, y2, culvert)
    if (q < q0):
        controls[] = True
        dqdh[] = culvert[].dQdH
        return q
    return q0

