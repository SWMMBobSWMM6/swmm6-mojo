            P_face1 = (gs()[].G_T_dynwave_DWSolver__S_node_P_sum_33[].a[Int(n1_2.cast[DType.uint64]())] / gs()[].G_T_dynwave_DWSolver__S_node_P_count_34[].a[Int(n1_2.cast[DType.uint64]())].cast[DType.float64]())
        if (((n2_2 >= Int32(0)) and (n2_2 < this[].n_nodes_)) and (gs()[].G_T_dynwave_DWSolver__S_node_P_count_34[].a[Int(n2_2.cast[DType.uint64]())] > Int32(0))):
            P_face2 = (gs()[].G_T_dynwave_DWSolver__S_node_P_sum_33[].a[Int(n2_2.cast[DType.uint64]())] / gs()[].G_T_dynwave_DWSolver__S_node_P_count_34[].a[Int(n2_2.cast[DType.uint64]())].cast[DType.float64]())
        this[].dps_[].P_[].a[Int(uci_2)] = (Float64(0.5) * (P_face1 + P_face2))
