def F_transport_heat__relaxPair(var g: Ref[T_transport_heat_BedCoupling], var t_w: Float64, var t_b: Float64, var j0: Float64, var j1: Float64, var h: Float64, var area_m2: Float64, var dt: Float64) raises -> Ref[T_transport_heat_PairStep]:
    var out_: Ref[T_transport_heat_PairStep] = T_transport_heat_PairStep__new()
    if ((not T_transport_heat_BedCoupling__viable(g)) or (not (dt > Float64(0.0)))):
        return T_transport_heat_PairStep__MoveNew(out_)
    var djdt: Float64 = Float64(0.0)
    if (h > Float64(0.0)):
        var s: Float64 = ((j1 - j0) / h)
        if ((s > Float64(0.0)) and Dbl.IsFinite(s)):
            djdt = s
    if (((g[].g_bg == Float64(0.0)) and (djdt == Float64(0.0))) and (j0 == Float64(0.0))):
        var total: Float64 = (g[].c_w + g[].c_b)
        var rate: Float64 = ((g[].g_wb / g[].c_w) + (g[].g_wb / g[].c_b))
        var difference: Float64 = ((t_w - t_b) * LibM.expm1(((-rate) * dt)))
        var dw: Float64 = ((g[].c_b / total) * difference)
        var db: Float64 = ((-(g[].c_w / g[].c_b)) * dw)
        if ((not Dbl.IsFinite(dw)) or (not Dbl.IsFinite(db))):
            return T_transport_heat_PairStep__MoveNew(out_)
        out_[].dt_w = dw
        out_[].dt_b = db
        return T_transport_heat_PairStep__MoveNew(out_)
    var a11: Float64 = ((-((area_m2 * djdt) + g[].g_wb)) / g[].c_w)
    var a12: Float64 = (g[].g_wb / g[].c_w)
    var a21: Float64 = (g[].g_wb / g[].c_b)
    var a22: Float64 = ((-(g[].g_wb + g[].g_bg)) / g[].c_b)
    var c1: Float64 = ((((-area_m2) * j0) + (g[].g_wb * (t_b - t_w))) / g[].c_w)
    var c2: Float64 = (((g[].g_wb * (t_w - t_b)) + (g[].g_bg * (g[].t_gr - t_b))) / g[].c_b)
    var tr: Float64 = (a11 + a22)
    var diff: Float64 = (a11 - a22)
    var disc: Float64 = ((diff * diff) + ((Float64(4.0) * a12) * a21))
    var s_2: Float64 = Math.Sqrt((disc if (disc > Float64(0.0)) else Float64(0.0)))
    var alpha: Float64 = Float64(0.0)
    var beta: Float64 = Float64(0.0)
    if ((s_2 * dt) > Float64(1e-08)):
        var l1: Float64 = (Float64(0.5) * (tr + s_2))
        var l2: Float64 = (Float64(0.5) * (tr - s_2))
        var p1: Float64 = F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__phi1_BedExchange((l1 * dt))
        var p2: Float64 = F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__phi1_BedExchange((l2 * dt))
        alpha = ((p1 - p2) / s_2)
        beta = (((p2 * l1) - (p1 * l2)) / s_2)
    else:
        var l: Float64 = (Float64(0.5) * tr)
        alpha = (dt * F_transport_heat__anon_transport_components_HeatFluxModules_BedExchange_cpp__phi2_BedExchange((l * dt)))
        beta = Float64(1.0)
    var mc1: Float64 = ((a11 * c1) + (a12 * c2))
    var mc2: Float64 = ((a21 * c1) + (a22 * c2))
    var dw_2: Float64 = (dt * ((alpha * mc1) + (beta * c1)))
    var db_2: Float64 = (dt * ((alpha * mc2) + (beta * c2)))
    if ((not Dbl.IsFinite(dw_2)) or (not Dbl.IsFinite(db_2))):
        return T_transport_heat_PairStep__MoveNew(out_)
    out_[].dt_w = dw_2
    out_[].dt_b = db_2
    return T_transport_heat_PairStep__MoveNew(out_)

def F_transport_heat__exchangePair(var c_w: Float64, var c_b: Float64, var vol_w: Float64, var vol_b: Float64, var q_exch: Float64, var dt: Float64) raises -> Ref[T_transport_heat_SolutePairStep]:
    var out_: Ref[T_transport_heat_SolutePairStep] = T_transport_heat_SolutePairStep__new()
    if ((((not (vol_w > Float64(0.0))) or (not (vol_b > Float64(0.0)))) or (not (q_exch > Float64(0.0)))) or (not (dt > Float64(0.0)))):
        return T_transport_heat_SolutePairStep__MoveNew(out_)
    var vt: Float64 = (vol_w + vol_b)
    var mu: Float64 = ((q_exch * vt) / (vol_w * vol_b))
    var d0: Float64 = (c_w - c_b)
    var dd: Float64 = (d0 * LibM.expm1(((-mu) * dt)))
    var share: Float64 = (dd / vt)
    if (not Dbl.IsFinite(share)):
        return T_transport_heat_SolutePairStep__MoveNew(out_)
    out_[].dc_w = (vol_b * share)
    out_[].dc_b = ((-vol_w) * share)
    return T_transport_heat_SolutePairStep__MoveNew(out_)

def F_transport_heat__bedCouplingForLink(var ctx: Ref[T_SimulationContext], var link: Int32, var vol_ft3: Float64, var t_gr: Float64) raises -> Ref[T_transport_heat_BedCoupling]:
