def T_SubcatchData__save_state(this: Ref[T_SubcatchData]) raises:
    _ = Algo.copy_[Float64](this[].runoff[].begin(), this[].runoff[].end(), this[].old_runoff[].begin())
    _ = Algo.copy_[Float64](this[].runon_inflow[].begin(), this[].runon_inflow[].end(), this[].old_runon_inflow[].begin())
    _ = Algo.copy_[Float64](this[].conc[].begin(), this[].conc[].end(), this[].conc_old[].begin())
    _ = Algo.copy_[Float64](this[].ponded_depth[].begin(), this[].ponded_depth[].end(), this[].old_ponded_depth[].begin())

def T_SubcatchData__reset_state(this: Ref[T_SubcatchData]) raises:
    Algo.fill[Float64](this[].runoff[].begin(), this[].runoff[].end(), Float64(0.0))
    Algo.fill[Float64](this[].rainfall[].begin(), this[].rainfall[].end(), Float64(0.0))
    Algo.fill[Float64](this[].snow_net_imperv[].begin(), this[].snow_net_imperv[].end(), Float64(-1.0))
    Algo.fill[Float64](this[].snow_net_perv[].begin(), this[].snow_net_perv[].end(), Float64(-1.0))
    Algo.fill[Float64](this[].snow_melt_imperv[].begin(), this[].snow_melt_imperv[].end(), Float64(-1.0))
