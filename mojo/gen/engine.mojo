    var quoted: Ref[Vec[Ref[Str]]] = Vec[Ref[Str]].new_()
    var v__r1: Ref[Vec[Ref[Str]]] = lines
    var v__i2: Int64 = Int64(0)
    var v__i2_n: Int64 = v__r1[].n.cast[DType.int64]()
    while (v__i2 < v__i2_n):
        var line: Ref[Str] = v__r1[].a[Int(v__i2)]
