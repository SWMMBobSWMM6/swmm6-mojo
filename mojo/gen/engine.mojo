def T_NodeSubtypes__rebuild_index(this: Ref[T_NodeSubtypes], var n_nodes: Int32) raises:
    this[].subtype_row[].assign(n_nodes.cast[DType.uint64](), Int32(-1))
    var r: Int32 = Int32(0)
    while (r < T_StorageData__count(this[].storages)):
        this[].subtype_row[].a[Int(this[].storages[].node_idx[].a[Int(r.cast[DType.uint64]())].cast[DType.uint64]())] = r
        r = (r + Int32(1))
    var r_2: Int32 = Int32(0)
    while (r_2 < T_OutfallData__count(this[].outfalls)):
        this[].subtype_row[].a[Int(this[].outfalls[].node_idx[].a[Int(r_2.cast[DType.uint64]())].cast[DType.uint64]())] = r_2
        r_2 = (r_2 + Int32(1))
    var r_3: Int32 = Int32(0)
    while (r_3 < T_DividerData__count(this[].dividers)):
        this[].subtype_row[].a[Int(this[].dividers[].node_idx[].a[Int(r_3.cast[DType.uint64]())].cast[DType.uint64]())] = r_3
        r_3 = (r_3 + Int32(1))

def T_NodeSubtypes__set_node_type(this: Ref[T_NodeSubtypes], var nodes: Ref[T_NodeData], var i: Int32, var t: T_NodeType) raises -> Int32:
    var ui: UInt64 = i.cast[DType.uint64]()
    if (i >= this[].subtype_row[].size().cast[DType.int32]()):
        this[].subtype_row[].resize((i.cast[DType.uint64]() + UInt64(1)), Int32(-1))
    if ((t != T_NodeType__JUNCTION) and (ui < nodes[].storage_area[].size())):
        nodes[].storage_area[].a[Int(ui)] = Float64(0.0)
    var old: T_NodeType = nodes[].type_[].a[Int(ui)]
    var existing: Int32 = this[].subtype_row[].a[Int(ui)]
    if ((old == t) and (existing >= Int32(0))):
        return existing
    var shifted: Bool = False
    if (existing >= Int32(0)):
        var __sv1 = old
        while True:
            if __sv1 == T_NodeType__STORAGE:
                T_StorageData__erase_at(this[].storages, existing)
                break
            elif __sv1 == T_NodeType__OUTFALL:
                T_OutfallData__erase_at(this[].outfalls, existing)
                break
            elif __sv1 == T_NodeType__DIVIDER:
                T_DividerData__erase_at(this[].dividers, existing)
                break
            else:
                break
            break
        shifted = True
    nodes[].type_[].a[Int(ui)] = t
    var row: Int32 = Int32(-1)
    var __sv2 = t
    while True:
        if __sv2 == T_NodeType__STORAGE:
            row = T_StorageData__add_default(this[].storages, i)
            if (row != (T_StorageData__count(this[].storages) - Int32(1))):
                shifted = True
            break
        elif __sv2 == T_NodeType__OUTFALL:
            row = T_OutfallData__add_default(this[].outfalls, i)
            if (row != (T_OutfallData__count(this[].outfalls) - Int32(1))):
                shifted = True
            break
        elif __sv2 == T_NodeType__DIVIDER:
            row = T_DividerData__add_default(this[].dividers, i)
            if (row != (T_DividerData__count(this[].dividers) - Int32(1))):
                shifted = True
            break
        else:
            break
        break
    if shifted:
        T_NodeSubtypes__rebuild_index(this, T_NodeData__count(nodes))
        return (Int32(-1) if (t == T_NodeType__JUNCTION) else this[].subtype_row[].a[Int(ui)])
    this[].subtype_row[].a[Int(ui)] = row
    return row

def T_NodeSubtypes__storage_row(this: Ref[T_NodeSubtypes], var i: Int32) raises -> Int32:
    if ((i >= Int32(0)) and (i < this[].subtype_row[].size().cast[DType.int32]())):
        var r: Int32 = this[].subtype_row[].a[Int(i.cast[DType.uint64]())]
        if (((r >= Int32(0)) and (r < T_StorageData__count(this[].storages))) and (this[].storages[].node_idx[].a[Int(r.cast[DType.uint64]())] == i)):
            return r
    return Int32(-1)

