def T_dynwave_DWSolver__commitNodeDepthState(this: Ref[T_dynwave_DWSolver], var ctx: Ref[T_SimulationContext], var node_idx: Int32, var y_new: Float64, var dV: Float64, var dt: Float64) raises:
