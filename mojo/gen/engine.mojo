            continue
        var y_last: Float64 = nodes[].depth[].a[Int(ui)]
        T_dynwave_DWSolver__setNodeDepth(this, ctx, i, dt, step)
        var g_k: Float64 = nodes[].depth[].a[Int(ui)]
        if ((((use_anderson and (step >= Int32(1))) and (not (this[].aa_skip_[].a[Int(ui)].cast[DType.int32]() != Int32(0)))) and (nodes[].storage_area[].a[Int(ui)] == Float64(0.0))) and (not F_lidnode__active(ctx, i))):
            var r_k: Float64 = (g_k - y_last)
            if (Math.Abs(r_k) <= (Float64(20.0) * this[].head_tol)):
                var r_km1: Float64 = this[].aa_r_prev_[].a[Int(ui)]
                var dr: Float64 = (r_k - r_km1)
                var dr2: Float64 = (dr * dr)
                if (dr2 > Float64(1e-30)):
                    var alpha: Float64 = M.max_(Float64(0.0), M.min_(Float64(1.0), ((r_k * dr) / dr2)))
                    var y_anderson: Float64 = (((Float64(1.0) - alpha) * g_k) + (alpha * this[].aa_g_prev_[].a[Int(ui)]))
                    if (y_anderson >= Float64(0.0)):
